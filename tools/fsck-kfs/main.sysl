// fsck.kfs — check a KFS image, and repair it.
//
//   fsck.kfs <image>                          check; nothing is written
//   fsck.kfs -n <image>                       the same
//   fsck.kfs -y <image>                       repair what can be repaired without losing anything intact
//   fsck.kfs -y --rebuild-corrupt <image>     also clear what fails its checksum (destructive)
//
// The exit code is e2fsck's: 0 clean, 1 errors corrected, 4 errors left uncorrected, 8 an operational
// error, 16 a usage error.

import sh.sysl.kfshost.run_fsck

main(args: []string)
    val r = run_fsck(args[1..])
    print(r.text)
    exit(int(r.code))
