// mkfs.kfs — format an image file as a KFS filesystem.
//
//   mkfs.kfs <image> <blocks> [-i bytes-per-inode] [-m reserved-percent] [-g blocks-per-group] [-j journal-blocks]
//
// The image is created (or emptied) at <blocks> 4 KiB blocks and formatted: the defaults of SPEC.md
// section 4 unless an option says otherwise. -g and -j exist for tests.

import sh.sysl.kfshost.{host_entropy, host_now, run_mkfs}

main(args: []string)
    val entropy = host_entropy() match
        Some(e) -> e
        None ->
            print("mkfs.kfs: cannot read /dev/urandom")
            exit(1)
    run_mkfs(args[1..], entropy.view(), host_now()) match
        Ok(text) -> print(text)
        Err(why) ->
            print(why)
            exit(1)
