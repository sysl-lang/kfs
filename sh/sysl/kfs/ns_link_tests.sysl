module keel.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// link, unlink and rmdir (kfs/SPEC.md section 18): link counts, the orphan list at the last link, an
// open file outliving its name, every refusal.

@test("§18 link: a second name, the target's links + 1 and ctime moved; both names reach the same bytes")
link_basics()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 100, 3)
    val t0 = node(&fs, f).ctime_sec
    fs.plat.clock += 50
    must(link(&fs, f, d, "g".bytes, Caller(0, 0)))
    assert_eq(links_of(&fs, f), 2)
    assert(node(&fs, f).ctime_sec >= t0 + 50)
    assert_eq(named(&fs, d, "g"), f)
    assert_eq(must_entry(lookup_name(&fs, d, "g".bytes)).file_type, DT_REG)
    // A link is no link of the parent directory's.
    assert_eq(links_of(&fs, d), 2)
    settled_clean(&fs)

@test("§18 link refuses: a directory (EPERM), an existing name (EEXIST), a target at LINK_MAX (EMLINK, and one below goes through), an unlinked open inode (ENOENT), a file as the parent (ENOTDIR)")
link_refusals()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val f = mk(&fs, ROOT_INO, "f")
    val r = Caller(0, 0)
    assert_eq(err(link(&fs, d, ROOT_INO, "d2".bytes, r)), EPERM)
    assert_eq(err(link(&fs, f, ROOT_INO, "d".bytes, r)), EEXIST)
    assert_eq(err(link(&fs, f, ROOT_INO, ".".bytes, r)), EEXIST)
    assert_eq(err(link(&fs, f, f, "x".bytes, r)), ENOTDIR)
    set_links(&fs, f, LINK_MAX - 1)
    must(link(&fs, f, d, "last".bytes, r))
    assert_eq(links_of(&fs, f), LINK_MAX)
    assert_eq(err(link(&fs, f, d, "over".bytes, r)), EMLINK)
    assert_eq(named(&fs, d, "over"), 0)
    assert_eq(links_of(&fs, f), LINK_MAX)
    // An open file whose last name has gone cannot be named again.
    val g = mk(&fs, ROOT_INO, "g")
    must(hold(&fs, g))
    must(unlink(&fs, ROOT_INO, "g".bytes))
    assert_eq(err(link(&fs, g, ROOT_INO, "back".bytes, r)), ENOENT)
    must(release(&fs, g))

@test("§18 unlink of a name that is not the last: the inode stays with links − 1 and its ctime moved; the parent's times move")
unlink_not_last()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    must(link(&fs, f, ROOT_INO, "g".bytes, Caller(0, 0)))
    put_pattern(&fs, f, 0, 5000, 1)
    val t0 = node(&fs, f).ctime_sec
    val p0 = node(&fs, ROOT_INO).mtime_sec
    fs.plat.clock += 30
    must(unlink(&fs, ROOT_INO, "f".bytes))
    assert_eq(links_of(&fs, f), 1)
    assert(node(&fs, f).ctime_sec >= t0 + 30 && node(&fs, ROOT_INO).mtime_sec >= p0 + 30)
    assert_eq(named(&fs, ROOT_INO, "f"), 0)
    assert(bytes_equal(got(&fs, f, 0, 5000), pattern(5000, 1)))
    assert_eq(orphans(&fs).len(), 0)
    settled_clean(&fs)

@test("§18 unlink of the last name with nothing holding the inode frees it, its blocks and the slot, in steps after the transaction")
unlink_last_frees()
    var dev = small_device()
    var fs = mounted(&dev)
    must(fs.checkpoint_all())
    val blocks = free_total(&fs)
    val inodes = fs.free_inodes_total.load()
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 9 * BLOCK_SIZE, 1)
    must(unlink(&fs, ROOT_INO, "f".bytes))
    assert(!alive(&fs, f))
    assert_eq(orphans(&fs).len(), 0)
    must(fs.checkpoint_all())
    assert_eq(free_total(&fs), blocks)
    assert_eq(fs.free_inodes_total.load(), inodes)
    settled_clean(&fs)

@test("§18 unlink of an open file: the name goes, the descriptor keeps reading and writing, the inode waits on the orphan list; the last release frees it")
unlink_open_file()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 3 * BLOCK_SIZE, 2)
    must(hold(&fs, f))
    must(unlink(&fs, ROOT_INO, "f".bytes))
    assert_eq(named(&fs, ROOT_INO, "f"), 0)
    assert(node(&fs, f).links == 0 && node(&fs, f).flags & INODE_ORPHAN != 0)
    assert(orphans(&fs).len() == 1 && orphans(&fs)[0] == f)
    put_pattern(&fs, f, 3 * u64(BLOCK_SIZE), 100, 4)
    assert(bytes_equal(got(&fs, f, 0, 3 * BLOCK_SIZE), pattern(3 * BLOCK_SIZE, 2)))
    assert(bytes_equal(got(&fs, f, 3 * u64(BLOCK_SIZE), 100), pattern(100, 4)))
    settled_clean(&fs)
    must(release(&fs, f))
    assert(!alive(&fs, f))
    assert_eq(orphans(&fs).len(), 0)
    settled_clean(&fs)

@test("§18 unlink of an open file, then a crash: the next mount finds it on the orphan list and frees it")
unlink_open_then_crash()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, BLOCK_SIZE, 2)
    must(fs.checkpoint_all())
    val blocks = free_total(&fs) + 1
    must(hold(&fs, f))
    must(unlink(&fs, ROOT_INO, "f".bytes))
    must(fs.commit())
    // No release, no unmount: the machine stops here.
    var again = mounted(&dev)
    assert(!alive(&again, f))
    must(again.checkpoint_all())
    assert_eq(free_total(&again), blocks)
    settled_clean(&again)

@test("§18 unlink refuses: a directory, `.` and `..` (EISDIR); a missing name (ENOENT); a file as the parent (ENOTDIR)")
unlink_refusals()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val f = mk(&fs, ROOT_INO, "f")
    assert_eq(err(unlink(&fs, ROOT_INO, "d".bytes)), EISDIR)
    assert_eq(err(unlink(&fs, d, ".".bytes)), EISDIR)
    assert_eq(err(unlink(&fs, d, "..".bytes)), EISDIR)
    assert_eq(err(unlink(&fs, ROOT_INO, "nope".bytes)), ENOENT)
    assert_eq(err(unlink(&fs, f, "x".bytes)), ENOTDIR)
    assert(alive(&fs, d) && alive(&fs, f))
    settled_clean(&fs)

@test("§18 rmdir of an empty directory: its name goes, the parent loses a link, the inode and the group's directory count are freed")
rmdir_basics()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val dirs = directories(&fs)
    val inodes = fs.free_inodes_total.load()
    val b = mkd(&fs, a, "b")
    assert_eq(links_of(&fs, a), 3)
    fs.plat.clock += 40
    val t0 = node(&fs, a).mtime_sec
    must(rmdir(&fs, a, "b".bytes))
    assert_eq(links_of(&fs, a), 2)
    assert(node(&fs, a).mtime_sec > t0)
    assert(!alive(&fs, b))
    assert_eq(named(&fs, a, "b"), 0)
    assert_eq(directories(&fs), dirs)
    assert_eq(fs.free_inodes_total.load(), inodes)
    settled_clean(&fs)

@test("§18 rmdir refuses: a directory with names (ENOTEMPTY), `.` (EINVAL), `..` (ENOTEMPTY), a file (ENOTDIR), a missing name (ENOENT), the root (EBUSY)")
rmdir_refusals()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val _ = mk(&fs, a, "f")
    assert_eq(err(rmdir(&fs, ROOT_INO, "a".bytes)), ENOTEMPTY)
    assert_eq(err(rmdir(&fs, a, ".".bytes)), EINVAL)
    assert_eq(err(rmdir(&fs, a, "..".bytes)), ENOTEMPTY)
    assert_eq(err(rmdir(&fs, ROOT_INO, ".".bytes)), EINVAL)
    assert_eq(err(rmdir(&fs, a, "f".bytes)), ENOTDIR)
    assert_eq(err(rmdir(&fs, a, "nope".bytes)), ENOENT)
    assert(alive(&fs, a) && links_of(&fs, a) == 2)
    settled_clean(&fs)
    // The root has no name of its own: only a broken directory names it, and rmdir of that name is
    // EBUSY all the same.
    must(add_name(&fs, a, "r".bytes, ROOT_INO, DT_DIR, 0))
    assert_eq(err(rmdir(&fs, a, "r".bytes)), EBUSY)
    assert(alive(&fs, ROOT_INO))

@test("§18 rmdir of a directory a process holds: the name goes, lookups in it find nothing, nothing can be made in it; the last release frees it")
rmdir_held()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    must(hold(&fs, a))
    must(rmdir(&fs, ROOT_INO, "a".bytes))
    assert_eq(named(&fs, ROOT_INO, "a"), 0)
    assert(node(&fs, a).links == 0 && node(&fs, a).flags & INODE_ORPHAN != 0)
    assert_eq(fails_dir(lookup_name(&fs, a, "x".bytes)), 21)
    assert_eq(err(create(&fs, a, "x".bytes, 0o644, Caller(0, 0))), ENOENT)
    assert_eq(err(mkdir(&fs, a, "x".bytes, 0o755, Caller(0, 0))), ENOENT)
    settled_clean(&fs)
    must(release(&fs, a))
    assert(!alive(&fs, a))
    settled_clean(&fs)

@test("§18 directory link counts through mkdir and rmdir: each subdirectory adds one to its parent and takes it back")
dir_links_mkdir_rmdir()
    var dev = small_device()
    var fs = mounted(&dev)
    val root0 = links_of(&fs, ROOT_INO)
    val a = mkd(&fs, ROOT_INO, "a")
    for i in 0..<5
        val _ = mkd(&fs, a, s"s$i")
    val _ = mk(&fs, a, "file")
    assert_eq(links_of(&fs, a), 7)
    assert_eq(links_of(&fs, ROOT_INO), root0 + 1)
    settled_clean(&fs)
    for i in 0..<5
        must(rmdir(&fs, a, s"s$i".bytes))
        assert_eq(links_of(&fs, a), 6 - u32(i))
    must(unlink(&fs, a, "file".bytes))
    must(rmdir(&fs, ROOT_INO, "a".bytes))
    assert_eq(links_of(&fs, ROOT_INO), root0)
    settled_clean(&fs)
