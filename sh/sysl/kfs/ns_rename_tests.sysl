module sh.sysl.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// renameat2 with flags 0, RENAME_NOREPLACE and RENAME_EXCHANGE (kfs/SPEC.md section 18): every form,
// every refusal, directory link counts and `parent` fields across parents, a replaced open file.

private rn[D: BlockDevice](fs: *Fs[D, HostPlatform], od: u64, on: string, nd: u64, nn: string, flags: u32) -> u32 = err(rename(fs, od, on.bytes, nd, nn.bytes, flags, Caller(0, 0)))

@test("§18 rename within a directory: the new name names the inode, the old is gone, the parent's times and the inode's ctime move")
rename_same_dir()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "a")
    val t0 = node(&fs, f).ctime_sec
    fs.plat.clock += 20
    assert_eq(rn(&fs, ROOT_INO, "a", ROOT_INO, "b", 0), 0)
    assert(named(&fs, ROOT_INO, "a") == 0 && named(&fs, ROOT_INO, "b") == f)
    assert_eq(links_of(&fs, f), 1)
    assert(node(&fs, f).ctime_sec >= t0 + 20 && node(&fs, ROOT_INO).mtime_sec >= t0 + 20)
    settled_clean(&fs)

@test("§18 rename of a file between directories: both parents' times move, no link count changes")
rename_file_across()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, ROOT_INO, "b")
    val f = mk(&fs, a, "f")
    fs.plat.clock += 20
    val ta = node(&fs, a).mtime_sec
    assert_eq(rn(&fs, a, "f", b, "g", 0), 0)
    assert(named(&fs, a, "f") == 0 && named(&fs, b, "g") == f)
    assert(links_of(&fs, a) == 2 && links_of(&fs, b) == 2 && links_of(&fs, f) == 1)
    assert(node(&fs, a).mtime_sec > ta && node(&fs, b).mtime_sec > ta)
    assert_eq(must_entry(lookup_name(&fs, b, "g".bytes)).file_type, DT_REG)
    settled_clean(&fs)

@test("§18 rename over an existing file replaces it in place: the victim loses its link and is freed; a victim with another name keeps it")
rename_over_file()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    val v = mk(&fs, ROOT_INO, "v")
    put_pattern(&fs, v, 0, 2 * BLOCK_SIZE, 1)
    assert_eq(rn(&fs, ROOT_INO, "f", ROOT_INO, "v", 0), 0)
    assert(named(&fs, ROOT_INO, "v") == f && named(&fs, ROOT_INO, "f") == 0)
    assert(!alive(&fs, v))
    settled_clean(&fs)
    val w = mk(&fs, ROOT_INO, "w")
    must(link(&fs, w, ROOT_INO, "w2".bytes, Caller(0, 0)))
    assert_eq(rn(&fs, ROOT_INO, "v", ROOT_INO, "w", 0), 0)
    assert(alive(&fs, w) && links_of(&fs, w) == 1 && named(&fs, ROOT_INO, "w2") == w)
    assert_eq(named(&fs, ROOT_INO, "w"), f)
    settled_clean(&fs)

@test("§18 rename onto a hard link of itself, or onto its own name, changes nothing; with NOREPLACE either is EEXIST; EXCHANGE of the two is a no-op")
rename_onto_itself()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val f = mk(&fs, ROOT_INO, "f")
    must(link(&fs, f, d, "h".bytes, Caller(0, 0)))
    must(fs.commit())
    val handles = fs.handles_opened()
    assert_eq(rn(&fs, ROOT_INO, "f", d, "h", 0), 0)
    assert_eq(rn(&fs, ROOT_INO, "f", ROOT_INO, "f", 0), 0)
    assert_eq(rn(&fs, ROOT_INO, "f", d, "h", RENAME_EXCHANGE), 0)
    assert_eq(rn(&fs, d, "d", d, "d", 0), ENOENT)
    // Nothing was written: both names stay, the count stays.
    assert_eq(fs.handles_opened(), handles)
    assert(named(&fs, ROOT_INO, "f") == f && named(&fs, d, "h") == f && links_of(&fs, f) == 2)
    assert_eq(rn(&fs, ROOT_INO, "f", d, "h", RENAME_NOREPLACE), EEXIST)
    assert_eq(rn(&fs, ROOT_INO, "f", ROOT_INO, "f", RENAME_NOREPLACE), EEXIST)
    assert_eq(rn(&fs, ROOT_INO, "d", ROOT_INO, "d", 0), 0)
    settled_clean(&fs)

@test("§18 RENAME_NOREPLACE: onto an existing name EEXIST and nothing moves; onto a free name it is an ordinary rename")
rename_noreplace()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    val g = mk(&fs, ROOT_INO, "g")
    assert_eq(rn(&fs, ROOT_INO, "f", ROOT_INO, "g", RENAME_NOREPLACE), EEXIST)
    assert(named(&fs, ROOT_INO, "f") == f && named(&fs, ROOT_INO, "g") == g && alive(&fs, g))
    assert_eq(rn(&fs, ROOT_INO, "f", ROOT_INO, "h", RENAME_NOREPLACE), 0)
    assert(named(&fs, ROOT_INO, "h") == f && named(&fs, ROOT_INO, "f") == 0)
    settled_clean(&fs)

@test("§18 a directory moved between parents: its parent field and `..` follow, the old parent loses a link and the new one gains it")
rename_dir_across()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, ROOT_INO, "b")
    val c = mkd(&fs, a, "c")
    val _ = mk(&fs, c, "inside")
    assert(links_of(&fs, a) == 3 && links_of(&fs, b) == 2)
    assert_eq(rn(&fs, a, "c", b, "c2", 0), 0)
    assert(links_of(&fs, a) == 2 && links_of(&fs, b) == 3 && links_of(&fs, c) == 2)
    assert_eq(node(&fs, c).parent, b)
    assert_eq(must_entry(lookup_name(&fs, c, "..".bytes)).ino, b)
    assert(named(&fs, c, "inside") != 0)
    // Within one parent nothing about the links moves.
    assert_eq(rn(&fs, b, "c2", b, "c3", 0), 0)
    assert(links_of(&fs, b) == 3 && node(&fs, c).parent == b)
    settled_clean(&fs)

@test("§18 a directory over an empty directory: the victim's links go to 0 and it is freed; across parents the new parent's count is unchanged, the old loses one")
rename_dir_over_empty_dir()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, ROOT_INO, "b")
    val c = mkd(&fs, a, "c")
    val v = mkd(&fs, b, "v")
    val dirs = directories(&fs)
    assert_eq(rn(&fs, a, "c", b, "v", 0), 0)
    assert(named(&fs, b, "v") == c && named(&fs, a, "c") == 0)
    assert(!alive(&fs, v))
    assert(links_of(&fs, a) == 2 && links_of(&fs, b) == 3 && node(&fs, c).parent == b)
    assert_eq(directories(&fs), dirs - 1)
    settled_clean(&fs)
    // The same within one parent: the parent loses the victim's `..`.
    val w = mkd(&fs, b, "w")
    assert_eq(links_of(&fs, b), 4)
    assert_eq(rn(&fs, b, "v", b, "w", 0), 0)
    assert(!alive(&fs, w) && named(&fs, b, "w") == c && links_of(&fs, b) == 3)
    settled_clean(&fs)

@test("§18 rename's type rules: a directory over a non-empty directory is ENOTEMPTY, over a file ENOTDIR; a file over a directory EISDIR — nothing moves")
rename_type_rules()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val full = mkd(&fs, ROOT_INO, "full")
    val _ = mk(&fs, full, "x")
    val f = mk(&fs, ROOT_INO, "f")
    val empty = mkd(&fs, ROOT_INO, "empty")
    assert_eq(rn(&fs, ROOT_INO, "a", ROOT_INO, "full", 0), ENOTEMPTY)
    assert_eq(rn(&fs, ROOT_INO, "a", ROOT_INO, "f", 0), ENOTDIR)
    assert_eq(rn(&fs, ROOT_INO, "f", ROOT_INO, "empty", 0), EISDIR)
    assert(named(&fs, ROOT_INO, "a") == a && named(&fs, ROOT_INO, "full") == full && named(&fs, ROOT_INO, "f") == f && named(&fs, ROOT_INO, "empty") == empty)
    settled_clean(&fs)

@test("§18 a directory may not move into its own subtree (EINVAL): into itself, its child, a deeper descendant; a destination that holds the source is ENOTEMPTY")
rename_subtree()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, a, "b")
    val c = mkd(&fs, b, "c")
    assert_eq(rn(&fs, ROOT_INO, "a", a, "self", 0), EINVAL)
    assert_eq(rn(&fs, ROOT_INO, "a", b, "x", 0), EINVAL)
    assert_eq(rn(&fs, ROOT_INO, "a", c, "x", 0), EINVAL)
    assert_eq(rn(&fs, a, "b", c, "x", 0), EINVAL)
    // The other way up is fine: c to the root.
    assert_eq(rn(&fs, b, "c", ROOT_INO, "c", 0), 0)
    assert_eq(node(&fs, c).parent, ROOT_INO)
    // b onto its own ancestor a: a holds b, so it is not empty.
    assert_eq(rn(&fs, a, "b", ROOT_INO, "a", 0), ENOTEMPTY)
    assert(named(&fs, ROOT_INO, "a") == a && named(&fs, a, "b") == b)
    settled_clean(&fs)

@test("§18 `.` and `..` on either side of a rename are EBUSY; a missing source ENOENT; unknown or both flags EINVAL; into a removed directory ENOENT")
rename_refusals()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val _ = mk(&fs, a, "f")
    assert_eq(rn(&fs, a, ".", ROOT_INO, "x", 0), EBUSY)
    assert_eq(rn(&fs, a, "..", ROOT_INO, "x", 0), EBUSY)
    assert_eq(rn(&fs, a, "f", ROOT_INO, ".", 0), EBUSY)
    assert_eq(rn(&fs, a, "f", a, "..", 0), EBUSY)
    assert_eq(rn(&fs, a, "nope", ROOT_INO, "x", 0), ENOENT)
    assert_eq(rn(&fs, a, "f", ROOT_INO, "x", RENAME_NOREPLACE | RENAME_EXCHANGE), EINVAL)
    assert_eq(rn(&fs, a, "f", ROOT_INO, "x", 4), EINVAL)
    assert_eq(err(rename(&fs, a, "f".bytes, ROOT_INO, long_name(1, 256, u8('q')).view(), 0, Caller(0, 0))), ENAMETOOLONG)
    val gone = mkd(&fs, ROOT_INO, "gone")
    must(hold(&fs, gone))
    must(rmdir(&fs, ROOT_INO, "gone".bytes))
    assert_eq(rn(&fs, a, "f", gone, "x", 0), ENOENT)
    assert(named(&fs, a, "f") != 0)
    must(release(&fs, gone))
    settled_clean(&fs)

@test("§18 a directory moved to a parent at LINK_MAX is EMLINK, one below goes through; over an existing directory the count does not grow, so LINK_MAX is no bar")
rename_link_max()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, ROOT_INO, "b")
    val _ = mkd(&fs, a, "c")
    val _ = mkd(&fs, a, "d")
    val _ = mkd(&fs, b, "v")
    set_links(&fs, b, LINK_MAX - 1)
    assert_eq(rn(&fs, a, "c", b, "c", 0), 0)
    assert_eq(links_of(&fs, b), LINK_MAX)
    assert_eq(rn(&fs, a, "d", b, "d", 0), EMLINK)
    assert_eq(links_of(&fs, b), LINK_MAX)
    assert(named(&fs, a, "d") != 0 && named(&fs, b, "d") == 0)
    // Replacing b's empty `v` adds one `..` and takes one away.
    assert_eq(rn(&fs, a, "d", b, "v", 0), 0)
    assert_eq(links_of(&fs, b), LINK_MAX)
    // A file needs no link: it moves in at LINK_MAX.
    val _ = mk(&fs, a, "f")
    assert_eq(rn(&fs, a, "f", b, "f", 0), 0)

@test("§18 rename over an open file: the name now names the source, the victim stays readable through its descriptor, on the orphan list, and is freed at the last release")
rename_over_open_file()
    var dev = small_device()
    var fs = mounted(&dev)
    val src = mk(&fs, ROOT_INO, "new")
    val old = mk(&fs, ROOT_INO, "cur")
    put_pattern(&fs, old, 0, 2 * BLOCK_SIZE, 9)
    must(fs.checkpoint_all())
    val blocks = free_total(&fs)
    must(hold(&fs, old))
    assert_eq(rn(&fs, ROOT_INO, "new", ROOT_INO, "cur", 0), 0)
    assert_eq(named(&fs, ROOT_INO, "cur"), src)
    assert(node(&fs, old).links == 0 && orphans(&fs).len() == 1 && orphans(&fs)[0] == old)
    assert(bytes_equal(got(&fs, old, 0, 2 * BLOCK_SIZE), pattern(2 * BLOCK_SIZE, 9)))
    settled_clean(&fs)
    must(release(&fs, old))
    assert(!alive(&fs, old))
    must(fs.checkpoint_all())
    assert_eq(free_total(&fs), blocks + 2)
    settled_clean(&fs)

@test("§18 RENAME_EXCHANGE of two files in two directories: each name names the other's inode, nothing else moves")
exchange_files()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, ROOT_INO, "b")
    val f = mk(&fs, a, "f")
    val g = must_ino(mknod(&fs, b, "g".bytes, S_IFIFO | 0o600, DeviceNumbers(0, 0), Caller(0, 0)))
    assert_eq(rn(&fs, a, "f", b, "g", RENAME_EXCHANGE), 0)
    assert(named(&fs, a, "f") == g && named(&fs, b, "g") == f)
    assert_eq(must_entry(lookup_name(&fs, a, "f".bytes)).file_type, DT_FIFO)
    assert_eq(must_entry(lookup_name(&fs, b, "g".bytes)).file_type, DT_REG)
    assert(links_of(&fs, f) == 1 && links_of(&fs, g) == 1 && links_of(&fs, a) == 2 && links_of(&fs, b) == 2)
    // In one directory too.
    val h = mk(&fs, a, "h")
    assert_eq(rn(&fs, a, "f", a, "h", RENAME_EXCHANGE), 0)
    assert(named(&fs, a, "f") == h && named(&fs, a, "h") == g)
    settled_clean(&fs)

@test("§18 RENAME_EXCHANGE of a file and a directory across parents: the directory's parent field follows, the parents' counts move by one each way")
exchange_file_dir()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, ROOT_INO, "b")
    val f = mk(&fs, a, "f")
    val d = mkd(&fs, b, "d")
    val _ = mk(&fs, d, "inside")
    assert(links_of(&fs, a) == 2 && links_of(&fs, b) == 3)
    assert_eq(rn(&fs, a, "f", b, "d", RENAME_EXCHANGE), 0)
    assert(named(&fs, a, "f") == d && named(&fs, b, "d") == f)
    assert(links_of(&fs, a) == 3 && links_of(&fs, b) == 2)
    assert_eq(node(&fs, d).parent, a)
    assert_eq(must_entry(lookup_name(&fs, d, "..".bytes)).ino, a)
    assert_eq(must_entry(lookup_name(&fs, a, "f".bytes)).file_type, DT_DIR)
    settled_clean(&fs)
    // And back the other way.
    assert_eq(rn(&fs, b, "d", a, "f", RENAME_EXCHANGE), 0)
    assert(links_of(&fs, a) == 2 && links_of(&fs, b) == 3 && node(&fs, d).parent == b)
    settled_clean(&fs)

@test("§18 RENAME_EXCHANGE of two directories across parents swaps their parent fields and leaves every count")
exchange_dirs()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, ROOT_INO, "b")
    val x = mkd(&fs, a, "x")
    val y = mkd(&fs, b, "y")
    val _ = mk(&fs, y, "f")
    assert_eq(rn(&fs, a, "x", b, "y", RENAME_EXCHANGE), 0)
    assert(named(&fs, a, "x") == y && named(&fs, b, "y") == x)
    assert(node(&fs, x).parent == b && node(&fs, y).parent == a)
    assert(links_of(&fs, a) == 3 && links_of(&fs, b) == 3)
    settled_clean(&fs)

@test("§18 RENAME_EXCHANGE refuses: a missing side either way (ENOENT); a directory into its own subtree either way (EINVAL); a parent at LINK_MAX gaining a link (EMLINK)")
exchange_refusals()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, a, "b")
    val f = mk(&fs, ROOT_INO, "f")
    assert_eq(rn(&fs, ROOT_INO, "f", ROOT_INO, "missing", RENAME_EXCHANGE), ENOENT)
    assert_eq(rn(&fs, ROOT_INO, "missing", ROOT_INO, "f", RENAME_EXCHANGE), ENOENT)
    val inner = mk(&fs, b, "inner")
    assert_eq(rn(&fs, ROOT_INO, "a", b, "inner", RENAME_EXCHANGE), EINVAL)
    assert_eq(rn(&fs, b, "inner", ROOT_INO, "a", RENAME_EXCHANGE), EINVAL)
    assert(named(&fs, ROOT_INO, "a") == a && named(&fs, b, "inner") == inner && named(&fs, ROOT_INO, "f") == f)
    // A file in the root for a directory in a: the root gains the directory's `..`.
    val c = mkd(&fs, ROOT_INO, "c")
    val d = mkd(&fs, c, "d")
    set_links(&fs, ROOT_INO, LINK_MAX)
    assert_eq(rn(&fs, ROOT_INO, "f", c, "d", RENAME_EXCHANGE), EMLINK)
    assert(named(&fs, c, "d") == d && node(&fs, d).parent == c)

@test("§18 directory link counts through a tree of renames between parents agree with the checker at every step")
dir_links_through_renames()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, ROOT_INO, "b")
    for i in 0..<4
        val _ = mkd(&fs, a, s"d$i")
    val _ = mkd(&fs, b, "keep")
    for i in 0..<4
        assert_eq(rn(&fs, a, s"d$i", b, s"m$i", 0), 0)
        assert_eq(links_of(&fs, a), 5 - u32(i))
        assert_eq(links_of(&fs, b), 4 + u32(i))
        settled_clean(&fs)
    assert_eq(rn(&fs, b, "m0", b, "keep", 0), 0)
    assert_eq(links_of(&fs, b), 6)
    settled_clean(&fs)
