module sh.sysl.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// `write` and `append` (kfs/SPEC.md section 18): block edges, holes left by a gap, extent boundaries,
// unwritten ranges, chunks of eight allocations, the 16 TiB limit, running out of space part-way,
// set-user-ID, times, and the ordered data.

private bs() -> u64 = u64(BLOCK_SIZE)

@test("a write at offset 0 of an empty file: size, blocks, the bytes back, mtime and ctime moved")
write_at_zero()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    val before_write = must_inode(stat(&fs, ino))
    put_pattern(&fs, ino, 0, 5000, 1)
    val n = must_inode(stat(&fs, ino))
    assert(n.size == 5000 && n.blocks == 2)
    assert(before(before_write.mtime_sec, before_write.mtime_nsec, n.mtime_sec, n.mtime_nsec))
    assert(n.ctime_sec == n.mtime_sec && n.atime_sec == before_write.atime_sec && n.crtime_sec == before_write.crtime_sec)
    assert(bytes_equal(got(&fs, ino, 0, 5000), pattern(5000, 1)))
    // The tail of the new last block is zero on the disk once committed (section 8).
    must(fs.checkpoint_all())
    val last = raw(&dev, phys_at(&fs, ino, 1))
    assert(zeroed(last.view()[5000 - BLOCK_SIZE..<BLOCK_SIZE]))
    settled_clean(&fs)

@test("the last byte of a block and the first byte of the next each take one block; one write across both takes two")
write_block_edges()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = new_file(&fs, 0)
    put_pattern(&fs, a, bs() - 1, 1, 2)
    assert(size_of(&fs, a) == bs() && blocks_of(&fs, a) == 1)
    val b = new_file(&fs, 0)
    put_pattern(&fs, b, bs(), 1, 3)
    assert(size_of(&fs, b) == bs() + 1 && blocks_of(&fs, b) == 1 && phys_at(&fs, b, 0) == 0)
    val c = new_file(&fs, 0)
    put_pattern(&fs, c, bs() - 1, 2, 4)
    assert(blocks_of(&fs, c) == 2)
    val back = got(&fs, c, 0, BLOCK_SIZE + 1)
    assert(zeroed(back.view()[0..<BLOCK_SIZE - 1]))
    assert(back[BLOCK_SIZE - 1] == pattern(2, 4)[0] && back[BLOCK_SIZE] == pattern(2, 4)[1])
    settled_clean(&fs)

@test("a write past the end leaves the gap a hole, and the old last block's tail reads zero")
write_leaves_gap()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 100, 1)
    put_pattern(&fs, ino, 10 * bs() + 5, 10, 2)
    assert(size_of(&fs, ino) == 10 * bs() + 15 && blocks_of(&fs, ino) == 2)
    for l in 1..<10
        assert(phys_at(&fs, ino, u64(l)) == 0)
    val gap = got(&fs, ino, 100, 10 * BLOCK_SIZE + 5 - 100)
    assert(zeroed(gap.view()))
    settled_clean(&fs)

@test("an overwrite across two extents and the hole between maps the hole and keeps the extents' blocks")
write_across_extents()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 2 * BLOCK_SIZE, 1)
    put_pattern(&fs, ino, 3 * bs(), 2 * BLOCK_SIZE, 2)
    val b1 = phys_at(&fs, ino, 1)
    val b3 = phys_at(&fs, ino, 3)
    // From the middle of block 1 to the middle of block 3: block 2 is the hole between.
    put_pattern(&fs, ino, bs() + 100, 2 * BLOCK_SIZE, 3)
    assert(phys_at(&fs, ino, 1) == b1 && phys_at(&fs, ino, 3) == b3 && phys_at(&fs, ino, 2) != 0)
    assert(blocks_of(&fs, ino) == 5)
    val all = got(&fs, ino, 0, 5 * BLOCK_SIZE)
    val one = pattern(2 * BLOCK_SIZE, 1)
    val two = pattern(2 * BLOCK_SIZE, 2)
    val three = pattern(2 * BLOCK_SIZE, 3)
    for i in 0..<(BLOCK_SIZE + 100)
        assert(all[i] == one[i])
    for i in 0..<(2 * BLOCK_SIZE)
        assert(all[BLOCK_SIZE + 100 + i] == three[i])
    for i in (3 * BLOCK_SIZE + 100)..<(5 * BLOCK_SIZE)
        assert(all[i] == two[i - 3 * BLOCK_SIZE])
    settled_clean(&fs)

@test("a write into an unwritten range converts just the blocks it touches, their untouched bytes zero")
write_into_unwritten()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    must(fallocate(&fs, ino, Falloc.Allocate, 0, 6 * bs(), 0))
    assert(size_of(&fs, ino) == 6 * bs() && blocks_of(&fs, ino) == 6)
    val b0 = phys_at(&fs, ino, 0)
    // The disk under the extent holds garbage: it must never be read back.
    must(fs.checkpoint_all())
    for l in 0..<6
        raw_put(&dev, b0 + u64(l), pattern(BLOCK_SIZE, 50 + u32(l)).view())
    put_pattern(&fs, ino, 2 * bs() + 10, BLOCK_SIZE, 7)
    assert(unwritten_at(&fs, ino, 1) && !unwritten_at(&fs, ino, 2) && !unwritten_at(&fs, ino, 3) && unwritten_at(&fs, ino, 4))
    assert(phys_at(&fs, ino, 2) == b0 + 2 && blocks_of(&fs, ino) == 6 && size_of(&fs, ino) == 6 * bs())
    val all = got(&fs, ino, 0, 6 * BLOCK_SIZE)
    val w = pattern(BLOCK_SIZE, 7)
    for i in 0..<(6 * BLOCK_SIZE)
        val want = if i >= 2 * BLOCK_SIZE + 10 && i < 3 * BLOCK_SIZE + 10 then w[i - 2 * BLOCK_SIZE - 10] else 0
        assert(all[i] == want)
    // Committed: the converted blocks hold zeros around the bytes, not the garbage.
    must(fs.checkpoint_all())
    assert(zeroed(raw(&dev, b0 + 2).view()[0..<10]))
    settled_clean(&fs)

@test("a write into a range preallocated past the end converts it and moves the size")
write_into_unwritten_past_end()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    must(fallocate(&fs, ino, Falloc.KeepSize, 0, 4 * bs(), 0))
    assert(size_of(&fs, ino) == 0 && blocks_of(&fs, ino) == 4)
    put_pattern(&fs, ino, bs(), 10, 1)
    assert(size_of(&fs, ino) == bs() + 10 && !unwritten_at(&fs, ino, 1) && unwritten_at(&fs, ino, 2))
    assert(blocks_of(&fs, ino) == 4)
    val all = got(&fs, ino, 0, BLOCK_SIZE + 10)
    assert(zeroed(all.view()[0..<BLOCK_SIZE]))
    settled_clean(&fs)

// A file with written blocks at odd logical blocks 1, 3, ... 2k - 1: holes at 0, 2, ... 2k - 2, and,
// for a write of 2k + 1 blocks, at 2k too.
private odd_file(fs: *RamFs, k: u64) -> u64
    val ino = new_file(fs, 0)
    for i in 0..<k
        put_pattern(fs, ino, (2 * i + 1) * bs(), BLOCK_SIZE, 90)
    ino

@test("a write needing exactly eight allocations is one chunk; one needing nine spills into a second")
write_chunks()
    var dev = small_device()
    var fs = mounted(&dev)
    // Eight holes between eight written blocks: eight runs, one handle.
    val eight = odd_file(&fs, 8)
    val t0 = fs.handles_opened()
    put_pattern(&fs, eight, 0, 16 * BLOCK_SIZE, 1)
    assert(fs.handles_opened() - t0 == 1)
    // Nine holes: the ninth allocation is the next chunk's.
    val nine = odd_file(&fs, 8)
    val t1 = fs.handles_opened()
    put_pattern(&fs, nine, 0, 17 * BLOCK_SIZE, 2)
    assert(fs.handles_opened() - t1 == 2)
    // Overwrites need no allocation: any length is one chunk.
    val t2 = fs.handles_opened()
    put_pattern(&fs, nine, 0, 17 * BLOCK_SIZE, 3)
    assert(fs.handles_opened() - t2 == 1)
    assert(bytes_equal(got(&fs, eight, 0, 16 * BLOCK_SIZE), pattern(16 * BLOCK_SIZE, 1)))
    assert(bytes_equal(got(&fs, nine, 0, 17 * BLOCK_SIZE), pattern(17 * BLOCK_SIZE, 3)))
    settled_clean(&fs)

@test("append writes at the size every time, under the lock")
append_at_end()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    val a = pattern(3000, 1)
    val b = pattern(3000, 2)
    assert(must_n(append(&fs, ino, a.view(), 0)) == 3000)
    assert(must_n(append(&fs, ino, b.view(), 0)) == 3000)
    must(truncate(&fs, ino, 7000, 0))
    assert(must_n(append(&fs, ino, a.view(), 0)) == 3000)
    assert(size_of(&fs, ino) == 10000)
    val all = got(&fs, ino, 0, 10000)
    for i in 0usize..<3000
        assert(all[i] == a[i] && all[3000 + i] == b[i] && all[7000 + i] == a[i])
    assert(zeroed(all.view()[6000..<7000]))
    var none = zeros(0)
    assert(must_n(append(&fs, ino, none.view(), 0)) == 0)
    settled_clean(&fs)

@test("the 16 TiB limit: a write ending exactly there succeeds, one crossing it is cut, one at or past it is TooBig")
write_at_max_size()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    val one = pattern(1, 1)
    val two = pattern(2, 2)
    assert(code(write(&fs, ino, MAX_FILE_SIZE, one.view(), 0)) == 7)
    assert(code(write(&fs, ino, MAX_FILE_SIZE + 1, one.view(), 0)) == 7)
    assert(code(append(&fs, ino, one.view(), 0)) == 0)
    assert(must_n(write(&fs, ino, MAX_FILE_SIZE - 1, two.view(), 0)) == 1)
    assert(size_of(&fs, ino) == MAX_FILE_SIZE)
    assert(phys_at(&fs, ino, LOGICAL_BLOCKS - 1) != 0)
    val last = got(&fs, ino, MAX_FILE_SIZE - 1, 4)
    assert(last.len() == 1 && last[0] == two[0])
    assert(code(append(&fs, ino, one.view(), 0)) == 7)
    assert(blocks_of(&fs, ino) == 2)
    settled_clean(&fs)

@test("a zero-length write answers 0 and changes nothing, not even the times")
zero_length_write()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 10, 1)
    val before_write = must_inode(stat(&fs, ino))
    var none = zeros(0)
    assert(must_n(write(&fs, ino, 5000, none.view(), 0)) == 0)
    assert(must_n(write(&fs, ino, MAX_FILE_SIZE + 9, none.view(), 0)) == 0)
    val after = must_inode(stat(&fs, ino))
    assert(after.size == 10 && after.mtime_sec == before_write.mtime_sec && after.ctime_sec == before_write.ctime_sec)

@test("out of space part-way: a write answers the bytes it wrote, the next answers NoSpace; the reserve holds for others")
write_runs_out_of_space()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 1000)
    must(fs.checkpoint_all())
    val free = free_total(&fs)
    val reserve = fs.sb.reserved_blocks
    val big = pattern(usize(free + 10) * BLOCK_SIZE, 4)
    // An ordinary user stops at the reserve.
    val n = must_n(write(&fs, ino, 0, big.view(), 1000))
    assert(n > 0 && n < big.len() && n % BLOCK_SIZE == 0)
    must(fs.checkpoint_all())
    assert(free_total(&fs) <= reserve)
    val more = pattern(BLOCK_SIZE, 5)
    assert(code(write(&fs, ino, u64(n), more.view(), 1000)) == 1)
    assert(size_of(&fs, ino) == u64(n))
    // Root may use the reserve, to the last block.
    val m = must_n(write(&fs, ino, u64(n), big.view()[n..<big.len()], 0))
    assert(m > 0 && m % BLOCK_SIZE == 0)
    must(fs.checkpoint_all())
    assert(free_total(&fs) == 0)
    assert(code(write(&fs, ino, u64(n + m), more.view(), 0)) == 1)
    assert(size_of(&fs, ino) == u64(n + m))
    // Every byte that was answered reads back.
    val back = got(&fs, ino, 0, n + m)
    for i in 0..<(n + m)
        assert(back[i] == big[i])
    // Overwriting what is already mapped needs no space.
    assert(must_n(write(&fs, ino, 0, more.view(), 1000)) == BLOCK_SIZE)
    settled_clean(&fs)

@test("a writer other than root clears set-user-ID and set-group-ID; root keeps them")
write_clears_setid()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_inode(&fs, S_IFREG | 0o6755, 1000)
    put_pattern(&fs, ino, 0, 10, 1)
    assert(must_inode(stat(&fs, ino)).mode == S_IFREG | 0o6755)
    val data = pattern(10, 2)
    must_n(write(&fs, ino, 0, data.view(), 1000))
    assert(must_inode(stat(&fs, ino)).mode == S_IFREG | 0o755)

@test("a new block's bytes reach the disk before the commit that maps it, and before its descriptor")
write_is_ordered()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    must(fs.checkpoint_all())
    put_pattern(&fs, ino, 0, BLOCK_SIZE, 8)
    val b = phys_at(&fs, ino, 0)
    dev.reset_counters()
    must(fs.commit())
    val j0 = fs.sb.journal_start
    val j1 = j0 + u64(fs.sb.journal_blocks)
    var data_at = dev.log_len()
    var first_log = dev.log_len()
    for i in 0..<dev.log_len()
        val blk = dev.log_block(i)
        if blk == b && data_at == dev.log_len() then data_at = i
        if blk >= j0 && blk < j1 && first_log == dev.log_len() then first_log = i
    assert(data_at < first_log)
    assert(dev.log_epoch(data_at) == dev.log_epoch(first_log))
    assert(same(dev.log_data(data_at), pattern(BLOCK_SIZE, 8).view()))

@test("an append into the old last block writes that block after the commit block is durable, the new block before")
append_old_block_after_commit()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 5000, 1)
    must(fs.checkpoint_all())
    val b1 = phys_at(&fs, ino, 1)
    put_pattern(&fs, ino, 5000, 5000, 2)
    val b2 = phys_at(&fs, ino, 2)
    // Until the commit, the device still holds block 1's zeroed tail; a read sees the new bytes.
    assert(zeroed(raw(&dev, b1).view()[5000 - BLOCK_SIZE..<BLOCK_SIZE]))
    val back = got(&fs, ino, 5000, 5000)
    assert(bytes_equal(back, pattern(5000, 2)))
    dev.reset_counters()
    must(fs.commit())
    val j0 = fs.sb.journal_start
    val j1 = j0 + u64(fs.sb.journal_blocks)
    var first_log = dev.log_len()
    var last_log: usize = 0
    var at1 = dev.log_len()
    var at2 = dev.log_len()
    for i in 0..<dev.log_len()
        val blk = dev.log_block(i)
        if blk >= j0 && blk < j1
            if first_log == dev.log_len() then first_log = i
            last_log = i
        if blk == b1 then at1 = i
        if blk == b2 then at2 = i
    assert(at2 < first_log && at1 > last_log && at1 < dev.log_len())
    assert(dev.log_epoch(at1) > dev.log_epoch(last_log))
    assert(dev.flushes() == dev.log_epoch(at1) + 1)
    assert(same(got(&fs, ino, 0, 10000).view()[5000..<10000], pattern(5000, 2).view()))
    settled_clean(&fs)

@test("an overwrite of written blocks goes on the ordered list too: home at the commit, read from memory before")
overwrite_is_ordered()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, BLOCK_SIZE, 1)
    must(fs.checkpoint_all())
    val b = phys_at(&fs, ino, 0)
    put_pattern(&fs, ino, 100, 10, 2)
    assert(bytes_equal(raw(&dev, b), pattern(BLOCK_SIZE, 1)))
    val now = got(&fs, ino, 0, BLOCK_SIZE)
    assert(now[100] == pattern(10, 2)[0] && now[99] == pattern(BLOCK_SIZE, 1)[99])
    must(fs.commit())
    assert(bytes_equal(raw(&dev, b), now))

@test("writing a directory, a device node, a FIFO or a free inode is Invalid and changes nothing")
write_wrong_types()
    var dev = small_device()
    var fs = mounted(&dev)
    val data = pattern(10, 1)
    assert(code(write(&fs, ROOT_INO, 0, data.view(), 0)) == 3)
    assert(code(write(&fs, new_inode(&fs, S_IFIFO | 0o644, 0), 0, data.view(), 0)) == 3)
    assert(code(append(&fs, new_inode(&fs, S_IFBLK | 0o600, 0), data.view(), 0)) == 3)
    assert(code(write(&fs, FIRST_INO + 70, 0, data.view(), 0)) == 3)
    settled_clean(&fs)

@test("a write at the extent tree's limit answers TooBig once its sixth level would be needed, keeping what it wrote")
write_tree_too_deep()
    var dev = small_device()
    var fs = mounted(&dev)
    // Nodes of two entries: a root of seven entries over depth-5 trees fills after a few hundred extents.
    fs.node_max = 2
    val ino = new_file(&fs, 0)
    var k: u64 = 0
    var refused = false
    while !refused
        val data = pattern(1, u32(k))
        val r = write(&fs, ino, 2 * k * bs(), data.view(), 0)
        if code(r) == 7 then refused = true else must_n(r)
        k += 1
        assert(k < 2000)
    assert(must_u16(depth_of(&fs, ino)) == 5)
    // What was written before stays; the refused write changed nothing.
    assert(size_of(&fs, ino) == 2 * (k - 2) * bs() + 1)
    assert(got(&fs, ino, 2 * (k - 2) * bs(), 1)[0] == pattern(1, u32(k - 2))[0])
    settled_clean(&fs)
