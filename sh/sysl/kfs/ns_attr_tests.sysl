module keel.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// setattr, extended attributes, statfs, and mount and unmount (kfs/SPEC.md sections 5, 13, 18, 20 and
// 21).

private with_mode(m: u16) -> SetAttr
    var a = no_change()
    a.mode = Some(m)
    a

private with_size(s: u64) -> SetAttr
    var a = no_change()
    a.size = Some(s)
    a

@test("§18 setattr of the mode keeps the type and sets ctime; bits outside 0o7777 are EINVAL")
setattr_mode()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    val d = mkd(&fs, ROOT_INO, "d")
    val t0 = node(&fs, f).ctime_sec
    fs.plat.clock += 10
    must(setattr(&fs, f, with_mode(0o4751), 0))
    must(setattr(&fs, d, with_mode(0o1777), 0))
    assert_eq(node(&fs, f).mode, S_IFREG | 0o4751)
    assert_eq(node(&fs, d).mode, S_IFDIR | 0o1777)
    assert(node(&fs, f).ctime_sec >= t0 + 10)
    assert_eq(err(setattr(&fs, f, with_mode(0o10644), 0)), EINVAL)
    assert_eq(node(&fs, f).mode, S_IFREG | 0o4751)
    settled_clean(&fs)

@test("§18 setattr of the owner and of the times: UTIME_NOW, a given time (before 1970 too), UTIME_OMIT; ctime always now")
setattr_owner_times()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    var a = no_change()
    a.uid = Some(1000)
    a.gid = Some(50)
    must(setattr(&fs, f, a, 0))
    assert(node(&fs, f).uid == 1000 && node(&fs, f).gid == 50)
    val n0 = node(&fs, f)
    var t = no_change()
    t.atime = TimeSet.At(Time(-86400, 7))
    t.mtime = TimeSet.Omit
    fs.plat.clock += 5
    must(setattr(&fs, f, t, 0))
    val n1 = node(&fs, f)
    assert(n1.atime_sec == -86400 && n1.atime_nsec == 7)
    assert(n1.mtime_sec == n0.mtime_sec && n1.mtime_nsec == n0.mtime_nsec)
    assert(n1.ctime_sec > n0.ctime_sec)
    var u = no_change()
    u.mtime = TimeSet.Now
    fs.plat.clock += 5
    must(setattr(&fs, f, u, 0))
    val n2 = node(&fs, f)
    assert(n2.mtime_sec == n2.ctime_sec && n2.mtime_sec > n1.ctime_sec && n2.atime_sec == -86400)
    // The creation time never moves.
    assert_eq(n2.crtime_sec, n0.crtime_sec)
    must(fs.unmount())
    var again = mounted(&dev)
    assert_eq(node(&again, f).atime_sec, -86400)
    settled_clean(&again)

@test("§18 setattr asking nothing opens no handle and moves nothing")
setattr_nothing()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    must(fs.commit())
    val handles = fs.handles_opened()
    val n0 = node(&fs, f)
    must(setattr(&fs, f, no_change(), 0))
    // The same size as now is no change either.
    must(setattr(&fs, f, with_size(0), 0))
    assert_eq(fs.handles_opened(), handles)
    assert_eq(node(&fs, f).ctime_sec, n0.ctime_sec)

@test("§18 setattr of the size grows with a hole in one transaction, and shrinks through truncate: blocks freed, the tail zero, the other fields in its first transaction")
setattr_size()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    must(fs.commit())
    val handles = fs.handles_opened()
    var grow = with_size(5 * u64(BLOCK_SIZE) + 3)
    grow.mode = Some(0o600)
    must(setattr(&fs, f, grow, 0))
    assert_eq(fs.handles_opened(), handles + 1)
    assert(node(&fs, f).size == 5 * u64(BLOCK_SIZE) + 3 && node(&fs, f).blocks == 0 && node(&fs, f).mode == S_IFREG | 0o600)
    put_pattern(&fs, f, 0, 5 * BLOCK_SIZE + 3, 1)
    must(fs.checkpoint_all())
    val free0 = free_total(&fs)
    var cut = with_size(100)
    cut.uid = Some(7)
    must(setattr(&fs, f, cut, 0))
    assert(node(&fs, f).size == 100 && node(&fs, f).uid == 7 && node(&fs, f).blocks == 1)
    assert(bytes_equal(got(&fs, f, 0, 100), pattern(100, 1)))
    // The tail of the last block is zero: grow again and read it.
    must(setattr(&fs, f, with_size(u64(BLOCK_SIZE)), 0))
    assert(zeroed(got(&fs, f, 100, BLOCK_SIZE - 100).view()))
    must(fs.checkpoint_all())
    assert_eq(free_total(&fs), free0 + 5)
    settled_clean(&fs)

@test("§18 setattr of a size: on a directory EISDIR, a symlink or FIFO EINVAL, past 16 TiB EFBIG")
setattr_size_refusals()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val l = must_ino(symlink(&fs, ROOT_INO, "l".bytes, "abc".bytes, Caller(0, 0)))
    val p = must_ino(mknod(&fs, ROOT_INO, "p".bytes, S_IFIFO | 0o600, DeviceNumbers(0, 0), Caller(0, 0)))
    val f = mk(&fs, ROOT_INO, "f")
    assert_eq(err(setattr(&fs, d, with_size(0), 0)), EISDIR)
    assert_eq(err(setattr(&fs, l, with_size(0), 0)), EINVAL)
    assert_eq(err(setattr(&fs, p, with_size(0), 0)), EINVAL)
    assert_eq(err(setattr(&fs, f, with_size(MAX_FILE_SIZE + 1), 0)), EFBIG)
    must(setattr(&fs, f, with_size(MAX_FILE_SIZE), 0))
    assert_eq(node(&fs, f).size, MAX_FILE_SIZE)
    settled_clean(&fs)

// -- Extended attributes --------------------------------------------------------------------------------

private value_of(n: usize, salt: u32) -> Buf[u8] = pattern(n, salt)

private get_value[D: BlockDevice](fs: *Fs[D, HostPlatform], ino: u64, ns: u8, name: string) -> Buf[u8]
    var out = zeros(XATTR_AREA)
    val n = must_n(getxattr(fs, ino, ns, name.bytes, out.view()))
    out.truncate(n)
    out

@test("§13 setxattr, getxattr, listxattr and removexattr round trip, across a remount; values of any namespace, sorted in the list")
xattr_calls_round_trip()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    must(setxattr(&fs, f, XATTR_USER, "zeta".bytes, value_of(10, 1).view(), 0, 0))
    must(setxattr(&fs, f, XATTR_USER, "alpha".bytes, value_of(0, 1).view(), 0, 0))
    must(setxattr(&fs, f, XATTR_SECURITY, "selinux".bytes, value_of(30, 2).view(), 0, 0))
    must(setxattr(&fs, f, XATTR_TRUSTED, "t".bytes, value_of(5, 3).view(), 0, 0))
    must(setxattr(&fs, f, XATTR_SYSTEM, "posix_acl_access".bytes, value_of(28, 4).view(), 0, 0))
    must(fs.unmount())
    var again = mounted(&dev)
    assert(bytes_equal(get_value(&again, f, XATTR_USER, "zeta"), value_of(10, 1)))
    assert_eq(get_value(&again, f, XATTR_USER, "alpha").len(), 0)
    assert(bytes_equal(get_value(&again, f, XATTR_SECURITY, "selinux"), value_of(30, 2)))
    var list = zeros(200)
    val n = must_n(listxattr(&again, f, list.view()))
    list.truncate(n)
    val want = "user.alpha\0user.zeta\0trusted.t\0security.selinux\0system.posix_acl_access\0"
    assert(same(list.view(), want.bytes))
    must(removexattr(&again, f, XATTR_USER, "zeta".bytes))
    assert_eq(err(getxattr(&again, f, XATTR_USER, "zeta".bytes, list.view())), ENODATA)
    settled_clean(&again)

@test("§13 the first attribute allocates the block (blocks + 1) and sets the XATTR feature; the last one's removal frees it")
xattr_block_lifecycle()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    must(fs.checkpoint_all())
    val free0 = free_total(&fs)
    assert_eq(fs.sb.feature_ro_compat & RO_COMPAT_XATTR, 0)
    assert_eq(super_of(&dev).feature_ro_compat, 0)
    must(setxattr(&fs, f, XATTR_USER, "a".bytes, "1".bytes, 0, 0))
    val b = node(&fs, f).xattr_block
    assert(b != 0 && node(&fs, f).blocks == 1)
    must(fs.checkpoint_all())
    assert_eq(super_of(&dev).feature_ro_compat, RO_COMPAT_XATTR)
    assert_eq(free_total(&fs), free0 - 1)
    must(setxattr(&fs, f, XATTR_USER, "b".bytes, "2".bytes, 0, 0))
    assert_eq(node(&fs, f).xattr_block, b)
    must(removexattr(&fs, f, XATTR_USER, "a".bytes))
    assert(node(&fs, f).xattr_block == b && node(&fs, f).blocks == 1)
    must(removexattr(&fs, f, XATTR_USER, "b".bytes))
    assert(node(&fs, f).xattr_block == 0 && node(&fs, f).blocks == 0)
    must(fs.checkpoint_all())
    assert_eq(free_total(&fs), free0)
    // The feature stays: some inode may have a block again.
    assert_eq(super_of(&dev).feature_ro_compat, RO_COMPAT_XATTR)
    settled_clean(&fs)

@test("§13/§21 a filesystem with XATTR mounts read-write; an unknown ro_compat bit mounts read-only and refuses setxattr (EROFS)")
xattr_feature_mounts()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    must(setxattr(&fs, f, XATTR_USER, "a".bytes, "1".bytes, 0, 0))
    must(fs.unmount())
    var rw = mounted(&dev)
    assert(!rw.read_only())
    must(rw.unmount())
    edit_super(&dev, 0, RO_COMPAT_XATTR | 2, 0)
    var ro = mounted(&dev)
    assert(ro.read_only())
    assert_eq(err(setxattr(&ro, f, XATTR_USER, "b".bytes, "2".bytes, 0, 0)), EROFS)
    assert(bytes_equal(get_value(&ro, f, XATTR_USER, "a"), copy_of("1".bytes)))

@test("§13 flags: XATTR_CREATE on an existing name is EEXIST, XATTR_REPLACE on a missing one ENODATA, both together EINVAL; each otherwise does its one thing")
xattr_flags()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    assert_eq(err(setxattr(&fs, f, XATTR_USER, "a".bytes, "1".bytes, XATTR_REPLACE, 0)), ENODATA)
    must(setxattr(&fs, f, XATTR_USER, "a".bytes, "1".bytes, XATTR_CREATE, 0))
    assert_eq(err(setxattr(&fs, f, XATTR_USER, "a".bytes, "2".bytes, XATTR_CREATE, 0)), EEXIST)
    must(setxattr(&fs, f, XATTR_USER, "a".bytes, "33".bytes, XATTR_REPLACE, 0))
    assert(bytes_equal(get_value(&fs, f, XATTR_USER, "a"), copy_of("33".bytes)))
    assert_eq(err(setxattr(&fs, f, XATTR_USER, "a".bytes, "4".bytes, XATTR_CREATE | XATTR_REPLACE, 0)), EINVAL)
    assert_eq(err(setxattr(&fs, f, XATTR_USER, "a".bytes, "4".bytes, 4, 0)), EINVAL)
    // The same name in another namespace is another attribute.
    must(setxattr(&fs, f, XATTR_TRUSTED, "a".bytes, "t".bytes, XATTR_CREATE, 0))
    assert(bytes_equal(get_value(&fs, f, XATTR_USER, "a"), copy_of("33".bytes)))
    settled_clean(&fs)

@test("§13 names of 1 and 255 bytes are kept; 0 and 256 bytes are ERANGE; a namespace outside 1-4 EINVAL; a missing name ENODATA for get and remove")
xattr_name_limits()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    val n255 = long_name(1, 255, u8('k'))
    must(setxattr(&fs, f, XATTR_USER, "k".bytes, "v".bytes, 0, 0))
    must(setxattr(&fs, f, XATTR_USER, n255.view(), "w".bytes, 0, 0))
    var out = zeros(4)
    assert_eq(must_n(getxattr(&fs, f, XATTR_USER, n255.view(), out.view())), 1)
    assert_eq(out[0], u8('w'))
    assert_eq(err(setxattr(&fs, f, XATTR_USER, long_name(1, 256, u8('k')).view(), "v".bytes, 0, 0)), ERANGE)
    assert_eq(err(setxattr(&fs, f, XATTR_USER, "".bytes, "v".bytes, 0, 0)), ERANGE)
    assert_eq(err(getxattr(&fs, f, XATTR_USER, "".bytes, out.view())), ERANGE)
    assert_eq(err(setxattr(&fs, f, 0, "k".bytes, "v".bytes, 0, 0)), EINVAL)
    assert_eq(err(setxattr(&fs, f, 5, "k".bytes, "v".bytes, 0, 0)), EINVAL)
    assert_eq(err(getxattr(&fs, f, XATTR_USER, "nope".bytes, out.view())), ENODATA)
    assert_eq(err(removexattr(&fs, f, XATTR_USER, "nope".bytes)), ENODATA)
    assert_eq(err(removexattr(&fs, f, XATTR_TRUSTED, "k".bytes)), ENODATA)
    settled_clean(&fs)

@test("§13 one value as large as the block holds is kept, one byte more is ENOSPC; attributes together at exactly 4072 bytes fit and one more byte does not")
xattr_value_limits()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    // A record is 4 + name + value, padded to 4: a 4-byte name leaves 4064 bytes of value.
    val most = XATTR_AREA - 4 - 4
    assert_eq(err(setxattr(&fs, f, XATTR_USER, "big!".bytes, value_of(most + 1, 1).view(), 0, 0)), ENOSPC)
    assert_eq(node(&fs, f).xattr_block, 0)
    must(setxattr(&fs, f, XATTR_USER, "big!".bytes, value_of(most, 1).view(), 0, 0))
    assert(bytes_equal(get_value(&fs, f, XATTR_USER, "big!"), value_of(most, 1)))
    // Full: even an empty value of a 1-byte name (8 bytes) does not fit.
    assert_eq(err(setxattr(&fs, f, XATTR_USER, "x".bytes, "".bytes, 0, 0)), ENOSPC)
    // Two records sharing the area exactly: shrink the first by 8 and add an 8-byte record.
    must(setxattr(&fs, f, XATTR_USER, "big!".bytes, value_of(most - 8, 2).view(), 0, 0))
    must(setxattr(&fs, f, XATTR_USER, "x".bytes, "abc".bytes, 0, 0))
    assert(bytes_equal(get_value(&fs, f, XATTR_USER, "x"), copy_of("abc".bytes)))
    assert_eq(err(setxattr(&fs, f, XATTR_USER, "x".bytes, "abcd".bytes, 0, 0)), ENOSPC)
    // A refused replacement left the old value.
    assert(bytes_equal(get_value(&fs, f, XATTR_USER, "x"), copy_of("abc".bytes)))
    settled_clean(&fs)

@test("§13 getxattr and listxattr with an empty buffer answer the length; a buffer one short is ERANGE, the exact length fits")
xattr_buffers()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    must(setxattr(&fs, f, XATTR_USER, "a".bytes, value_of(17, 1).view(), 0, 0))
    must(setxattr(&fs, f, XATTR_TRUSTED, "bb".bytes, "".bytes, 0, 0))
    var none = zeros(0)
    assert_eq(must_n(getxattr(&fs, f, XATTR_USER, "a".bytes, none.view())), 17)
    var short = zeros(16)
    assert_eq(err(getxattr(&fs, f, XATTR_USER, "a".bytes, short.view())), ERANGE)
    var exact = zeros(17)
    assert_eq(must_n(getxattr(&fs, f, XATTR_USER, "a".bytes, exact.view())), 17)
    // "user.a\0trusted.bb\0" is 18 bytes.
    assert_eq(must_n(listxattr(&fs, f, none.view())), 18)
    var l17 = zeros(17)
    assert_eq(err(listxattr(&fs, f, l17.view())), ERANGE)
    var l18 = zeros(18)
    assert_eq(must_n(listxattr(&fs, f, l18.view())), 18)
    // No attributes: an empty list.
    val g = mk(&fs, ROOT_INO, "g")
    assert_eq(must_n(listxattr(&fs, g, l18.view())), 0)

@test("§13/§18 deleting an inode frees its xattr block with it; the counts come back exactly")
xattr_freed_with_inode()
    var dev = small_device()
    var fs = mounted(&dev)
    must(fs.checkpoint_all())
    val free0 = free_total(&fs)
    val inodes0 = fs.free_inodes_total.load()
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 2 * BLOCK_SIZE, 1)
    must(setxattr(&fs, f, XATTR_USER, "a".bytes, "1".bytes, 0, 0))
    assert_eq(node(&fs, f).blocks, 3)
    must(unlink(&fs, ROOT_INO, "f".bytes))
    must(fs.checkpoint_all())
    assert_eq(free_total(&fs), free0)
    assert_eq(fs.free_inodes_total.load(), inodes0)
    settled_clean(&fs)

@test("§13 xattrs on a directory, a symlink and a device node work the same")
xattr_other_types()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val l = must_ino(symlink(&fs, ROOT_INO, "l".bytes, "t".bytes, Caller(0, 0)))
    val c = must_ino(mknod(&fs, ROOT_INO, "c".bytes, S_IFCHR | 0o600, DeviceNumbers(1, 3), Caller(0, 0)))
    for x in [d, l, c]
        must(setxattr(&fs, x, XATTR_SECURITY, "label".bytes, "s0".bytes, 0, 0))
        assert(bytes_equal(get_value(&fs, x, XATTR_SECURITY, "label"), copy_of("s0".bytes)))
        assert_eq(node(&fs, x).blocks, 1)
    settled_clean(&fs)
    must(rmdir(&fs, ROOT_INO, "d".bytes))
    must(unlink(&fs, ROOT_INO, "l".bytes))
    must(unlink(&fs, ROOT_INO, "c".bytes))
    settled_clean(&fs)

// -- statfs -------------------------------------------------------------------------------------------

@test("§20 statfs: the type, block sizes, data blocks (groups less metadata less the journal), files past the reserved inodes, the name limit, the fsid and RELATIME")
statfs_fields()
    var dev = small_device()
    var fs = mounted(&dev)
    val s = statfs(&fs)
    assert_eq(s.f_type, 0x4B465331)
    assert(s.bsize == 4096 && s.frsize == 4096 && s.namelen == 255)
    var data: u64 = 0
    for g in 0..<fs.geo.group_count
        data += u64(fs.geo.group_len(g)) - u64(fs.geo.meta_blocks(g))
    assert_eq(s.blocks, data - u64(fs.geo.journal_blocks))
    assert_eq(s.files, fs.sb.inode_count - 10)
    assert_eq(s.bfree, free_total(&fs))
    assert_eq(s.bavail, free_total(&fs) - fs.sb.reserved_blocks)
    assert_eq(s.ffree, fs.free_inodes_total.load())
    var id: u64 = 0
    for k in 0..<8
        id = id | (u64(fs.sb.uuid[k]) << (8 * k))
    assert(s.fsid == id && s.fsid != 0)
    assert_eq(s.flags, ST_RELATIME)
    // A filesystem with nothing used but the root and lost+found: every block a block of data, free but
    // the root's leaf.
    assert_eq(s.bfree, s.blocks - 1)
    // `files` leaves out inodes 1-10, the root among them: lost+found is the one ordinary inode in use.
    assert_eq(s.ffree, s.files - 1)

@test("§20 statfs counts move by exactly what each operation takes and gives, once its frees commit")
statfs_moves()
    var dev = small_device()
    var fs = mounted(&dev)
    must(fs.checkpoint_all())
    val s0 = statfs(&fs)
    val f = mk(&fs, ROOT_INO, "f")
    assert(statfs(&fs).ffree == s0.ffree - 1 && statfs(&fs).bfree == s0.bfree)
    put_pattern(&fs, f, 0, 3 * BLOCK_SIZE, 1)
    assert_eq(statfs(&fs).bfree, s0.bfree - 3)
    val _ = must_ino(symlink(&fs, ROOT_INO, "l".bytes, target_of(200).view(), Caller(0, 0)))
    assert(statfs(&fs).bfree == s0.bfree - 4 && statfs(&fs).ffree == s0.ffree - 2)
    val _ = must_ino(symlink(&fs, ROOT_INO, "s".bytes, target_of(20).view(), Caller(0, 0)))
    assert(statfs(&fs).bfree == s0.bfree - 4 && statfs(&fs).ffree == s0.ffree - 3)
    val _ = mkd(&fs, ROOT_INO, "d")
    assert(statfs(&fs).bfree == s0.bfree - 4 && statfs(&fs).ffree == s0.ffree - 4)
    must(setxattr(&fs, f, XATTR_USER, "a".bytes, "1".bytes, 0, 0))
    assert_eq(statfs(&fs).bfree, s0.bfree - 5)
    must(fs.commit())
    // A delete's frees count only once their transaction commits.
    must(unlink(&fs, ROOT_INO, "f".bytes))
    assert_eq(statfs(&fs).ffree, s0.ffree - 3)
    assert_eq(statfs(&fs).bfree, s0.bfree - 5)
    must(fs.commit())
    assert_eq(statfs(&fs).bfree, s0.bfree - 1)
    must(unlink(&fs, ROOT_INO, "l".bytes))
    must(unlink(&fs, ROOT_INO, "s".bytes))
    must(rmdir(&fs, ROOT_INO, "d".bytes))
    must(fs.commit())
    assert(statfs(&fs).bfree == s0.bfree && statfs(&fs).ffree == s0.ffree)

@test("§20 statfs of a read-only filesystem says ST_RDONLY; bavail is 0 once the free blocks are within the reserve")
statfs_flags_and_reserve()
    var dev = small_device()
    var fs = mounted(&dev)
    ns_fill_disk(&fs, fs.sb.reserved_blocks - 3)
    assert_eq(statfs(&fs).bavail, 0)
    must(fs.unmount())
    var nf = NoFlushDevice(&dev)
    var ro = mounted(&nf)
    assert_eq(statfs(&ro).flags, ST_RDONLY | ST_RELATIME)

// -- Mount and unmount --------------------------------------------------------------------------------

@test("§18 unmount writes CLEAN with exact totals and the next mount clears it and counts itself; a mount never unmounted is found unclean, recovers, and the totals come from the descriptors")
mount_unmount_round_trip()
    var dev = small_device()
    var fs = mounted(&dev)
    val sb0 = super_of(&dev)
    assert_eq(sb0.state & STATE_CLEAN, 0)
    val _ = mk(&fs, ROOT_INO, "f")
    val _ = mkd(&fs, ROOT_INO, "d")
    must(fs.unmount())
    val sb1 = super_of(&dev)
    assert(sb1.state & STATE_CLEAN != 0)
    assert(sb1.free_inodes == sb0.free_inodes - 2)
    checked_clean(&dev)
    var again = mounted(&dev)
    val sb2 = super_of(&dev)
    assert(sb2.state & STATE_CLEAN == 0 && sb2.mount_count == sb1.mount_count + 1)
    assert(named(&again, ROOT_INO, "f") != 0 && named(&again, ROOT_INO, "d") != 0)
    // A crash: committed, never checkpointed, never unmounted.
    val _ = mk(&again, ROOT_INO, "g")
    must(again.commit())
    assert(journal_of(&dev).start != 0)
    assert_eq(super_of(&dev).state & STATE_CLEAN, 0)
    var third = mounted(&dev)
    assert_eq(journal_of(&dev).start, 0)
    assert(named(&third, ROOT_INO, "g") != 0)
    assert_eq(third.free_inodes_total.load(), sb1.free_inodes - 1)
    must(third.unmount())
    assert_eq(super_of(&dev).free_inodes, sb1.free_inodes - 1)
    checked_clean(&dev)
