module sh.sysl.kfs
@tests
@requires(heap)

@test("bit i is bit i % 8 of byte i / 8; set, clear and test agree")
bitmap_bit_order()
    var b = new_block()
    bit_set(b.view(), 0)
    bit_set(b.view(), 9)
    bit_set(b.view(), BLOCK_SIZE * 8 - 1)
    assert_eq(b.view()[0], 1)
    assert_eq(b.view()[1], 2)
    assert_eq(b.view()[BLOCK_SIZE - 1], 0x80)
    assert(bit_test(b.view(), 0) && bit_test(b.view(), 9) && bit_test(b.view(), BLOCK_SIZE * 8 - 1))
    assert(!bit_test(b.view(), 1) && !bit_test(b.view(), 8))
    bit_clear(b.view(), 9)
    assert_eq(b.view()[1], 0)
    bit_clear(b.view(), 9)
    assert_eq(b.view()[1], 0)

@test("a range sets exactly its bits, and count_clear counts the clear ones in a prefix")
bitmap_ranges_and_counts()
    var b = new_block()
    bit_set_range(b.view(), 3, 20)
    assert_eq(count_clear(b.view(), 32), 32 - 17)
    assert_eq(count_clear(b.view(), 3), 3)
    assert_eq(count_clear(b.view(), 20), 3)
    assert(!bit_test(b.view(), 2))
    assert(bit_test(b.view(), 3))
    assert(bit_test(b.view(), 19))
    assert(!bit_test(b.view(), 20))
    bit_set_range(b.view(), 5, 5)
    assert_eq(count_clear(b.view(), 32), 32 - 17)
