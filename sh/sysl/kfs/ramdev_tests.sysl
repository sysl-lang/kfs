module keel.kfs
@tests
@requires(heap)

@test("a new device is zeroed, and read, write and flush are counted")
ramdev_counts_and_contents()
    var dev = ram_device(8)
    assert_eq(dev.blocks(), 8)
    var out = new_block()
    assert(dev.read(3, out.view()).is_ok())
    for i in 0..<BLOCK_SIZE
        assert_eq(out.view()[i], 0)
    val data = filled_block(1)
    assert(dev.write(3, data.view()).is_ok())
    assert(dev.flush().is_ok())
    assert(dev.read(3, out.view()).is_ok())
    for i in 0..<BLOCK_SIZE
        assert_eq(out.view()[i], data.view()[i])
    assert_eq(dev.reads(), 2)
    assert_eq(dev.writes(), 1)
    assert_eq(dev.flushes(), 1)

@test("the write log keeps every write in order with its data and flush epoch, overwrites included")
ramdev_log_is_ordered()
    var dev = ram_device(4)
    val a = filled_block(1)
    val b = filled_block(2)
    val c = filled_block(3)
    assert(dev.write(2, a.view()).is_ok())
    assert(dev.write(0, b.view()).is_ok())
    assert(dev.flush().is_ok())
    assert(dev.write(2, c.view()).is_ok())
    assert_eq(dev.log_len(), 3)
    assert_eq(dev.log_block(0), 2)
    assert_eq(dev.log_block(1), 0)
    assert_eq(dev.log_block(2), 2)
    assert_eq(dev.log_epoch(0), 0)
    assert_eq(dev.log_epoch(1), 0)
    assert_eq(dev.log_epoch(2), 1)
    for i in 0..<BLOCK_SIZE
        assert_eq(dev.log_data(0)[i], a.view()[i])
        assert_eq(dev.log_data(1)[i], b.view()[i])
        assert_eq(dev.log_data(2)[i], c.view()[i])
    var out = new_block()
    assert(dev.read(2, out.view()).is_ok())
    assert_eq(out.view()[10], c.view()[10])

@test("an out-of-range or wrongly sized transfer is refused and changes nothing")
ramdev_refuses_bad_requests()
    var dev = ram_device(2)
    var out = new_block()
    val data = filled_block(4)
    assert(dev.read(2, out.view()).is_err())
    assert(dev.write(2, data.view()).is_err())
    assert(dev.write(0, data.view()[0..<512]).is_err())
    assert(dev.read(0, out.view()[0..<512]).is_err())
    assert_eq(dev.writes(), 0)
    assert_eq(dev.reads(), 0)
    assert_eq(dev.log_len(), 0)

@test("resetting the counters clears the log and keeps the contents")
ramdev_reset_keeps_contents()
    var dev = ram_device(2)
    val data = filled_block(5)
    assert(dev.write(1, data.view()).is_ok())
    assert(dev.flush().is_ok())
    dev.reset_counters()
    assert_eq(dev.writes(), 0)
    assert_eq(dev.flushes(), 0)
    assert_eq(dev.log_len(), 0)
    var out = new_block()
    assert(dev.read(1, out.view()).is_ok())
    assert_eq(out.view()[100], data.view()[100])

@test("a block written through the device carries a structure that verifies after being read back")
ramdev_carries_sealed_blocks()
    var dev = ram_device(4)
    var blk = filled_block(6)
    set_tail(blk.view(), 12, 1)
    seal_block(0xABCD, blk.view())
    assert(dev.write(1, blk.view()).is_ok())
    var back = new_block()
    assert(dev.read(1, back.view()).is_ok())
    assert(verify_owned_block(0xABCD, back.view(), 12, 1))
    var wrong = new_block()
    assert(dev.read(2, wrong.view()).is_ok())
    assert(!verify_block(0xABCD, wrong.view()))
