module sh.sysl.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// `read` (kfs/SPEC.md section 18): holes and unwritten extents read as zeros, the end of the file, the
// zero-length read, block edges, and relatime's three rules for `atime`.

@test("a read past the end answers 0, one straddling it is cut at the size, and one at the end answers 0")
read_at_and_past_end()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 100, 3)
    var out = zeros(64)
    assert(must_n(read(&fs, ino, 100, out.view())) == 0)
    assert(must_n(read(&fs, ino, 5000, out.view())) == 0)
    assert(must_n(read(&fs, ino, MAX_FILE_SIZE + 7, out.view())) == 0)
    assert(must_n(read(&fs, ino, 90, out.view())) == 10)
    val want = pattern(100, 3)
    for i in 0usize..<10
        assert(out[i] == want[90 + i])
    // Bytes past what was read are left as they were.
    assert(out[10] == 0)

@test("a zero-length read answers 0 and touches nothing, not even atime")
zero_length_read()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 10, 1)
    val before = must_inode(stat(&fs, ino))
    var none = zeros(0)
    assert(must_n(read(&fs, ino, 0, none.view())) == 0)
    val after = must_inode(stat(&fs, ino))
    assert(after.atime_sec == before.atime_sec && after.atime_nsec == before.atime_nsec)

@test("a hole reads as zeros: a read wholly inside one, and one straddling data and hole")
holes_read_as_zeros()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    // Data in block 0 and block 5; blocks 1-4 are a hole; then a hole to the size at block 9.
    put_pattern(&fs, ino, 0, BLOCK_SIZE, 1)
    put_pattern(&fs, ino, 5 * u64(BLOCK_SIZE), BLOCK_SIZE, 2)
    must(truncate(&fs, ino, 10 * u64(BLOCK_SIZE), 0))
    assert(phys_at(&fs, ino, 2) == 0 && phys_at(&fs, ino, 7) == 0)
    assert(blocks_of(&fs, ino) == 2)
    val inside = got(&fs, ino, 2 * u64(BLOCK_SIZE) + 17, 3000)
    assert(inside.len() == 3000 && zeroed(inside.view()))
    val tail = got(&fs, ino, 6 * u64(BLOCK_SIZE), 4 * BLOCK_SIZE)
    assert(tail.len() == 4 * BLOCK_SIZE && zeroed(tail.view()))
    val across = got(&fs, ino, u64(BLOCK_SIZE) - 8, BLOCK_SIZE + 16)
    val first = pattern(BLOCK_SIZE, 1)
    for i in 0usize..<8
        assert(across[i] == first[BLOCK_SIZE - 8 + i])
    assert(zeroed(across.view()[8..<BLOCK_SIZE + 16]))
    val whole = got(&fs, ino, 0, 10 * BLOCK_SIZE)
    assert(whole.len() == 10 * BLOCK_SIZE)
    val second = pattern(BLOCK_SIZE, 2)
    for i in 0..<BLOCK_SIZE
        assert(whole[5 * BLOCK_SIZE + i] == second[i])
    settled_clean(&fs)

@test("an unwritten extent reads as zeros whatever its blocks hold on the disk")
unwritten_reads_zeros()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    must(fallocate(&fs, ino, Falloc.Allocate, 0, 3 * u64(BLOCK_SIZE), 0))
    must(fs.checkpoint_all())
    val b = phys_at(&fs, ino, 1)
    assert(b != 0 && unwritten_at(&fs, ino, 1))
    raw_put(&dev, b, pattern(BLOCK_SIZE, 9).view())
    val all = got(&fs, ino, 0, 3 * BLOCK_SIZE)
    assert(all.len() == 3 * BLOCK_SIZE && zeroed(all.view()))
    settled_clean(&fs)

@test("block edges: the last byte of a block, the first of the next, and a read spanning the boundary")
read_block_edges()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 3 * BLOCK_SIZE, 4)
    val want = pattern(3 * BLOCK_SIZE, 4)
    val last = got(&fs, ino, u64(BLOCK_SIZE) - 1, 1)
    assert(last.len() == 1 && last[0] == want[BLOCK_SIZE - 1])
    val next = got(&fs, ino, u64(BLOCK_SIZE), 1)
    assert(next[0] == want[BLOCK_SIZE])
    val span = got(&fs, ino, u64(BLOCK_SIZE) - 3, 6)
    for i in 0usize..<6
        assert(span[i] == want[BLOCK_SIZE - 3 + i])
    val first = got(&fs, ino, 0, 1)
    assert(first[0] == want[0])

@test("a read finds a block's bytes in the running transaction before they reach the disk")
read_sees_uncommitted_data()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    must(fs.checkpoint_all())
    put_pattern(&fs, ino, 0, BLOCK_SIZE, 6)
    val b = phys_at(&fs, ino, 0)
    // Nothing committed: the device still holds zeros there.
    assert(zeroed(raw(&dev, b).view()))
    assert(bytes_equal(got(&fs, ino, 0, BLOCK_SIZE), pattern(BLOCK_SIZE, 6)))
    must(fs.commit())
    assert(bytes_equal(raw(&dev, b), pattern(BLOCK_SIZE, 6)))
    assert(bytes_equal(got(&fs, ino, 0, BLOCK_SIZE), pattern(BLOCK_SIZE, 6)))

@test("relatime: atime is written when older than mtime, not again after, and again when more than a day old")
relatime()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    // A new inode's times are all equal: atime is not older than mtime or ctime, so nothing is written.
    var out = zeros(4)
    must_n(read(&fs, ino, 0, out.view()))
    val fresh = must_inode(stat(&fs, ino))
    assert(fresh.atime_sec == fresh.crtime_sec)
    // A write moves mtime past atime: the next read writes atime.
    put_pattern(&fs, ino, 0, 4, 1)
    val written = must_inode(stat(&fs, ino))
    assert(before(written.atime_sec, written.atime_nsec, written.mtime_sec, written.mtime_nsec))
    must_n(read(&fs, ino, 0, out.view()))
    val read1 = must_inode(stat(&fs, ino))
    assert(!before(read1.atime_sec, read1.atime_nsec, read1.mtime_sec, read1.mtime_nsec))
    // Read again at once: atime is newer than both and less than a day old, so it stays.
    must_n(read(&fs, ino, 0, out.view()))
    assert(must_inode(stat(&fs, ino)).atime_sec == read1.atime_sec)
    // A day later, exactly: not more than a day old, it stays; one second more and it is written — by a
    // read at the end of the file too, which asked for bytes and got none.
    fs.plat.clock = read1.atime_sec + 86400 - 1
    must_n(read(&fs, ino, 0, out.view()))
    assert(must_inode(stat(&fs, ino)).atime_sec == read1.atime_sec)
    fs.plat.clock = read1.atime_sec + 86400
    assert(must_n(read(&fs, ino, 100, out.view())) == 0)
    assert(must_inode(stat(&fs, ino)).atime_sec == read1.atime_sec + 86401)
    settled_clean(&fs)

@test("a read on a read-only filesystem works and writes no atime")
read_only_read()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 50, 2)
    must(fs.unmount())
    var nf = NoFlushDevice(&dev)
    var ro = mounted(&nf)
    assert(ro.read_only())
    val before_read = must_inode(stat(&ro, ino))
    assert(bytes_equal(got(&ro, ino, 0, 50), pattern(50, 2)))
    assert(must_inode(stat(&ro, ino)).atime_sec == before_read.atime_sec)

@test("reading a directory, a device node or a free inode is Invalid")
read_wrong_types()
    var dev = small_device()
    var fs = mounted(&dev)
    var out = zeros(8)
    assert(code(read(&fs, ROOT_INO, 0, out.view())) == 3)
    val dev_node = new_inode(&fs, S_IFCHR | 0o600, 0)
    assert(code(read(&fs, dev_node, 0, out.view())) == 3)
    assert(code(read(&fs, FIRST_INO + 60, 0, out.view())) == 3)
    assert(!fs.aborted())
