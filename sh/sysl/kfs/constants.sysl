module sh.sysl.kfs

// The constants and limits of kfs/SPEC.md section 3, and the magic numbers and flag bits of the
// structures that follow it.
//
// KFS is little-endian on the disk and is read in place through pointers into blocks, which is only
// meaningful on a little-endian machine. Nothing in a struct can say so, so the build is refused
// anywhere else (a big-endian port would read every field through byte-swapping accessors instead).

#if aarch64 || x86_64 || riscv64 || riscv32 || thumb || x86 || wasm32
// every one of these targets is little-endian
#else
@assert(false, "KFS reads its structures in place and needs a little-endian target")
#endif

const SECTOR_SIZE: usize = 512
const BLOCK_SIZE: usize = 4096
const SECTORS_PER_BLOCK: usize = 8
const INODE_SIZE: usize = 256
const INODES_PER_BLOCK: usize = 16
const NAME_MAX: usize = 255
const PATH_MAX: usize = 4096
const SYMLINK_INLINE_MAX: usize = 128
const LINK_MAX: u32 = 2_147_483_647
const BLOCKS_PER_GROUP_MIN: u32 = 2048
const BLOCKS_PER_GROUP_MAX: u32 = 32768
const INODES_PER_GROUP_MIN: u32 = 16
const INODES_PER_GROUP_MAX: u32 = 32768
const DEFAULT_BYTES_PER_INODE: u32 = 8192
const FIRST_INO: u64 = 11
const ROOT_INO: u64 = 2
const EXTENT_ROOT_SLOTS: usize = 7
const EXTENT_NODE_SLOTS: usize = 254
const EXTENT_MAX_DEPTH: usize = 5
const EXTENT_MAX_LEN: u32 = 32768
const DIR_MAX_LEVELS: usize = 3
const DIR_INDEX_SLOTS: usize = 254
const JOURNAL_MIN_BLOCKS: u32 = 1024
const JOURNAL_MAX_BLOCKS: u32 = 16384
const MAX_OP_CREDITS: u32 = 224
const COMMIT_INTERVAL_SECONDS: u32 = 5

// A file's logical blocks are 32-bit: block numbers 0 ... 2^32 - 1 (section 3, "Maximum sizes").
const LOGICAL_BLOCKS: u64 = 0x1_0000_0000

// The unit credit costs of section 14 ("Credits").
const C_INODE: u32 = 1
const C_GROUP: u32 = 2
const C_EXT: u32 = 4 * (u32(EXTENT_MAX_DEPTH) + 1)
const C_ALLOC: u32 = C_GROUP + C_EXT
const C_SB: u32 = 1

// The split operations of section 18, each step one handle: a write or preallocation chunk allocates at
// most CHUNK_EXTENTS extents; a truncate, delete or punch step removes at most STEP_EXTENTS.
const CHUNK_EXTENTS: u32 = 8
const STEP_EXTENTS: u32 = 16
const C_WRITE_CHUNK: u32 = C_INODE + CHUNK_EXTENTS * C_ALLOC
const C_TRUNCATE_STEP: u32 = 64
const C_PUNCH_STEP: u32 = C_TRUNCATE_STEP + C_EXT + C_GROUP
// Delete's last transaction: the inode's own block, its group's bitmap and descriptor, the orphan
// list's predecessor (an inode or the superblock), and the xattr block's group.
const C_DELETE_LAST: u32 = C_INODE + C_GROUP + C_INODE + C_GROUP
// A directory's half of an operation (section 14, "Credits"): inserting a name walks an index path of
// up to DIR_MAX_LEVELS blocks to a leaf and may add up to DIR_MAX_LEVELS + 1 blocks, each allocated and
// mapped; removing one changes the path, the leaf and a sibling, and may free as many blocks, each
// unmapped, with a revoke.
const C_DIR_ADD: u32 = u32(DIR_MAX_LEVELS) + 1 + (u32(DIR_MAX_LEVELS) + 1) * C_ALLOC
const C_DIR_DEL: u32 = u32(DIR_MAX_LEVELS) + 2 + (u32(DIR_MAX_LEVELS) + 1) * (C_GROUP + C_EXT) + 1
// The namespace operations (section 14, "Credits"; section 18 says what each writes). Create, mknod,
// mkdir and an inline symlink: the new inode's group, its block and the parent's, and the name. A
// symlink whose target needs a block allocates and maps one more run. A link: the target's block and
// the parent's, and the name. An unlink or rmdir: the parent, the victim, the victim's orphan-list
// neighbour, the name, the superblock. A rename of any form: both parents, the moved inode and the
// victim, a name added and one removed, the superblock.
const C_CREATE: u32 = C_GROUP + 2 * C_INODE + C_DIR_ADD
const C_SYMLINK_BLOCK: u32 = C_CREATE + C_ALLOC
const C_LINK: u32 = 2 * C_INODE + C_DIR_ADD
const C_UNLINK: u32 = 3 * C_INODE + C_DIR_DEL + C_SB
const C_RENAME: u32 = 4 * C_INODE + C_DIR_ADD + C_DIR_DEL + C_SB
// setattr of anything but a shrinking size: the inode. setxattr and removexattr: the inode, the xattr
// block's group, the xattr block, and the superblock the first one marks with the XATTR feature.
const C_SETATTR: u32 = C_INODE
const C_XATTR: u32 = C_INODE + C_GROUP + 2

// The longest symlink target: PATH_MAX less its terminating NUL (section 3).
const SYMLINK_MAX: usize = PATH_MAX - 1

// `renameat2`'s flags (Linux's values).
const RENAME_NOREPLACE: u32 = 1
const RENAME_EXCHANGE: u32 = 2

// `setxattr`'s flags (Linux's values).
const XATTR_CREATE: u32 = 1
const XATTR_REPLACE: u32 = 2

// The longest extended attribute name, without its namespace prefix, and the bytes every attribute of an
// inode shares: the xattr block from its 8-byte header to its tail (section 13).
const XATTR_NAME_MAX: usize = 255
const XATTR_AREA: usize = TAIL_OFFSET - 8

// The feature bits of section 21.
const RO_COMPAT_XATTR: u32 = 1

// statfs (section 20): `f_type`, and the `f_flags` bits (Linux's `ST_*`).
const KFS_STATFS_MAGIC: u64 = 0x4B46_5331
const ST_RDONLY: u64 = 1
const ST_RELATIME: u64 = 0x1000

// Directory positions (section 10, "readdir positions"): `.`, `..`, and the end; an entry's is its
// hash halved, which lies between them.
const DIR_POS_DOT: u64 = 1
const DIR_POS_DOTDOT: u64 = 2
const DIR_POS_FIRST: u64 = 4
const DIR_POS_END: u64 = 0x7FFF_FFFF_FFFF_FFFF

// The largest file: 2^32 blocks of 4 KiB, 16 TiB (section 3).
const MAX_FILE_SIZE: u64 = LOGICAL_BLOCKS * 4096

// Where things are inside a block. The tail is the last 16 bytes of every owned metadata block; the
// journal's descriptor and revoke blocks keep only a 4-byte checksum there.
const TAIL_OFFSET: usize = 4080
const BLOCK_CRC_OFFSET: usize = 4092
const SECTOR_CRC_OFFSET: usize = 508

// Magic numbers: four ASCII bytes read as a little-endian u32.
const SUPER_MAGIC: u32 = 0x5353_464B            // "KFSS"
const EXTENT_MAGIC: u32 = 0x5853_464B           // "KFSX"
const DIR_LEAF_MAGIC: u32 = 0x4453_464B         // "KFSD"
const DIR_INDEX_MAGIC: u32 = 0x4853_464B        // "KFSH"
const XATTR_MAGIC: u32 = 0x4153_464B            // "KFSA"
const JOURNAL_MAGIC: u32 = 0x4A53_464B          // "KFSJ"

const FORMAT_VERSION: u32 = 1
const HASH_SIPHASH13: u8 = 1
const CSUM_CRC32C: u8 = 1

// Superblock `state`.
const STATE_CLEAN: u16 = 1
const STATE_ERROR: u16 = 2

// Group descriptor `flags`.
const GROUP_COPY: u32 = 1

// Inode `flags`.
const INODE_INLINE: u32 = 1
const INODE_INDEXED: u32 = 2
const INODE_ORPHAN: u32 = 4

// Extent `flags`.
const EXTENT_UNWRITTEN: u16 = 1

// Directory `file_type` (Linux's DT_*).
const DT_UNKNOWN: u8 = 0
const DT_FIFO: u8 = 1
const DT_CHR: u8 = 2
const DT_DIR: u8 = 4
const DT_BLK: u8 = 6
const DT_REG: u8 = 8
const DT_LNK: u8 = 10
const DT_SOCK: u8 = 12

// Extended attribute namespaces.
const XATTR_USER: u8 = 1
const XATTR_TRUSTED: u8 = 2
const XATTR_SECURITY: u8 = 3
const XATTR_SYSTEM: u8 = 4

// Journal block types and tag flags.
const JOURNAL_SUPER: u32 = 1
const JOURNAL_DESCRIPTOR: u32 = 2
const JOURNAL_REVOKE: u32 = 3
const JOURNAL_COMMIT: u32 = 4
const TAG_ESCAPED: u32 = 1

// How many tags a descriptor block holds, and how many block numbers a revoke block holds.
const DESCRIPTOR_TAGS: usize = 254
const REVOKE_ENTRIES: usize = 508
