module keel.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// `truncate` (kfs/SPEC.md section 18): growing leaves a hole, shrinking zeroes the new last block's
// tail and frees what lies past it in steps under the orphan list, the same size changes nothing,
// truncating to 0 frees everything, and 16 TiB is the limit.

private bs() -> u64 = u64(BLOCK_SIZE)

@test("growing is one transaction: the new range is a hole, mtime and ctime move, no orphan")
grow()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 100, 1)
    val t0 = must_inode(stat(&fs, ino))
    val m0 = fs.handles_opened()
    must(truncate(&fs, ino, 5 * bs() + 3, 0))
    assert(fs.handles_opened() - m0 == 1)
    val n = must_inode(stat(&fs, ino))
    assert(n.size == 5 * bs() + 3 && n.blocks == 1 && n.flags & INODE_ORPHAN == 0)
    assert(before(t0.mtime_sec, t0.mtime_nsec, n.mtime_sec, n.mtime_nsec) && n.ctime_sec == n.mtime_sec)
    val back = got(&fs, ino, 0, 5 * BLOCK_SIZE + 3)
    assert(back.len() == 5 * BLOCK_SIZE + 3)
    assert(zeroed(back.view()[100..<back.len()]))
    settled_clean(&fs)

@test("truncating to the same size changes nothing at all: no handle, no times")
same_size()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 1000, 1)
    val t0 = must_inode(stat(&fs, ino))
    val m0 = fs.handles_opened()
    must(truncate(&fs, ino, 1000, 0))
    assert(fs.handles_opened() == m0)
    val n = must_inode(stat(&fs, ino))
    assert(n.mtime_sec == t0.mtime_sec && n.ctime_sec == t0.ctime_sec && n.size == 1000)

@test("shrinking inside the last block zeroes the tail as ordered data; a later grow reads zeros there")
shrink_then_grow_tail_zero()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 3 * BLOCK_SIZE, 1)
    must(fs.checkpoint_all())
    must(truncate(&fs, ino, 2 * bs() + 100, 0))
    assert(blocks_of(&fs, ino) == 3 && size_of(&fs, ino) == 2 * bs() + 100)
    must(truncate(&fs, ino, 3 * bs(), 0))
    val back = got(&fs, ino, 0, 3 * BLOCK_SIZE)
    val want = pattern(3 * BLOCK_SIZE, 1)
    for i in 0..<(2 * BLOCK_SIZE + 100)
        assert(back[i] == want[i])
    assert(zeroed(back.view()[2 * BLOCK_SIZE + 100..<3 * BLOCK_SIZE]))
    // On the disk too, after the commit.
    must(fs.checkpoint_all())
    assert(zeroed(raw(&dev, phys_at(&fs, ino, 2)).view()[100..<BLOCK_SIZE]))
    settled_clean(&fs)

@test("shrinking frees every block past the new last one and puts the inode on the orphan list until it is done")
shrink_frees_blocks()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = sparse_file(&fs, 60)
    must(fs.checkpoint_all())
    val free0 = free_total(&fs)
    val held = blocks_of(&fs, ino)
    must(truncate(&fs, ino, 10 * bs() + 1, 0))
    // Blocks 0, 2, 4, 6, 8, 10 stay: six data blocks, and the tree is back in the inode.
    val n = must_inode(stat(&fs, ino))
    assert(n.size == 10 * bs() + 1 && n.blocks == 6 && n.flags & INODE_ORPHAN == 0 && n.orphan_next == 0)
    assert(must_u16(depth_of(&fs, ino)) == 0)
    assert(orphans(&fs).len() == 0 && fs.sb.orphan_head == 0)
    must(fs.checkpoint_all())
    assert(free_total(&fs) == free0 + held - 6)
    assert(super_of(&dev).orphan_head == 0)
    settled_clean(&fs)

@test("a shrink with nothing past the new end to free is one transaction and never an orphan")
shrink_without_steps()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 100, 1)
    must(truncate(&fs, ino, 50 * bs(), 0))
    val m0 = fs.handles_opened()
    must(truncate(&fs, ino, 2 * bs(), 0))
    assert(fs.handles_opened() - m0 == 1)
    assert(blocks_of(&fs, ino) == 1 && orphans(&fs).len() == 0)
    settled_clean(&fs)

@test("the steps of a shrink: each removes at most sixteen extents, in a handle of its own")
shrink_steps()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = sparse_file(&fs, 40)
    val m0 = fs.handles_opened()
    must(truncate(&fs, ino, 0, 0))
    // The first transaction, ceil(40 / 16) = 3 steps, the orphan removal.
    assert(fs.handles_opened() - m0 == 5)
    assert(blocks_of(&fs, ino) == 0 && size_of(&fs, ino) == 0)
    settled_clean(&fs)

@test("truncating to 0 frees every block and leaves an empty root")
truncate_to_zero()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = sparse_file(&fs, 20)
    must(fs.checkpoint_all())
    must(truncate(&fs, ino, 0, 0))
    val n = must_inode(stat(&fs, ino))
    assert(n.size == 0 && n.blocks == 0 && must_u16(depth_of(&fs, ino)) == 0)
    assert(last_extent(&fs, ino).is_ok())
    var out = zeros(10)
    assert(must_n(read(&fs, ino, 0, out.view())) == 0)
    settled_clean(&fs)

@test("a shrink frees unwritten extents past the new end too")
shrink_frees_preallocation()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 10, 1)
    must(fallocate(&fs, ino, Falloc.KeepSize, bs(), 8 * bs(), 0))
    assert(blocks_of(&fs, ino) == 9 && size_of(&fs, ino) == 10)
    must(truncate(&fs, ino, 5, 0))
    assert(blocks_of(&fs, ino) == 1 && phys_at(&fs, ino, 3) == 0)
    settled_clean(&fs)

@test("truncating an open unlinked file frees past the new end and leaves it on the list for its delete")
truncate_open_orphan()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = sparse_file(&fs, 30)
    must(hold(&fs, ino))
    must(drop_link(&fs, ino))
    must(truncate(&fs, ino, 3 * bs(), 0))
    val n = must_inode(stat(&fs, ino))
    assert(n.size == 3 * bs() && n.blocks == 2 && n.links == 0 && n.flags & INODE_ORPHAN != 0)
    assert(orphans(&fs).len() == 1 && orphans(&fs)[0] == ino)
    settled_clean(&fs)
    must(release(&fs, ino))
    assert(orphans(&fs).len() == 0 && code(stat(&fs, ino)) == 3)
    settled_clean(&fs)

@test("truncate and delete steps stay inside their credits on a deep tree of the smallest nodes")
steps_within_credits_deep_tree()
    var dev = small_device()
    var fs = mounted(&dev)
    fs.node_max = 2
    val a = sparse_file(&fs, 120)
    assert(must_u16(depth_of(&fs, a)) >= 4)
    // Every step runs under the credit check; an overrun is a fatal the host turns into a panic.
    must(truncate(&fs, a, 7 * bs(), 0))
    // Blocks 0, 2, 4 and 6 stay, with whatever nodes still hold them (nodes of two need not collapse).
    assert(phys_at(&fs, a, 6) != 0 && phys_at(&fs, a, 8) == 0 && last_extent(&fs, a).unwrap().unwrap().logical == 6)
    val b = sparse_file(&fs, 120)
    must(drop_link(&fs, b))
    assert(code(stat(&fs, b)) == 3)
    settled_clean(&fs)

@test("past 16 TiB is TooBig; exactly 16 TiB is a size like any other")
truncate_limit()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    assert(code(truncate(&fs, ino, MAX_FILE_SIZE + 1, 0)) == 7)
    must(truncate(&fs, ino, MAX_FILE_SIZE, 0))
    assert(size_of(&fs, ino) == MAX_FILE_SIZE && blocks_of(&fs, ino) == 0)
    val tail = got(&fs, ino, MAX_FILE_SIZE - 3, 10)
    assert(tail.len() == 3 && zeroed(tail.view()))
    must(truncate(&fs, ino, 0, 0))
    settled_clean(&fs)

@test("truncating a directory, a symlink or a free inode is Invalid")
truncate_wrong_types()
    var dev = small_device()
    var fs = mounted(&dev)
    assert(code(truncate(&fs, ROOT_INO, 0, 0)) == 3)
    assert(code(truncate(&fs, new_inode(&fs, S_IFLNK | 0o777, 0), 0, 0)) == 3)
    assert(code(truncate(&fs, FIRST_INO + 70, 0, 0)) == 3)

@test("a crash after a shrink's first transaction leaves the new size; the next mount frees the rest")
shrink_finished_by_mount()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = sparse_file(&fs, 50)
    must(fs.checkpoint_all())
    val free0 = free_total(&fs)
    val held = blocks_of(&fs, ino)
    // The first transaction alone, as a crash after its commit leaves it.
    var h = fs.start("truncate", C_INODE + C_SB)
    must(truncate_first_only(&fs, &h, ino, 3 * bs()))
    fs.stop(&h)
    must(fs.checkpoint_all())
    assert(super_of(&dev).orphan_head == ino)
    val on_disk = must_inode(stat(&fs, ino))
    assert(on_disk.size == 3 * bs() && on_disk.flags & INODE_ORPHAN != 0)
    // The checker accepts an orphan whose blocks past its size are still mapped.
    checked_clean(&dev)
    var again = mounted(&dev)
    val n = must_inode(stat(&again, ino))
    assert(n.size == 3 * bs() && n.blocks == 2 && n.flags & INODE_ORPHAN == 0)
    assert(orphans(&again).len() == 0 && again.sb.orphan_head == 0)
    must(again.checkpoint_all())
    // Blocks 0 and 2 stay.
    assert(free_total(&again) == free0 + held - 2)
    settled_clean(&again)

// A shrinking truncate's first transaction alone, in `h`: what a crash right after its commit leaves.
truncate_first_only(fs: *RamFs, h: *Handle, ino: u64, size: u64) -> Result[unit, FsError]
    val t = size % u64(BLOCK_SIZE)
    if t != 0 then return Err(FsError.Invalid)
    change_inode(fs, h, ino, (n) -> n.size = size)?
    orphan_add(fs, h, ino)
