module keel.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// The journal while mounted (kfs/SPEC.md section 14): handles and credits, closing a transaction, the
// commit's order and its two flushes, frozen copies, pinning, revocation, escaping, the log's wrap,
// checkpoint, the abort and section 18's mount and unmount. Every claim about the disk is read back from
// the RamDevice or its write log, and the recovery that a later mount runs is the test of what reached it.

// -- Credits and closing ------------------------------------------------------------------------------

@test("a transaction exactly filling max_transaction: 253 copies, a descriptor, a revoke block of 253, the commit")
exactly_max_transaction()
    var dev = small_device()
    var fs = mounted(&dev)
    assert_eq(fs.sb.max_transaction, 256)
    assert_eq(fs.max_credits(), 253)
    var h = must_handle(fs.try_start("fill", 253))
    for k in 0..<253u64
        stamp(&fs, &h, scratch(&fs, k), 10 + u32(k))
    for k in 0..<253u64
        fs.revoke(&h, scratch(&fs, 300 + k))
    // One more credit beside it does not fit: the transaction closes and the opener waits.
    assert(waits(fs.try_start("one more", 1)))
    // The last handle leaving a closed transaction commits it (inline: no commit thread on the host).
    fs.stop(&h)
    assert_eq(fs.log_used(), 256)
    val c = log_contents(&dev)
    assert_eq(c.txns.len(), 1)
    assert_eq(c.txns[0].blocks, 255)
    assert_eq(c.copies.len(), 253)
    assert_eq(c.descriptors, 1)
    assert_eq(c.revoke_blocks, 1)
    assert_eq(c.revoked.len(), 253)
    var next = must_handle(fs.try_start("one more", 1))
    assert_eq(next.seq, h.seq + 1)
    fs.stop(&next)
    var again = mounted(&dev)
    for k in 0..<253u64
        assert(holds(&dev, scratch(&again, k), 10 + u32(k)))

@test("more credits than any transaction can hold are refused, and a refused handle answers why at its first declaration")
too_many_credits_refused()
    var dev = small_device()
    var fs = mounted(&dev)
    assert_eq(fails(fs.try_start("big", 254)), 3)
    assert_eq(fails(fs.try_start("none", 0)), 3)
    var h = fs.start("big", 254)
    val id = must_id(fs.buffer(scratch(&fs, 0)))
    fs.plat.lock(LockId.Buffer(scratch(&fs, 0)))
    assert_eq(fails(fs.write_access(&h, id)), 3)
    fs.plat.unlock(LockId.Buffer(scratch(&fs, 0)))
    fs.stop(&h)
    assert_eq(fs.open_handles(), 0)
    // The wide journal's limit: 634 + 3 descriptors + 2 revoke blocks + the commit = 640.
    var wide = wide_device()
    var wfs = mounted(&wide)
    assert_eq(wfs.max_credits(), 634)
    assert_eq(txn_blocks(634, 634), 640)
    assert_eq(txn_blocks(635, 635), 641)

@test("a handle that would outgrow the running transaction closes it; it commits when its last handle leaves and the waiter joins the next")
closing_on_the_credit_limit()
    var dev = small_device()
    var fs = mounted(&dev)
    val seq = fs.running()
    var a = must_handle(fs.try_start("a", 200))
    for k in 0..<3u64
        stamp(&fs, &a, scratch(&fs, k), 1)
    assert(waits(fs.try_start("b", 100)))
    // Closed now: even a small handle waits.
    assert(waits(fs.try_start("c", 1)))
    assert_eq(fs.logged_count(), 0)
    fs.stop(&a)
    assert_eq(fs.logged_count(), 1)
    assert_eq(fs.running(), seq + 1)
    var b = must_handle(fs.try_start("b", 100))
    assert_eq(b.seq, seq + 1)
    fs.stop(&b)

@test("a stopped handle's unspent credits leave the reservation, so later handles still join the same transaction")
unspent_credits_return()
    var dev = small_device()
    var fs = mounted(&dev)
    var a = must_handle(fs.try_start("a", 200))
    stamp(&fs, &a, scratch(&fs, 0), 1)
    stamp(&fs, &a, scratch(&fs, 1), 1)
    stamp(&fs, &a, scratch(&fs, 2), 1)
    fs.stop(&a)
    // 3 buffers held + 240 = 243 copies: 243 + 1 + 1 + 1 = 246 blocks.
    var b = must_handle(fs.try_start("b", 240))
    assert_eq(b.seq, a.seq)
    // Beside b: 3 + 240 + 10 = 253 fits exactly; 11 more would need 257.
    var c = must_handle(fs.try_start("c", 10))
    assert_eq(c.seq, a.seq)
    fs.stop(&c)
    assert(waits(fs.try_start("d", 11)))
    fs.stop(&b)

@test("the running transaction closes after COMMIT_INTERVAL on the monotonic clock, and the timer commits it")
commit_interval()
    var dev = small_device()
    var fs = mounted(&dev)
    fs.plat.ms = 1000
    var a = fs.start("a", 2)
    stamp(&fs, &a, scratch(&fs, 0), 1)
    fs.stop(&a)
    val seq = fs.running()
    fs.plat.ms = 1000 + 4999
    var b = must_handle(fs.try_start("b", 2))
    assert_eq(b.seq, seq)
    fs.stop(&b)
    fs.plat.ms = 6000
    assert(waits(fs.try_start("c", 2)))
    var c = fs.start("c", 2)
    assert_eq(c.seq, seq + 1)
    assert_eq(fs.logged_count(), 1)
    stamp(&fs, &c, scratch(&fs, 1), 2)
    fs.stop(&c)
    // Not yet five seconds since c opened its transaction: the timer leaves it.
    fs.plat.ms = 10_999
    must(fs.tick())
    assert_eq(fs.logged_count(), 1)
    fs.plat.ms = 11_000
    must(fs.tick())
    assert_eq(fs.logged_count(), 2)
    assert_eq(fs.running(), seq + 2)
    // An empty transaction is never committed by the timer, however old.
    fs.plat.ms = 100_000
    must(fs.tick())
    assert_eq(fs.running(), seq + 2)

@test("a transaction that logs nothing takes no sequence: an empty commit, and one of ordered data alone")
nothing_logged_takes_no_sequence()
    var dev = small_device()
    var fs = mounted(&dev)
    val seq = fs.running()
    must(fs.commit())
    assert_eq(fs.running(), seq)
    var h = fs.start("write", 1)
    must(fs.write_data(&h, scratch(&fs, 40), filled_block(5).view()))
    fs.stop(&h)
    val flushes = dev.flushes()
    must(fs.commit())
    assert_eq(fs.running(), seq)
    assert_eq(fs.logged_count(), 0)
    assert_eq(dev.flushes(), flushes + 1)
    assert(holds(&dev, scratch(&fs, 40), 5))
    // The next transaction that does log uses the sequence, so the log has no gap.
    var blocks: Buf[u64] = buf()
    blocks.push(scratch(&fs, 41))
    stamp_all(&fs, blocks, 6)
    assert_eq(log_contents(&dev).txns[0].seq, seq)
    var again = mounted(&dev)
    assert(holds(&dev, scratch(&again, 41), 6))

// -- The commit -----------------------------------------------------------------------------------------

@test("the write log of a commit: ordered data, then the log blocks, a flush, the commit block, a flush; home only at the checkpoint")
commit_write_order()
    var dev = small_device()
    var fs = mounted(&dev)
    val data_block = scratch(&fs, 500)
    val m0 = scratch(&fs, 0)
    val m1 = scratch(&fs, 1)
    dev.reset_counters()
    var h = fs.start("write", 3)
    must(fs.write_data(&h, data_block, filled_block(7).view()))
    stamp(&fs, &h, m0, 1)
    stamp(&fs, &h, m1, 2)
    fs.revoke(&h, scratch(&fs, 9))
    fs.stop(&h)
    must(fs.commit())
    val sb = fs.sb
    // data, the journal superblock (the log was empty), the two copies, the descriptor, the revoke
    // block — all before the first flush — then the commit block, then the second flush.
    assert_eq(dev.log_len(), 7)
    assert_eq(dev.log_block(0), data_block)
    assert_eq(dev.log_block(1), sb.journal_start)
    assert_eq(dev.log_block(2), log_pos(sb, 2))
    assert_eq(dev.log_block(3), log_pos(sb, 3))
    assert_eq(dev.log_block(4), log_pos(sb, 1))
    assert_eq(dev.log_block(5), log_pos(sb, 4))
    assert_eq(dev.log_block(6), log_pos(sb, 5))
    for i in 0usize..<6
        assert_eq(dev.log_epoch(i), 0)
    assert_eq(dev.log_epoch(6), 1)
    assert_eq(dev.flushes(), 2)
    assert_eq(writes_to(&dev, m0).len(), 0)
    assert_eq(writes_to(&dev, m1).len(), 0)
    // The checkpoint: both home, a flush, the journal superblock (start = 0), a flush.
    assert(must_bool(fs.checkpoint()))
    assert_eq(dev.log_len(), 10)
    assert_eq(dev.log_epoch(7), 2)
    assert_eq(dev.log_epoch(8), 2)
    assert_eq(dev.log_block(9), sb.journal_start)
    assert_eq(dev.log_epoch(9), 3)
    assert_eq(dev.flushes(), 4)
    assert(holds(&dev, m0, 1))
    assert(holds(&dev, m1, 2))
    assert_eq(journal_of(&dev).start, 0)

@test("the same block journaled by three handles of one transaction is logged once, with the last bytes")
same_block_logged_once()
    var dev = small_device()
    var fs = mounted(&dev)
    val m = scratch(&fs, 3)
    for s in 0..<3u32
        var h = fs.start("t", 1)
        stamp(&fs, &h, m, 10 + s)
        fs.stop(&h)
    must(fs.commit())
    val c = log_contents(&dev)
    assert_eq(c.copies.len(), 1)
    assert_eq(c.descriptors, 1)
    assert(same(copies_of(c, m)[0].data.view(), filled_block(12).view()))

@test("a 600-copy transaction spans three descriptors (254, 254, 92) and replays whole")
six_hundred_copies()
    var dev = wide_device()
    var fs = mounted(&dev)
    var blocks: Buf[u64] = buf()
    for k in 0..<600u64
        blocks.push(scratch(&fs, k))
    stamp_all(&fs, blocks, 100)
    val c = log_contents(&dev)
    assert_eq(c.copies.len(), 600)
    assert_eq(c.descriptors, 3)
    assert_eq(c.txns[0].blocks, 603)
    var again = mounted(&dev)
    for k in 0..<600u64
        assert(holds(&dev, scratch(&again, k), 100 + u32(k)))

// A block beginning with the journal magic: `kind` after it, then `filled_block(salt)`'s bytes.
private magic_block(kind: u32, salt: u32) -> Buf[u8]
    var b = filled_block(salt)
    put_le32(b.view(), 0, JOURNAL_MAGIC)
    put_le32(b.view(), 4, kind)
    b

@test("every copy beginning with the journal magic is logged escaped and replayed with the magic restored")
escaped_copies()
    var dev = small_device()
    var fs = mounted(&dev)
    var contents: Buf[Buf[u8]] = buf()
    for kind in 0u32..<6
        contents.push(magic_block(kind, 60 + kind))
    // A valid descriptor of the very transaction it is logged in, checksum and all.
    var forged = new_block()
    val d: *DescriptorHeader = at(forged.view(), 0)
    d.header.magic = JOURNAL_MAGIC
    d.header.kind = JOURNAL_DESCRIPTOR
    d.header.sequence = fs.running()
    d.count = 1
    seal_journal_block(fs.seed, forged.view())
    contents.push(forged)
    // A control: the magic's bytes one off.
    var near = magic_block(2, 70)
    near[3] = near[3] ^ 0x01
    contents.push(near)
    var h = fs.start("escape", u32(contents.len()))
    for i in 0..<contents.len()
        put_bytes(&fs, &h, scratch(&fs, u64(i)), contents[i].view())
    fs.stop(&h)
    must(fs.commit())
    val c = log_contents(&dev)
    assert_eq(c.copies.len(), contents.len())
    for i in 0..<contents.len()
        val x = copies_of(c, scratch(&fs, u64(i)))[0]
        if i + 1 < contents.len()
            assert_eq(x.flags, TAG_ESCAPED)
            assert_eq(le32(x.data.view(), 0), 0)
        else
            assert_eq(x.flags, 0)
            assert(same(x.data.view(), contents[i].view()))
        assert(same(x.data.view()[4..<BLOCK_SIZE], contents[i].view()[4..<BLOCK_SIZE]))
    var again = mounted(&dev)
    for i in 0..<contents.len()
        assert(same(raw(&dev, scratch(&again, u64(i))).view(), contents[i].view()))

// -- Frozen copies and pinning -----------------------------------------------------------------------

@test("a buffer changed by T + 1 while T commits is logged in T with T's bytes only (the frozen copy)")
frozen_copy()
    var dev = small_device()
    var fs = mounted(&dev)
    val m = scratch(&fs, 5)
    var h = fs.start("t", 1)
    val id = stamp(&fs, &h, m, 1)
    fs.stop(&h)
    assert(must_bool(fs.commit_begin()))
    assert(fs.committing())
    var next = must_handle(fs.try_start("t+1", 1))
    assert_eq(next.seq, h.seq + 1)
    stamp(&fs, &next, m, 2)
    must(fs.commit_finish())
    val c = log_contents(&dev)
    val ms = copies_of(c, m)
    assert_eq(ms.len(), 1)
    assert_eq(ms[0].seq, h.seq)
    assert(same(ms[0].data.view(), filled_block(1).view()))
    // The buffer holds T + 1's bytes and T + 1 still pins it.
    assert(same(fs.bytes(id), filled_block(2).view()))
    assert(fs.pinned(id))
    fs.stop(&next)
    // A crash now: replay gives T's bytes.
    var again = mounted(&dev)
    assert(holds(&dev, m, 1))

@test("after T + 1 commits too, the log holds both versions in order and replay ends with T + 1's")
frozen_then_next_commit()
    var dev = small_device()
    var fs = mounted(&dev)
    val m = scratch(&fs, 5)
    var h = fs.start("t", 1)
    stamp(&fs, &h, m, 1)
    fs.stop(&h)
    assert(must_bool(fs.commit_begin()))
    var next = must_handle(fs.try_start("t+1", 1))
    stamp(&fs, &next, m, 2)
    must(fs.commit_finish())
    fs.stop(&next)
    must(fs.commit())
    val ms = copies_of(log_contents(&dev), m)
    assert_eq(ms.len(), 2)
    assert(same(ms[0].data.view(), filled_block(1).view()))
    assert(same(ms[1].data.view(), filled_block(2).view()))
    var again = mounted(&dev)
    assert(holds(&dev, m, 2))

@test("a pinned buffer is never written home or evicted before its commit; a committed one is written home on eviction")
pinned_buffers()
    var dev = small_device()
    var fs = mounted(&dev)
    val m = scratch(&fs, 7)
    var t0 = fs.start("t0", 1)
    val id = stamp(&fs, &t0, m, 1)
    fs.stop(&t0)
    must(fs.commit())
    var t1 = fs.start("t1", 1)
    stamp(&fs, &t1, m, 2)
    dev.reset_counters()
    // T0's checkpoint needs m, which T1 pins: it is refused, and nothing is written.
    assert(!must_bool(fs.checkpoint()))
    assert(fs.pinned(id))
    assert(!must_bool(fs.evict(id)))
    assert_eq(dev.log_len(), 0)
    fs.stop(&t1)
    must(fs.commit())
    must(fs.checkpoint_all())
    val homes = writes_to(&dev, m)
    assert_eq(homes.len(), 1)
    // After T1's commit block and its flush.
    assert(dev.log_epoch(homes[0]) >= 2)
    assert(holds(&dev, m, 2))
    // A committed buffer not yet checkpointed is written home when evicted, then dropped.
    val n = scratch(&fs, 8)
    var t2 = fs.start("t2", 1)
    val nid = stamp(&fs, &t2, n, 3)
    fs.stop(&t2)
    must(fs.commit())
    assert(!holds(&dev, n, 3))
    assert(must_bool(fs.evict(nid)))
    assert(holds(&dev, n, 3))
    assert(fs.cached_id(n).is_none())
    // Its transaction still checkpoints (with nothing left to write) and the log empties.
    must(fs.checkpoint_all())
    assert_eq(fs.log_used(), 0)
    assert_eq(journal_of(&dev).start, 0)

// -- Revocation ---------------------------------------------------------------------------------------

@test("a block journaled and then freed in one transaction is revoked and not logged, and never written home")
journaled_then_revoked()
    var dev = small_device()
    var fs = mounted(&dev)
    val m = scratch(&fs, 11)
    var h = fs.start("free", 2)
    stamp(&fs, &h, m, 1)
    fs.revoke(&h, m)
    fs.stop(&h)
    must(fs.commit())
    val c = log_contents(&dev)
    assert_eq(copies_of(c, m).len(), 0)
    assert_eq(c.revoked.len(), 1)
    assert_eq(c.revoked[0], m)
    assert(fs.cached_id(m).is_none())
    must(fs.checkpoint_all())
    assert_eq(writes_to(&dev, m).len(), 0)

@test("a block revoked and then journaled again in the same transaction is replayed: the journaling cancels the revoke")
revoked_then_rejournaled()
    // Cached when revoked (journaled by an older transaction), and not cached.
    for cached in 0..<2
        var dev = small_device()
        var fs = mounted(&dev)
        val m = scratch(&fs, 12)
        if cached == 1
            var t1 = fs.start("t1", 1)
            stamp(&fs, &t1, m, 1)
            fs.stop(&t1)
            must(fs.commit())
        var t2 = fs.start("t2", 2)
        fs.revoke(&t2, m)
        stamp(&fs, &t2, m, 2)
        fs.stop(&t2)
        must(fs.commit())
        val c = log_contents(&dev)
        assert_eq(c.revoked.len(), 0)
        assert_eq(copies_of(c, m).len(), 1 + usize(cached))
        var again = mounted(&dev)
        assert(holds(&dev, m, 2))

@test("journaled in T1, revoked in T2, rewritten as data in T3, crash: replay leaves the data")
revoke_keeps_new_data()
    var dev = small_device()
    var fs = mounted(&dev)
    val m = scratch(&fs, 13)
    var t1 = fs.start("t1", 1)
    stamp(&fs, &t1, m, 1)
    fs.stop(&t1)
    must(fs.commit())
    var t2 = fs.start("t2", 1)
    fs.revoke(&t2, m)
    fs.stop(&t2)
    must(fs.commit())
    var t3 = fs.start("t3", 1)
    must(fs.write_data(&t3, m, filled_block(3).view()))
    fs.stop(&t3)
    must(fs.commit())
    assert(holds(&dev, m, 3))
    assert_eq(log_contents(&dev).txns.len(), 2)
    var again = mounted(&dev)
    assert(holds(&dev, m, 3))

@test("a revoke after the wrap cancels a copy before it; a transaction ends exactly at the last log block")
revoke_across_the_wrap()
    var dev = small_device()
    var fs = mounted(&dev)
    val m = scratch(&fs, 14)
    advance_head_to(&fs, 1018)
    var blocks: Buf[u64] = buf()
    blocks.push(m)
    for k in 0..<3u64
        blocks.push(scratch(&fs, 20 + k))
    stamp_all(&fs, blocks, 1)
    assert_eq(fs.log_head(), 1)
    var t2 = fs.start("t2", 1)
    fs.revoke(&t2, m)
    fs.stop(&t2)
    must(fs.commit())
    var t3 = fs.start("t3", 1)
    must(fs.write_data(&t3, m, filled_block(9).view()))
    fs.stop(&t3)
    must(fs.commit())
    val c = log_contents(&dev)
    assert_eq(c.txns.len(), 2)
    assert_eq(c.txns[0].first, 1018)
    assert_eq(c.txns[0].commit, 1023)
    assert_eq(c.txns[1].first, 1)
    assert_eq(c.revoked[0], m)
    var again = mounted(&dev)
    assert(holds(&dev, m, 9))
    for k in 0..<3u64
        assert(holds(&dev, scratch(&again, 20 + k), 2 + u32(k)))

@test("a transaction straddling the log's end is written across the wrap and replayed whole")
straddling_the_end()
    var dev = small_device()
    var fs = mounted(&dev)
    advance_head_to(&fs, 1020)
    var blocks: Buf[u64] = buf()
    for k in 0..<5u64
        blocks.push(scratch(&fs, 30 + k))
    stamp_all(&fs, blocks, 40)
    val c = log_contents(&dev)
    assert_eq(c.txns[0].first, 1020)
    assert_eq(c.txns[0].commit, 3)
    assert_eq(c.copies[3].pos, 1)
    var again = mounted(&dev)
    for k in 0..<5u64
        assert(holds(&dev, scratch(&again, 30 + k), 40 + u32(k)))

@test("a handle revoking more blocks than its credits is a bug: fatal")
revoke_overrun()
    var dev = small_device()
    var fs = mounted(&dev)
    fs.plat.record_fatal = true
    var h = fs.start("free", 1)
    fs.revoke(&h, scratch(&fs, 1))
    assert_eq(fs.plat.fatals, 0)
    fs.revoke(&h, scratch(&fs, 2))
    assert_eq(fs.plat.fatals, 1)
    assert_eq(fs.plat.last_fatal, 2)
    fs.stop(&h)

// -- Checkpoint and log space -------------------------------------------------------------------------

@test("each checkpoint moves the journal superblock's start and start_seq to the oldest transaction left, then to 0")
checkpoint_moves_start()
    var dev = small_device()
    var fs = mounted(&dev)
    var firsts: Buf[u32] = buf()
    var seqs: Buf[u64] = buf()
    for i in 0..<3u64
        var blocks: Buf[u64] = buf()
        blocks.push(scratch(&fs, i))
        firsts.push(fs.log_head())
        seqs.push(fs.running())
        stamp_all(&fs, blocks, u32(i))
    assert_eq(journal_of(&dev).start, firsts[0])
    assert_eq(journal_of(&dev).start_seq, seqs[0])
    for i in 1usize..<3
        assert(must_bool(fs.checkpoint()))
        assert_eq(journal_of(&dev).start, firsts[i])
        assert_eq(journal_of(&dev).start_seq, seqs[i])
        assert(holds(&dev, scratch(&fs, u64(i - 1)), u32(i - 1)))
    assert(must_bool(fs.checkpoint()))
    assert_eq(journal_of(&dev).start, 0)
    assert_eq(journal_of(&dev).start_seq, fs.running())
    assert(!must_bool(fs.checkpoint()))
    assert_eq(fs.log_used(), 0)

@test("a log refilled over checkpointed transactions, twice round, still recovers every committed one")
wrap_over_checkpointed()
    var dev = small_device()
    var fs = mounted(&dev)
    var blocks: Buf[u64] = buf()
    for k in 0..<200u64
        blocks.push(scratch(&fs, k))
    // Each transaction is 202 log blocks; twelve of them go round a log of 1023 more than twice, so
    // handles wait and checkpoints make the room.
    for i in 0..<12u32
        stamp_all(&fs, blocks, 1000 * i)
    assert(fs.logged_count() >= 2)
    var again = mounted(&dev)
    for k in 0..<200u64
        assert(holds(&dev, scratch(&again, k), 11_000 + u32(k)))

@test("a handle that can only wait on itself is a deadlock: fatal, and the handle is refused")
deadlock_on_one_thread()
    var dev = small_device()
    var fs = mounted(&dev)
    fs.plat.record_fatal = true
    var a = fs.start("a", 253)
    var b = fs.start("b", 1)
    assert_eq(fs.plat.last_fatal, 3)
    val id = must_id(fs.buffer(scratch(&fs, 0)))
    fs.plat.lock(LockId.Buffer(scratch(&fs, 0)))
    assert_eq(fails(fs.write_access(&b, id)), 2)
    fs.plat.unlock(LockId.Buffer(scratch(&fs, 0)))
    fs.stop(&b)
    fs.stop(&a)

// -- The abort ----------------------------------------------------------------------------------------

// Spoil inode 11's (lost+found's) slot on the disk, so reading it is a checksum failure.
private spoil_lost_found(dev: *RamDevice)
    var sb = super_of(dev)
    val g = geometry_of(&sb)
    val b = g.inode_table(0)
    var blk = raw(dev, b)
    val off = usize(LOST_FOUND_INO - 1) * INODE_SIZE + 8
    blk[off] = blk[off] ^ 0x40
    raw_put(dev, b, blk.view())

// Journal block 1 with its label's first byte set to `c`.
private relabel(fs: *RamFs, c: u8)
    var h = fs.start("label", 1)
    val id = must_id(fs.buffer(1))
    fs.plat.lock(LockId.Buffer(1))
    must(fs.write_access(&h, id))
    val sb: *Superblock = at(fs.bytes(id), 0)
    sb.label[0] = c
    seal_superblock(fs.bytes(id))
    fs.plat.unlock(LockId.Buffer(1))
    fs.stop(&h)
    must(fs.commit())

@test("a checksum failure aborts the journal: error recorded, read-only; the next mount sets ERROR, which replay of an older block 1 cannot clear")
abort_records_the_error()
    var dev = small_device()
    var fs = mounted(&dev)
    relabel(&fs, u8('K'))
    spoil_lost_found(&dev)
    val r = lookup(&fs, LOST_FOUND_INO, 0)
    assert_eq(fails(r), 6)
    assert(fs.aborted())
    assert(fs.read_only())
    assert_eq(fs.journal_error(), 5)
    assert_eq(journal_of(&dev).error, 5)
    // Nothing starts; a handle opened before cannot declare; nothing commits.
    assert_eq(fails(fs.try_start("x", 1)), 4)
    var late = fs.start("late", 1)
    val id = must_id(fs.buffer(scratch(&fs, 0)))
    fs.plat.lock(LockId.Buffer(scratch(&fs, 0)))
    assert_eq(fails(fs.write_access(&late, id)), 4)
    fs.plat.unlock(LockId.Buffer(scratch(&fs, 0)))
    assert_eq(fails(fs.commit()), 4)
    // No crash: unmounting writes ERROR directly.
    must(fs.unmount())
    assert(super_of(&dev).state & STATE_ERROR != 0)
    // The relabel is still only in the log; replaying its copy of block 1 drops ERROR, and the recorded
    // error puts it back.
    var again = mounted(&dev)
    val sb = super_of(&dev)
    assert(sb.state & STATE_ERROR != 0)
    assert_eq(sb.label[0], u8('K'))
    assert(again.read_only())
    assert_eq(journal_of(&dev).error, 0)
    assert_eq(journal_of(&dev).start, 0)
    assert_eq(fails(again.try_start("x", 1)), 4)
    // ERROR stays until fsck clears it.
    var third = mounted(&dev)
    assert(third.read_only())

@test("after an abort and a crash, the next mount sets ERROR, and the discarded transaction never reached home")
abort_then_crash()
    var dev = small_device()
    var fs = mounted(&dev)
    relabel(&fs, u8('Q'))
    val m = scratch(&fs, 3)
    var h = fs.start("t", 1)
    stamp(&fs, &h, m, 4)
    fs.abort(5)
    fs.stop(&h)
    assert_eq(fails(fs.commit()), 4)
    assert_eq(fails(fs.checkpoint_all()), 4)
    var again = mounted(&dev)
    val sb = super_of(&dev)
    assert(sb.state & STATE_ERROR != 0)
    assert_eq(sb.label[0], u8('Q'))
    assert(again.read_only())
    assert(!holds(&dev, m, 4))

// -- Mount and unmount (section 18) -------------------------------------------------------------------

@test("mount clears CLEAN and counts itself; unmount commits, checkpoints and sets CLEAN with exact totals")
mount_and_unmount()
    var dev = small_device()
    val before = super_of(&dev)
    assert(before.state & STATE_CLEAN != 0)
    var fs = mounted(&dev)
    val sb = super_of(&dev)
    assert_eq(sb.state & STATE_CLEAN, 0)
    assert_eq(sb.mount_count, before.mount_count + 1)
    assert(sb.mount_time > 0)
    var h = fs.start("create", 3 + C_DIR_ADD)
    val ino = alloc_inode(&fs, &h, NewInode(S_IFREG | 0o644, 0, 0, 1, ROOT_INO))
    assert(ino.is_ok())
    must(name_in_root(&fs, &h, ino.unwrap(), S_IFREG))
    fs.stop(&h)
    must(fs.unmount())
    val after = super_of(&dev)
    assert(after.state & STATE_CLEAN != 0)
    assert_eq(after.free_inodes, before.free_inodes - 1)
    assert_eq(after.free_blocks, before.free_blocks)
    assert_eq(journal_of(&dev).start, 0)
    val _ = checked_clean(&dev)

@test("read-only for an unknown ro_compat feature, ERROR or a device without flush; refused for an unknown incompat feature")
mount_refusals()
    var a = small_device()
    // Bit 0 is XATTR, which this driver knows; bit 1 is no feature yet.
    edit_super(&a, 0, 2, 0)
    var fa = mounted(&a)
    assert(fa.read_only())
    assert_eq(fails(fa.try_start("x", 1)), 4)
    // A read-only mount writes nothing, not even the mount count.
    assert_eq(super_of(&a).mount_count, 0)
    var b = small_device()
    edit_super(&b, STATE_ERROR, 0, 0)
    var fb = mounted(&b)
    assert(fb.read_only())
    var c = small_device()
    edit_super(&c, 0, 0, 1)
    val refused = mount(&c, host_platform()) match
        Err(FsError.Open(OpenError.UnknownFeatures)) -> true
        _ -> false
    assert(refused)
    var d = small_device()
    var nf = NoFlushDevice(&d)
    var fd = mounted(&nf)
    assert(fd.read_only())
