module keel.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// The checker's passes 3 and 4 (kfs/SPEC.md section 23) and its stage-8 additions to pass 1 (xattr
// blocks, a symlink's size): each invariant broken on purpose, each named by its own problem.

// Change inode `ino` behind the namespace code's back, in a transaction of its own, then settle.
private poke_inode(fs: *RamFs, ino: u64, edit: &Fn(*Inode) -> unit)
    var h = fs.start("test", C_INODE)
    must(change_inode(fs, &h, ino, edit))
    fs.stop(&h)
    must(fs.checkpoint_all())

private report(fs: *RamFs) -> Report
    must(fs.checkpoint_all())
    check(fs.dev)

@test("§23 a clean image after every namespace operation: create, each mknod, mkdir, both symlinks, link, unlink, rmdir, every rename, setattr, xattrs")
clean_after_workload()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, a, "b")
    val f = mk(&fs, a, "f")
    put_pattern(&fs, f, 0, 10000, 1)
    val r = Caller(0, 0)
    val _ = must_ino(mknod(&fs, b, "c".bytes, S_IFCHR | 0o600, DeviceNumbers(1, 3), r))
    val _ = must_ino(mknod(&fs, b, "k".bytes, S_IFBLK | 0o600, DeviceNumbers(8, 1), r))
    val _ = must_ino(mknod(&fs, b, "p".bytes, S_IFIFO | 0o600, DeviceNumbers(0, 0), r))
    val _ = must_ino(mknod(&fs, b, "s".bytes, S_IFSOCK | 0o600, DeviceNumbers(0, 0), r))
    val _ = must_ino(symlink(&fs, a, "short".bytes, "f".bytes, r))
    val _ = must_ino(symlink(&fs, a, "long".bytes, target_of(1000).view(), r))
    must(link(&fs, f, b, "f2".bytes, r))
    must(rename(&fs, a, "f".bytes, ROOT_INO, "moved".bytes, 0, r))
    must(rename(&fs, a, "b".bytes, ROOT_INO, "b".bytes, 0, r))
    val e = mkd(&fs, ROOT_INO, "e")
    must(rename(&fs, ROOT_INO, "b".bytes, a, "short".bytes, RENAME_EXCHANGE, r))
    must(setxattr(&fs, f, XATTR_USER, "x".bytes, "y".bytes, 0, 0))
    must(setattr(&fs, f, with_size_of(77), 0))
    must(unlink(&fs, b, "p".bytes))
    must(rmdir(&fs, ROOT_INO, "e".bytes))
    assert(!alive(&fs, e))
    val rep = report(&fs)
    for p in rep.problems.view()
        print("checker: " + describe(p))
    assert(rep.clean())

private with_size_of(s: u64) -> SetAttr
    var x = no_change()
    x.size = Some(s)
    x

@test("§23 pass 4: a file's links one too many, a directory's three too many — each LinkCount names the inode, the links it records and the names it has")
pass4_wrong_counts()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val f = mk(&fs, d, "f")
    poke_inode(&fs, f, (n) -> n.links = 2)
    poke_inode(&fs, d, (n) -> n.links = 5)
    val rep = report(&fs)
    assert(has_problem(rep, Problem.LinkCount(f, 2, 1)))
    assert(has_problem(rep, Problem.LinkCount(d, 5, 2)))
    assert_eq(rep.problems.len(), 2)

@test("§23 pass 4: an inode with links and no name; the root's count off by its subdirectories")
pass4_unnamed_and_root()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    val _ = must_entry(remove_name(&fs, ROOT_INO, "f".bytes))
    val rep = report(&fs)
    assert(has_problem(rep, Problem.LinkCount(f, 1, 0)))
    assert_eq(rep.problems.len(), 1)
    val _ = must_entry(lookup_name(&fs, ROOT_INO, "lost+found".bytes))
    val links = links_of(&fs, ROOT_INO)
    poke_inode(&fs, ROOT_INO, (n) -> n.links = links + 1)
    assert(has_problem(report(&fs), Problem.LinkCount(ROOT_INO, links + 1, u64(links))))

@test("§23 pass 3: a directory no name reaches is DirUnreachable (and its parent's count is off by its `..`)")
pass3_unreachable()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val _ = must_entry(remove_name(&fs, ROOT_INO, "d".bytes))
    val rep = report(&fs)
    assert(has_problem(rep, Problem.DirUnreachable(d)))
    assert(has_problem(rep, Problem.LinkCount(d, 2, 1)))
    val root = links_of(&fs, ROOT_INO)
    assert(has_problem(rep, Problem.LinkCount(ROOT_INO, root, u64(root) - 1)))

@test("§23 pass 3: a directory reached by two names is DirNamedTwice; so is the root reached by any name")
pass3_named_twice()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val d = mkd(&fs, ROOT_INO, "d")
    must(add_name(&fs, a, "again".bytes, d, DT_DIR, 0))
    val rep = report(&fs)
    assert(has_problem(rep, Problem.DirNamedTwice(d)))
    assert(!has_problem(rep, Problem.DirNamedTwice(a)))
    must(add_name(&fs, a, "root".bytes, ROOT_INO, DT_DIR, 0))
    assert(has_problem(report(&fs), Problem.DirNamedTwice(ROOT_INO)))

@test("§23 pass 3: a `parent` that is not the directory holding the name is DirParent; the root's parent not itself too")
pass3_wrong_parent()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val d = mkd(&fs, ROOT_INO, "d")
    poke_inode(&fs, d, (n) -> n.parent = a)
    val rep = report(&fs)
    assert(has_problem(rep, Problem.DirParent(d)))
    assert_eq(rep.problems.len(), 1)
    poke_inode(&fs, d, (n) -> n.parent = ROOT_INO)
    assert(report(&fs).clean())
    poke_inode(&fs, ROOT_INO, (n) -> n.parent = a)
    val r2 = report(&fs)
    assert(has_problem(r2, Problem.DirParent(ROOT_INO)))

@test("§23 pass 3: two directories naming each other and nothing reaching them is a cycle, reported once at its lowest member")
pass3_cycle()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, a, "b")
    val c = mkd(&fs, b, "c")
    // a is named by c alone: a -> b -> c -> a.
    val _ = must_entry(remove_name(&fs, ROOT_INO, "a".bytes))
    must(add_name(&fs, c, "a".bytes, a, DT_DIR, 0))
    poke_inode(&fs, a, (n) -> n.parent = c)
    val rep = report(&fs)
    assert(has_problem(rep, Problem.DirCycle(a)))
    assert(!has_problem(rep, Problem.DirCycle(b)) && !has_problem(rep, Problem.DirCycle(c)))
    assert(!has_problem(rep, Problem.DirUnreachable(a)))
    // A directory hanging below the cycle is not itself on it.
    val below = mkd(&fs, c, "below")
    assert(!has_problem(report(&fs), Problem.DirCycle(below)))

@test("§23 passes 3 and 4 judge only a complete count: a directory leaf that fails its checksum is reported and no link count is")
passes_need_complete_census()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val f = mk(&fs, d, "f")
    poke_dir(&fs, d, 0, false, (b) -> b[100] = b[100] ^ 0xFF)
    val rep = check(&dev)
    assert(has_problem(rep, Problem.DirBlock(d, 0, DirFault.Checksum)))
    assert(!has_problem(rep, Problem.LinkCount(f, 1, 0)))
    for p in rep.problems.view()
        p match
            Problem.LinkCount(_, _, _) -> panic("a link count judged over a broken directory")
            Problem.DirUnreachable(_) -> panic("connectivity judged over a broken directory")
            _ -> ()

@test("§23 pass 1: an xattr block with a bad checksum, a wrong magic or another owner is Xattr; one on a filesystem without XATTR is XattrFeature")
pass1_xattr_blocks()
    for which in 0..<4
        var dev = small_device()
        var fs = mounted(&dev)
        val f = mk(&fs, ROOT_INO, "f")
        must(setxattr(&fs, f, XATTR_USER, "a".bytes, "1".bytes, 0, 0))
        val b = node(&fs, f).xattr_block
        must(fs.unmount())
        assert(check(&dev).clean())
        var blk = raw(&dev, b)
        if which == 0 then blk[20] = blk[20] ^ 1
        if which == 1
            put_le32(blk.view(), 0, 0x1234)
            seal_block(super_of(&dev).csum_seed, blk.view())
        if which == 2
            put_le64(blk.view(), TAIL_OFFSET, f + 1)
            seal_block(super_of(&dev).csum_seed, blk.view())
        if which < 3 then raw_put(&dev, b, blk.view()) else edit_super(&dev, 0, 0, 0)
        val rep = check(&dev)
        if which < 3 then assert(has_problem(rep, Problem.Xattr(f))) else assert(has_problem(rep, Problem.XattrFeature(f)))
        assert_eq(rep.problems.len(), 1)

@test("§23 pass 1: a symlink in a block with a size the inode could hold, or past SYMLINK_MAX, is InodeSize")
pass1_symlink_size()
    var dev = small_device()
    var fs = mounted(&dev)
    val l = must_ino(symlink(&fs, ROOT_INO, "l".bytes, target_of(129).view(), Caller(0, 0)))
    assert(report(&fs).clean())
    poke_inode(&fs, l, (n) -> n.size = 128)
    assert(has_problem(report(&fs), Problem.InodeSize(l)))
    poke_inode(&fs, l, (n) -> n.size = 4096)
    assert(has_problem(report(&fs), Problem.InodeSize(l)))
    poke_inode(&fs, l, (n) -> n.size = 4095)
    assert(!has_problem(report(&fs), Problem.InodeSize(l)))
