module keel.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// readdir positions (kfs/SPEC.md section 10): `.` at 1, `..` at 2, a name at its hash halved, the end at
// 2^63 - 1; resuming from any position; a run of one position never cut; listings that stay right
// while names come and go.

private const X_RAW: u64 = 0x4000_0000_0000_0000
private const Y_RAW: u64 = 0x8000_0000_0000_0000

private fill(fs: *RamFs, d: u64, f: u64, n: u64, len: usize)
    for i in 0..<n
        add(fs, d, long_name(i, len, u8('-')).view(), f)

private all_of(fs: *RamFs, d: u64) -> Buf[Listed] = must_listing(read_dir(fs, d, 0, 1 << 22)).entries

// The listing's chain: each entry's `next` is the position of the one after it, the last's the end.
private chain_right(items: Buf[Listed], end: u64)
    for i in 0..<items.len()
        val want = if i + 1 < items.len() then items[i + 1].pos else end
        assert_eq(items[i].next, want)

@test("§10 readdir positions: `.` at 1, `..` at 2, names at their hash halved in increasing order, each d_off the next position, the end 2^63 - 1")
positions_and_offsets()
    for n in [3u64, 400]
        var dev = small_device()
        var fs = mounted(&dev)
        val f = new_file(&fs, 0)
        val d = new_dir(&fs)
        fill(&fs, d, f, n, 40)
        assert_eq(indexed(&fs, d), n > 3)
        val l = must_listing(read_dir(&fs, d, 0, 1 << 22))
        val items = l.entries
        assert(l.next == DIR_POS_END && items.len() == usize(n) + 2)
        assert(same(items[0].name.view(), ".".bytes) && items[0].pos == DIR_POS_DOT && items[0].ino == d)
        assert(same(items[1].name.view(), "..".bytes) && items[1].pos == DIR_POS_DOTDOT && items[1].ino == ROOT_INO)
        for i in 2..<items.len()
            assert_eq(items[i].pos, hash_of(&fs, items[i].name.view()) >> 1)
            assert(items[i].pos >= DIR_POS_FIRST && items[i].pos < DIR_POS_END)
            assert(items[i].pos > items[i - 1].pos)
            assert(items[i].ino == f && items[i].file_type == DT_REG)
        chain_right(items, DIR_POS_END)

@test("§10 an empty directory lists `.` then `..`, whose d_off is the end")
empty_listing()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = new_dir(&fs)
    val l = must_listing(read_dir(&fs, d, 0, 4096))
    assert(l.entries.len() == 2 && l.next == DIR_POS_END)
    assert(l.entries[0].next == DIR_POS_DOTDOT && l.entries[1].next == DIR_POS_END)

@test("§10 resuming at every position: from each entry's position the rest of the listing exactly; between positions the next one on; 0, 3 and the end")
resume_everywhere()
    var dev = small_device()
    var fs = mounted(&dev)
    fs.index_max = 3
    val f = new_file(&fs, 0)
    val d = new_dir(&fs)
    fill(&fs, d, f, 300, 60)
    val all = all_of(&fs, d)
    for i in 0..<all.len()
        val l = must_listing(read_dir(&fs, d, all[i].pos, 1 << 22))
        assert_eq(l.entries.len(), all.len() - i)
        for k in 0..<l.entries.len()
            assert(same(l.entries[k].name.view(), all[i + k].name.view()))
        // One past the position starts at the next entry.
        if i + 1 < all.len() && all[i].pos + 1 < all[i + 1].pos
            assert(same(must_listing(read_dir(&fs, d, all[i].pos + 1, 1 << 22)).entries[0].name.view(), all[i + 1].name.view()))
    // Position 0 is the start; 3 is past `..` and before every name.
    assert_eq(must_listing(read_dir(&fs, d, 0, 1 << 22)).entries.len(), all.len())
    val from3 = must_listing(read_dir(&fs, d, 3, 1 << 22))
    assert(from3.entries.len() == all.len() - 2 && same(from3.entries[0].name.view(), all[2].name.view()))
    for p in [DIR_POS_END, DIR_POS_END + 1, 0xFFFF_FFFF_FFFF_FFFF]
        val l = must_listing(read_dir(&fs, d, p, 1 << 22))
        assert(l.entries.len() == 0 && l.next == DIR_POS_END)

@test("§10 a call answers whole entries up to its room; one too small for the first entry is EINVAL")
room_limits()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = new_file(&fs, 0)
    val d = new_dir(&fs)
    val longest = long_name(1, 255, u8('z'))
    add(&fs, d, longest.view(), f)
    assert(dirent_size(1) == 24 && dirent_size(2) == 24 && dirent_size(4) == 24 && dirent_size(5) == 32 && dirent_size(255) == 280)
    assert_eq(fails_dir(read_dir(&fs, d, 0, 23)), 3)
    val one = must_listing(read_dir(&fs, d, 0, 24))
    assert(one.entries.len() == 1 && one.next == DIR_POS_DOTDOT)
    val two = must_listing(read_dir(&fs, d, 0, 48))
    assert(two.entries.len() == 2 && two.next == hash_of(&fs, longest.view()) >> 1)
    val p = two.next
    assert_eq(fails_dir(read_dir(&fs, d, p, 279)), 3)
    val last = must_listing(read_dir(&fs, d, p, 280))
    assert(last.entries.len() == 1 && last.next == DIR_POS_END && last.entries[0].next == DIR_POS_END)
    // Scanning one entry per call returns every name once.
    val all = scan_all(&fs, d, 280)
    assert(all.len() == 3 && times_listed(all, longest.view()) == 1)

@test("§10 colliding names: a run is answered whole or not at all, a resume inside it answers all of it, a run too big for the room is EINVAL")
runs_in_listings()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = new_file(&fs, 0)
    val d = new_dir(&fs)
    force_raw_hashes([X_RAW, Y_RAW])
    for i in 0..<5
        add(&fs, d, name_of("x", u64(i), 0, u8('b')).view(), f)
        add(&fs, d, name_of("y", u64(i), 0, u8('a')).view(), f)
    val e = dirent_size(3)
    // Room for five: `.` and `..`, then X's run of five does not fit beside them.
    val a = must_listing(read_dir(&fs, d, 0, 5 * e))
    assert(a.entries.len() == 2 && a.next == X_RAW >> 1 && a.entries[1].next == X_RAW >> 1)
    val b = must_listing(read_dir(&fs, d, a.next, 5 * e))
    assert(b.entries.len() == 5 && b.next == Y_RAW >> 1)
    for x in b.entries.view()
        assert(x.pos == X_RAW >> 1)
    // Every name of a run but the last has the run's own position as d_off.
    for k in 0..<b.entries.len() - 1
        assert_eq(b.entries[k].next, X_RAW >> 1)
    assert_eq(b.entries[4].next, Y_RAW >> 1)
    // Resumed at the same position again — as after a call that stopped there — the whole run again.
    assert_eq(must_listing(read_dir(&fs, d, X_RAW >> 1, 5 * e)).entries.len(), 5)
    val c = must_listing(read_dir(&fs, d, b.next, 5 * e))
    assert(c.entries.len() == 5 && c.next == DIR_POS_END)
    // Four entries of room cannot hold a run of five.
    assert_eq(fails_dir(read_dir(&fs, d, X_RAW >> 1, 4 * e)), 3)
    clear_raw_hash()

@test("§10 a run spanning three leaves is one position: listed whole in one call, refused in a call too small for it")
run_across_leaves_listed()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = new_file(&fs, 0)
    val d = new_dir(&fs)
    force_raw_hash(X_RAW)
    for i in 0..<30
        add(&fs, d, long_name(u64(i), 255, u8('b')).view(), f)
    assert_eq(shape(&fs, d).keys.len(), 3)
    val l = must_listing(read_dir(&fs, d, 3, 30 * 280))
    assert(l.entries.len() == 30 && l.next == DIR_POS_END)
    assert_eq(fails_dir(read_dir(&fs, d, 3, 29 * 280)), 3)
    clear_raw_hash()

@test("§10 readdir while names come and go: one entry per call, inserts and removals between calls; every untouched name exactly once, nothing twice")
listing_while_changing()
    for seed in [1u64, 7, 23]
        var dev = small_device()
        var fs = mounted(&dev)
        fs.index_max = 4
        val f = new_file(&fs, 0)
        val d = new_dir(&fs)
        for i in 0..<150
            add(&fs, d, name_of("keep", u64(i), 30, u8('.')).view(), f)
            add(&fs, d, name_of("churn", u64(i), 30, u8('.')).view(), f)
        var rng = seed
        var next_new: u64 = 0
        var churned: u64 = 0
        var out: Buf[Listed] = buf()
        var pos: u64 = 0
        loop
            val l = must_listing(read_dir(&fs, d, pos, dirent_size(48)))
            out.extend(l.entries.view())
            if l.next == DIR_POS_END then break
            pos = l.next
            // Between calls: a few new names, and a few of the churn names out.
            for _ in 0..<3
                rng = rng * 6364136223846793005 + 1442695040888963407
                if (rng >> 33) % 2 == 0
                    add(&fs, d, name_of("new", next_new, 30, u8('.')).view(), f)
                    next_new += 1
                else if churned < 150
                    take_out(&fs, d, name_of("churn", churned, 30, u8('.')).view())
                    churned += 1
        for i in 0..<150
            assert_eq(times_listed(out, name_of("keep", u64(i), 30, u8('.')).view()), 1)
        for x in out.view()
            assert(times_listed(out, x.name.view()) == 1)
        assert(next_new > 20 && churned > 20)
        val _ = dir_clean(&fs)
