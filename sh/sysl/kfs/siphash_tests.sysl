module sh.sysl.kfs
@tests
@requires(heap)

// SipHash vectors: key 00 01 .. 0f, message 00 01 .. (n - 1), the output's eight bytes little-endian.
// SipHash-1-3 is checked against the 64 vectors of Rust's core library test suite (the parameterisation
// KFS uses); SipHash-2-4 against the first 16 vectors of the reference implementation (veorq/SipHash
// vectors.h, the same bytes) and the paper's worked example. Both run the one `siphash` function, so
// the 2-4 vectors (published by the algorithm's authors) verify the code the 1-3 vectors exercise.

import sysl.buf.{Buf, buf}

private val K0: u64 = 0x0706_0504_0302_0100
private val K1: u64 = 0x0F0E_0D0C_0B0A_0908

