]

private word(v: [8]u8) -> u64
    var w: u64 = 0
    for j in 0..<8
        w |= u64(v[j]) << u64(8 * j)
    w

@test("SipHash-1-3 matches all 64 reference vectors, messages of 0 to 63 bytes")
siphash13_vectors()
    val msg = counting(64)
    for n in 0..<64
        assert_eq(siphash13(K0, K1, msg.view()[0..<n]), word(SIP13[n]))

@test("SipHash-2-4 matches the reference vectors, messages of 0 to 15 bytes")
siphash24_vectors()
    val msg = counting(16)
    for n in 0..<16
        assert_eq(siphash24(K0, K1, msg.view()[0..<n]), word(SIP24[n]))

@test("SipHash-2-4 of the paper's 15-byte example is 0xa129ca6149be45e5")
siphash24_paper_example()
    val msg = counting(15)
    assert_eq(siphash24(K0, K1, msg.view()), 0xa129ca6149be45e5)

@test("the two parameterisations differ, and the key matters")
siphash_parameters_and_key()
    val msg = counting(9)
    assert(siphash13(K0, K1, msg.view()) != siphash24(K0, K1, msg.view()))
    assert(siphash13(K0 ^ 1, K1, msg.view()) != siphash13(K0, K1, msg.view()))
    assert(siphash13(K0, K1 ^ 1, msg.view()) != siphash13(K0, K1, msg.view()))
    assert(siphash13(K0, K1, msg.view()[0..<8]) != siphash13(K0, K1, msg.view()[0..<9]))
