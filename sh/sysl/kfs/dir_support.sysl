module keel.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// Helpers the directory tests share.

// A new empty directory, a child of the root; the root's own name for it is stage 8's.
new_dir[D: BlockDevice](fs: *Fs[D, HostPlatform]) -> u64 = new_inode(fs, S_IFDIR | 0o755, 0)

// Name `i` of a family: `prefix`, then `i` in decimal, then `pad` bytes of 'x', then `tail` as its last
// byte (the forced-hash hook picks a value by the last byte).
name_of(prefix: string, i: u64, pad: usize, tail: u8) -> Buf[u8]
    var out: Buf[u8] = buf()
    for b in prefix.bytes
        out.push(b)
    var digits: Buf[u8] = buf()
    var v = i
    loop
        digits.push(u8('0') + u8(v % 10))
        v = v / 10
        if v == 0 then break
    var k = digits.len()
    while k > 0
        k -= 1
        out.push(digits[k])
    for _ in 0..<pad
        out.push(u8('x'))
    out.push(tail)
    out

// A name of `len` bytes, all `fill` but the last, which is `tail`, after `i` in decimal.
long_name(i: u64, len: usize, tail: u8) -> Buf[u8]
    val head = name_of("n", i, 0, u8('-'))
    var out: Buf[u8] = buf()
    out.extend(head.view())
    while out.len() + 1 < len
        out.push(u8('y'))
    out.push(tail)
    out

must_entry(r: Result[DirEntry, FsError]) -> DirEntry
    r match
        Ok(e) -> e
        Err(_) -> panic("a directory call failed")

must_listing(r: Result[Listing, FsError]) -> Listing
    r match
        Ok(l) -> l
        Err(_) -> panic("a read_dir failed")

// Add `name` -> `ino` as a regular file, as uid 0; must succeed.
add[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64, name: []const u8, ino: u64)
    must(add_name(fs, dir, name, ino, DT_REG, 0))

// Remove `name`; must succeed.
take_out[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64, name: []const u8)
    val _ = must_entry(remove_name(fs, dir, name))

// Whether `name` is found.
has[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64, name: []const u8) -> bool
    lookup_name(fs, dir, name) match
        Ok(_) -> true
        Err(FsError.NotFound) -> false
        Err(_) -> panic("a lookup failed")

// Every name a whole scan returns, `.` and `..` included, with calls of `room` bytes.
scan_all[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64, room: usize) -> Buf[Listed]
    var out: Buf[Listed] = buf()
    var pos: u64 = 0
    var calls: u32 = 0
    loop
        val l = must_listing(read_dir(fs, dir, pos, room))
        out.extend(l.entries.view())
        calls += 1
        assert(calls < 100_000)
        if l.next == DIR_POS_END then return out
        assert(l.entries.len() > 0)
        pos = l.next

// The inode's fields.
dir_inode[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64) -> Inode = must_inode(stat(fs, dir))

indexed[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64) -> bool = dir_inode(fs, dir).flags & INODE_INDEXED != 0

// The physical block a directory maps at `l`, 0 for a hole.
dir_phys[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64, l: u64) -> u64
    lookup(fs, dir, l) match
        Ok(Mapping.Mapped(b, _, _)) -> b
        Ok(Mapping.Hole) -> 0
        Err(_) -> panic("an extent lookup failed")

// A copy of the directory's block `l` as the cache has it now.
dir_bytes[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64, l: u64) -> Buf[u8]
    val b = dir_phys(fs, dir, l)
    assert(b != 0)
    copy_of(fs.bytes(must_id(fs.buffer(b))))

// Change the directory's block `l` in the cache and on the device, resealed with `seed` unless
// `reseal` is false — a test's corruption, behind the journal's back. The filesystem is checkpointed
// first so nothing writes the block again.
poke_dir[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64, l: u64, reseal: bool, edit: &Fn([]u8) -> unit)
    must(fs.checkpoint_all())
    val b = dir_phys(fs, dir, l)
    val id = must_id(fs.buffer(b))
    val bytes = fs.bytes(id)
    edit(bytes)
    if reseal then seal_block(fs.seed, bytes)
    raw_put(fs.dev, b, bytes)

// The index as it stands: how many levels (0 for a linear or empty directory), the index blocks, and
// the leaves in key order with their keys.
struct Shape
    levels: u32
    index_blocks: u32
    keys: Buf[u64]
    leaves: Buf[u64]
    root_count: usize

shape[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64) -> Shape
    var s = Shape(0, 0, buf(), buf(), 0)
    val node = dir_inode(fs, dir)
    if node.size == 0 then return s
    if node.flags & INODE_INDEXED == 0
        s.keys.push(0)
        s.leaves.push(0)
        return s
    walk_shape(fs, dir, 0, &s)
    s

private walk_shape[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64, l: u64, s: *Shape)
    val bytes = dir_bytes(fs, dir, l)
    val ib = index_block(bytes.view()) match
        Ok(x) -> x
        Err(_) -> panic("an index block failed its checks")
    s.index_blocks += 1
    if l == 0
        s.levels = u32(ib.level) + 1
        s.root_count = ib.entries.len()
    for e in ib.entries.view()
        if ib.level == 0
            s.keys.push(e.key)
            s.leaves.push(u64(e.child))
        else
            walk_shape(fs, dir, u64(e.child), s)

// The names of the leaf at `l`, as its records lie.
leaf_names_at[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64, l: u64) -> Buf[Buf[u8]]
    val bytes = dir_bytes(fs, dir, l)
    var out: Buf[Buf[u8]] = buf()
    val recs = leaf_records(bytes.view()) match
        Ok(r) -> r
        Err(_) -> panic("a leaf failed its checks")
    for r in recs.view()
        if r.ino != 0 then out.push(copy_of(rec_name(bytes.view(), r)))
    out

// The leaf's live bytes.
leaf_live_at[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64, l: u64) -> usize
    val bytes = dir_bytes(fs, dir, l)
    val recs = leaf_records(bytes.view()) match
        Ok(r) -> r
        Err(_) -> panic("a leaf failed its checks")
    live_bytes(recs)

// Whether `names` holds `name`.
holds_name(names: Buf[Buf[u8]], name: []const u8) -> bool
    for n in names.view()
        if same(n.view(), name) then return true
    false

// How many times the listing holds `name`.
times_listed(all: Buf[Listed], name: []const u8) -> u32
    var n: u32 = 0
    for x in all.view()
        if same(x.name.view(), name) then n += 1
    n

// A name's hash on this filesystem (the forced-hash hook included).
hash_of[D: BlockDevice](fs: *Fs[D, HostPlatform], name: []const u8) -> u64 = dir_hash(fs.sb.hash_seed[0..<16], name)

// The hashes of the names in the leaf at `l`.
leaf_hashes[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64, l: u64) -> Buf[u64]
    var out: Buf[u64] = buf()
    for n in leaf_names_at(fs, dir, l).view()
        out.push(hash_of(fs, n.view()))
    out

private max_of(xs: Buf[u64]) -> u64
    var m: u64 = 0
    for x in xs.view()
        if x > m then m = x
    m

private min_of(xs: Buf[u64]) -> u64
    var m: u64 = 0xFFFF_FFFF_FFFF_FFFF
    for x in xs.view()
        if x < m then m = x
    m

// The continuation mark exactly where a run is split, as inserts leave it: for each pair of neighbouring
// leaves, when the left's greatest hash is the right's least (a run split across them) the right's key
// is that hash with the mark; otherwise the right's key is unmarked, above the left's greatest hash and
// at most the right's least. Answers how many marked keys there are, or panics naming the leaf.
marks_exact[D: BlockDevice](fs: *Fs[D, HostPlatform], dir: u64) -> u32
    val s = shape(fs, dir)
    var marked: u32 = 0
    var left = leaf_hashes(fs, dir, s.leaves[0])
    for i in 1..<s.leaves.len()
        val right = leaf_hashes(fs, dir, s.leaves[i])
        val m = max_of(left)
        val n = min_of(right)
        val k = s.keys[i]
        if m == n
            if k != m | 1 then panic(s"leaf ${s.leaves[i]}: a run is split and its key has no mark")
            marked += 1
        else if k & 1 == 1 || !(m < k && k <= n)
            panic(s"leaf ${s.leaves[i]}: a key that is not a run split and is not between its neighbours")
        left = right
    marked

// The checker over the device after a checkpoint, which must find nothing.
dir_clean[D: BlockDevice](fs: *Fs[D, HostPlatform]) -> Report
    must(fs.checkpoint_all())
    checked_clean(fs.dev)
