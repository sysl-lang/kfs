module sh.sysl.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// Helpers the tests of files, the orphan list and the inode layer share.

// A regular file of mode `0o644` (or `mode`), owned by `uid`, named `i<ino>` in the root (`ino_name`).
new_file[D: BlockDevice](fs: *Fs[D, HostPlatform], uid: u32) -> u64 = new_inode(fs, S_IFREG | 0o644, uid)

// A new inode of `mode` owned by `uid`, made as section 18's create makes one, in one transaction: placed
// as a child of the root, named `i<ino>` there, one link — a directory two, and one more for the root.
// The name follows the number, which the allocator chooses, so this is create with the name picked
// inside the handle.
new_inode[D: BlockDevice](fs: *Fs[D, HostPlatform], mode: u16, uid: u32) -> u64
    val is_dir = mode & S_IFMT == S_IFDIR
    fs.plat.lock(LockId.Dir(ROOT_INO))
    var h = fs.start("create", C_CREATE)
    val r = alloc_inode(fs, &h, NewInode(mode, uid, uid, if is_dir then 2 else 1, ROOT_INO))
    val ino = r match
        Ok(i) -> i
        Err(_) -> panic("an inode allocation failed")
    must(dir_add(fs, &h, ROOT_INO, ino_name(ino).view(), ino, dt_of_mode(mode), 0))
    if is_dir then must(change_inode(fs, &h, ROOT_INO, (n) -> n.links += 1))
    fs.stop(&h)
    fs.plat.unlock(LockId.Dir(ROOT_INO))
    ino

// The directory's half of a create, for a test that makes a non-directory inode by hand: `i<ino>` in the
// root, in `h` (C_DIR_ADD credits).
name_in_root[D: BlockDevice](fs: *Fs[D, HostPlatform], h: *Handle, ino: u64, mode: u16) -> Result[unit, FsError]
    dir_add(fs, h, ROOT_INO, ino_name(ino).view(), ino, dt_of_mode(mode), 0)

// The root's name for an inode `new_inode` made: `i` and its number.
ino_name(ino: u64) -> Buf[u8]
    var digits: Buf[u8] = buf()
    var v = ino
    loop
        digits.push(u8('0') + u8(v % 10))
        v = v / 10
        if v == 0 then break
    var out: Buf[u8] = buf()
    out.push(u8('i'))
    var k = digits.len()
    while k > 0
        k -= 1
        out.push(digits[k])
    out

// Unlink the root's name for an inode `new_inode` made.
unlink_ino[D: BlockDevice](fs: *Fs[D, HostPlatform], ino: u64) -> Result[unit, FsError] = unlink(fs, ROOT_INO, ino_name(ino).view())

// The caller every test of a namespace operation is, unless it says otherwise: root.
root_caller() -> Caller = Caller(0, 0)

// How a call failed, as a number: 0 for success; NoSpace 1, Bug 2, Invalid 3, ReadOnly 4, Device 5,
// Corrupt 6, TooBig 7.
code[T](r: Result[T, FsError]) -> i64
    r match
        Ok(_) -> 0
        Err(FsError.NoSpace) -> 1
        Err(FsError.Bug) -> 2
        Err(FsError.Invalid) -> 3
        Err(FsError.ReadOnly) -> 4
        Err(FsError.Device(_)) -> 5
        Err(FsError.Corrupt(_)) -> 6
        Err(FsError.TooBig) -> 7
        Err(_) -> 9

must_n(r: Result[usize, FsError]) -> usize
    r match
        Ok(n) -> n
        Err(_) -> panic(s"a file operation failed: ${code(r)}")

must_inode(r: Result[Inode, FsError]) -> Inode
    r match
        Ok(n) -> n
        Err(_) -> panic(s"an inode could not be read: ${code(r)}")

// `n` bytes that are never zero and differ with `salt`, so a block of them is told from a block of zeros
// and from another write's.
pattern(n: usize, salt: u32) -> Buf[u8]
    var out: Buf[u8] = buf()
    for i in 0..<n
        out.push(u8((u32(i) * 31 + salt * 7) % 251 + 1))
    out

zeros(n: usize) -> Buf[u8]
    var out: Buf[u8] = buf()
    for _ in 0..<n
        out.push(0)
    out

// Write `n` bytes of `pattern(n, salt)` at `offset`, all of them.
put_pattern[D: BlockDevice](fs: *Fs[D, HostPlatform], ino: u64, offset: u64, n: usize, salt: u32)
    val data = pattern(n, salt)
    assert(must_n(write(fs, ino, offset, data.view(), 0)) == n)

// Read `n` bytes at `offset`: the bytes read, as many as the file gave.
got[D: BlockDevice](fs: *Fs[D, HostPlatform], ino: u64, offset: u64, n: usize) -> Buf[u8]
    var out = zeros(n)
    val k = must_n(read(fs, ino, offset, out.view()))
    out.truncate(k)
    out

size_of[D: BlockDevice](fs: *Fs[D, HostPlatform], ino: u64) -> u64 = must_inode(stat(fs, ino)).size

blocks_of[D: BlockDevice](fs: *Fs[D, HostPlatform], ino: u64) -> u64 = must_inode(stat(fs, ino)).blocks

// Logical block `l` of `ino`: 0 for a hole, the physical block otherwise (unwritten or not).
phys_at[D: BlockDevice](fs: *Fs[D, HostPlatform], ino: u64, l: u64) -> u64
    lookup(fs, ino, l) match
        Ok(Mapping.Mapped(b, _, _)) -> b
        Ok(Mapping.Hole) -> 0
        Err(_) -> panic("a lookup failed")

unwritten_at[D: BlockDevice](fs: *Fs[D, HostPlatform], ino: u64, l: u64) -> bool
    lookup(fs, ino, l) match
        Ok(Mapping.Mapped(_, _, u)) -> u
        _ -> false

// Commit and checkpoint everything, then run the checker over the device: it must be clean.
settled_clean[D: BlockDevice](fs: *Fs[D, HostPlatform]) -> Report
    must(fs.checkpoint_all())
    checked_clean(fs.dev)

// Whether the checker reported `want`.
has_problem(rep: Report, want: Problem) -> bool
    for p in rep.problems.view()
        if describe(p) == describe(want) then return true
    false

// The free block total in the superblock's sense: what the allocator may hand out.
free_total[D: BlockDevice](fs: *Fs[D, HostPlatform]) -> u64 = fs.free_blocks_total.load()

// Bytes equal to `want`.
bytes_equal(a: Buf[u8], want: Buf[u8]) -> bool = same(a.view(), want.view())

zeroed(a: []const u8) -> bool
    for x in a
        if x != 0 then return false
    true
