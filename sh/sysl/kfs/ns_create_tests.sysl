module sh.sysl.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// Making an inode with a name (kfs/SPEC.md sections 11, 12 and 18): create, mknod of every type, mkdir,
// symlink inline and in a block, readlink; every refusal, and that a refusal changes nothing.

@test("§18 create: a regular file of the caller's owner and mode, one link, its name typed DT_REG, the parent's times moved")
create_basics()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val before = node(&fs, d)
    fs.plat.clock += 100
    val f = must_ino(create(&fs, d, "f".bytes, 0o640, Caller(1000, 100)))
    val n = node(&fs, f)
    assert_eq(n.mode, S_IFREG | 0o640)
    assert(n.uid == 1000 && n.gid == 100 && n.links == 1 && n.size == 0 && n.blocks == 0 && n.parent == 0)
    assert(n.crtime_sec == n.ctime_sec && n.mtime_sec == n.ctime_sec && n.atime_sec == n.ctime_sec)
    val e = must_entry(lookup_name(&fs, d, "f".bytes))
    assert(e.ino == f && e.file_type == DT_REG)
    val after = node(&fs, d)
    assert(after.mtime_sec >= before.mtime_sec + 100 && after.ctime_sec == after.mtime_sec)
    // A file is no link of its parent's.
    assert_eq(after.links, before.links)
    settled_clean(&fs)

@test("§18 create refuses: an existing name, `.` and `..` (EEXIST); 256 bytes (ENAMETOOLONG); empty, `/`, NUL (EINVAL); a file as parent (ENOTDIR); type bits in the mode (EINVAL) — and changes nothing")
create_refusals()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val f = mk(&fs, d, "f")
    must(fs.commit())
    val inodes = fs.free_inodes_total.load()
    val handles = fs.handles_opened()
    val r = Caller(0, 0)
    assert_eq(err(create(&fs, d, "f".bytes, 0o644, r)), EEXIST)
    assert_eq(err(create(&fs, d, ".".bytes, 0o644, r)), EEXIST)
    assert_eq(err(create(&fs, d, "..".bytes, 0o644, r)), EEXIST)
    assert_eq(err(create(&fs, d, long_name(1, 256, u8('x')).view(), 0o644, r)), ENAMETOOLONG)
    assert_eq(err(create(&fs, d, "".bytes, 0o644, r)), EINVAL)
    assert_eq(err(create(&fs, d, "a/b".bytes, 0o644, r)), EINVAL)
    val nul: [3]u8 = [97, 0, 98]
    assert_eq(err(create(&fs, d, nul[0..<3], 0o644, r)), EINVAL)
    assert_eq(err(create(&fs, f, "x".bytes, 0o644, r)), ENOTDIR)
    assert_eq(err(create(&fs, d, "g".bytes, S_IFREG | 0o644, r)), EINVAL)
    assert_eq(err(mkdir(&fs, d, "g".bytes, 0o10000, r)), EINVAL)
    assert_eq(fs.free_inodes_total.load(), inodes)
    assert_eq(fs.handles_opened(), handles)
    assert_eq(named(&fs, d, "g"), 0)
    settled_clean(&fs)

@test("§10/§18 names of 1 and 255 bytes are created and found; the 255-byte one survives a remount")
create_name_limits()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mk(&fs, ROOT_INO, "a")
    val long = long_name(7, 255, u8('z'))
    val b = must_ino(create(&fs, ROOT_INO, long.view(), 0o600, Caller(0, 0)))
    must(fs.unmount())
    var again = mounted(&dev)
    assert_eq(named(&again, ROOT_INO, "a"), a)
    assert_eq(must_entry(lookup_name(&again, ROOT_INO, long.view())).ino, b)
    settled_clean(&again)

@test("§12 mknod of each type: a character and a block device keep their numbers, a FIFO, a socket and a regular file; size and blocks 0; the names typed")
mknod_types()
    var dev = small_device()
    var fs = mounted(&dev)
    val r = Caller(0, 0)
    val c = must_ino(mknod(&fs, ROOT_INO, "null".bytes, S_IFCHR | 0o666, DeviceNumbers(1, 3), r))
    val b = must_ino(mknod(&fs, ROOT_INO, "sda".bytes, S_IFBLK | 0o660, DeviceNumbers(8, 0), r))
    val p = must_ino(mknod(&fs, ROOT_INO, "fifo".bytes, S_IFIFO | 0o644, DeviceNumbers(0, 0), r))
    val s = must_ino(mknod(&fs, ROOT_INO, "sock".bytes, S_IFSOCK | 0o755, DeviceNumbers(0, 0), r))
    val g = must_ino(mknod(&fs, ROOT_INO, "plain".bytes, S_IFREG | 0o600, DeviceNumbers(0, 0), r))
    assert_eq(node(&fs, c).mode, S_IFCHR | 0o666)
    assert_eq(node(&fs, b).mode, S_IFBLK | 0o660)
    assert_eq(node(&fs, p).mode, S_IFIFO | 0o644)
    assert_eq(node(&fs, s).mode, S_IFSOCK | 0o755)
    assert_eq(node(&fs, g).mode, S_IFREG | 0o600)
    assert_eq(must_entry(lookup_name(&fs, ROOT_INO, "null".bytes)).file_type, DT_CHR)
    assert_eq(must_entry(lookup_name(&fs, ROOT_INO, "sda".bytes)).file_type, DT_BLK)
    assert_eq(must_entry(lookup_name(&fs, ROOT_INO, "fifo".bytes)).file_type, DT_FIFO)
    assert_eq(must_entry(lookup_name(&fs, ROOT_INO, "sock".bytes)).file_type, DT_SOCK)
    assert_eq(must_entry(lookup_name(&fs, ROOT_INO, "plain".bytes)).file_type, DT_REG)
    for x in [c, b, p, s, g]
        assert(node(&fs, x).size == 0 && node(&fs, x).blocks == 0 && node(&fs, x).links == 1)
    assert(device_numbers(node(&fs, c)).major == 1 && device_numbers(node(&fs, c)).minor == 3)
    assert(device_numbers(node(&fs, b)).major == 8 && device_numbers(node(&fs, b)).minor == 0)
    // A FIFO's and a socket's data is zero (section 8).
    for k in 0..<128
        assert(node(&fs, p).data[k] == 0 && node(&fs, s).data[k] == 0)
    must(fs.unmount())
    var again = mounted(&dev)
    assert(device_numbers(node(&again, c)).major == 1 && device_numbers(node(&again, c)).minor == 3)
    settled_clean(&again)

@test("§12 st_rdev in Linux's encoding: (1, 3) is 0x103, (5, 1) 0x501, and numbers past 8 and 12 bits split; 0 for anything but a device")
rdev_encoding()
    var dev = small_device()
    var fs = mounted(&dev)
    val r = Caller(0, 0)
    val a = must_ino(mknod(&fs, ROOT_INO, "a".bytes, S_IFCHR | 0o600, DeviceNumbers(1, 3), r))
    val b = must_ino(mknod(&fs, ROOT_INO, "b".bytes, S_IFCHR | 0o600, DeviceNumbers(5, 1), r))
    val c = must_ino(mknod(&fs, ROOT_INO, "c".bytes, S_IFBLK | 0o600, DeviceNumbers(0x1234_5678, 0x9ABC_DEF0), r))
    val p = must_ino(mknod(&fs, ROOT_INO, "p".bytes, S_IFIFO | 0o600, DeviceNumbers(7, 7), r))
    assert_eq(rdev(node(&fs, a)), 0x103)
    assert_eq(rdev(node(&fs, b)), 0x501)
    // (minor & 0xff) | ((major & 0xfff) << 8) | ((minor & ~0xff) << 12) | ((major & ~0xfff) << 32)
    val want: u64 = 0xF0 | (0x678 << 8) | (0x9ABC_DE00 << 12) | (0x1234_5000 << 32)
    assert_eq(rdev(node(&fs, c)), want)
    assert(device_numbers(node(&fs, c)).major == 0x1234_5678 && device_numbers(node(&fs, c)).minor == 0x9ABC_DEF0)
    // A FIFO stores no numbers, whatever it was given.
    assert_eq(rdev(node(&fs, p)), 0)
    assert_eq(device_numbers(node(&fs, p)).major, 0)
    settled_clean(&fs)

@test("§12 mknod refuses: a device by anyone but uid 0 (EPERM), a directory (EPERM), a symlink or no type (EINVAL); a FIFO by uid 1000 is fine")
mknod_refusals()
    var dev = small_device()
    var fs = mounted(&dev)
    val u = Caller(1000, 1000)
    val inodes = fs.free_inodes_total.load()
    assert_eq(err(mknod(&fs, ROOT_INO, "c".bytes, S_IFCHR | 0o600, DeviceNumbers(1, 3), u)), EPERM)
    assert_eq(err(mknod(&fs, ROOT_INO, "b".bytes, S_IFBLK | 0o600, DeviceNumbers(8, 0), u)), EPERM)
    assert_eq(err(mknod(&fs, ROOT_INO, "d".bytes, S_IFDIR | 0o755, DeviceNumbers(0, 0), Caller(0, 0))), EPERM)
    assert_eq(err(mknod(&fs, ROOT_INO, "l".bytes, S_IFLNK | 0o777, DeviceNumbers(0, 0), Caller(0, 0))), EINVAL)
    assert_eq(err(mknod(&fs, ROOT_INO, "z".bytes, 0o644, DeviceNumbers(0, 0), Caller(0, 0))), EINVAL)
    assert_eq(fs.free_inodes_total.load(), inodes)
    val p = must_ino(mknod(&fs, ROOT_INO, "p".bytes, S_IFIFO | 0o600, DeviceNumbers(0, 0), u))
    assert_eq(node(&fs, p).uid, 1000)
    settled_clean(&fs)

@test("§18 mkdir: links 2, the parent's + 1, `parent` set, no blocks, `..` the parent, the group's directories + 1")
mkdir_basics()
    var dev = small_device()
    var fs = mounted(&dev)
    val root_links = links_of(&fs, ROOT_INO)
    val dirs = directories(&fs)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, a, "b")
    assert_eq(links_of(&fs, ROOT_INO), root_links + 1)
    assert_eq(links_of(&fs, a), 3)
    assert_eq(links_of(&fs, b), 2)
    assert(node(&fs, a).parent == ROOT_INO && node(&fs, b).parent == a)
    assert(node(&fs, b).size == 0 && node(&fs, b).blocks == 0 && node(&fs, b).mode == S_IFDIR | 0o755)
    assert_eq(must_entry(lookup_name(&fs, b, "..".bytes)).ino, a)
    assert_eq(must_entry(lookup_name(&fs, ROOT_INO, "a".bytes)).file_type, DT_DIR)
    assert_eq(directories(&fs), dirs + 2)
    settled_clean(&fs)

@test("§18 mkdir under a parent one below LINK_MAX takes it to LINK_MAX; at LINK_MAX it is EMLINK and changes nothing")
mkdir_link_max()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    set_links(&fs, a, LINK_MAX - 1)
    val _ = mkd(&fs, a, "one")
    assert_eq(links_of(&fs, a), LINK_MAX)
    val inodes = fs.free_inodes_total.load()
    assert_eq(err(mkdir(&fs, a, "two".bytes, 0o755, Caller(0, 0))), EMLINK)
    assert_eq(links_of(&fs, a), LINK_MAX)
    assert_eq(fs.free_inodes_total.load(), inodes)
    assert_eq(named(&fs, a, "two"), 0)
    // A file needs no link of its parent: it goes in.
    val _ = mk(&fs, a, "file")

@test("§11 symlink targets of 1 and 128 bytes live in the inode (INLINE, no blocks); 129 and 4095 bytes in one block; readlink answers each exactly, before and after a remount")
symlink_lengths()
    var dev = small_device()
    var fs = mounted(&dev)
    val lens: [4]usize = [1, 128, 129, 4095]
    var inos: Buf[u64] = buf()
    for i in 0..<4
        val t = target_of(lens[i])
        val ino = must_ino(symlink(&fs, ROOT_INO, name_of("l", u64(i), 0, u8('.')).view(), t.view(), Caller(5, 6)))
        inos.push(ino)
        val n = node(&fs, ino)
        assert(n.mode == S_IFLNK | 0o777 && n.size == u64(lens[i]) && n.uid == 5 && n.gid == 6)
        if lens[i] <= SYMLINK_INLINE_MAX
            assert(n.flags & INODE_INLINE != 0 && n.blocks == 0)
        else
            assert(n.flags & INODE_INLINE == 0 && n.blocks == 1)
        assert_eq(must_entry(lookup_name(&fs, ROOT_INO, name_of("l", u64(i), 0, u8('.')).view())).file_type, DT_LNK)
        var out = zeros(4096)
        assert_eq(must_n(readlink(&fs, ino, out.view())), lens[i])
        assert(same(out.view()[0..<lens[i]], t.view()))
    must(fs.unmount())
    var again = mounted(&dev)
    for i in 0..<inos.len()
        var out = zeros(4096)
        assert_eq(must_n(readlink(&again, inos[i], out.view())), lens[i])
        assert(same(out.view()[0..<lens[i]], target_of(lens[i]).view()))
    settled_clean(&again)

@test("§11 a block symlink's block holds the target and zeros past it; an inline one's data zeros past the target")
symlink_bytes_past_target()
    var dev = small_device()
    var fs = mounted(&dev)
    val inl = must_ino(symlink(&fs, ROOT_INO, "i".bytes, target_of(5).view(), Caller(0, 0)))
    val blk = must_ino(symlink(&fs, ROOT_INO, "b".bytes, target_of(300).view(), Caller(0, 0)))
    must(fs.checkpoint_all())
    val n = node(&fs, inl)
    for k in 5..<128
        assert(n.data[k] == 0)
    val bytes = raw(&dev, phys_at(&fs, blk, 0))
    assert(same(bytes.view()[0..<300], target_of(300).view()))
    assert(zeroed(bytes.view()[300..<BLOCK_SIZE]))

@test("§11 symlink refuses an empty target (EINVAL) and one of 4096 bytes (ENAMETOOLONG); readlink of a non-symlink or into an empty buffer is EINVAL")
symlink_refusals()
    var dev = small_device()
    var fs = mounted(&dev)
    val inodes = fs.free_inodes_total.load()
    val blocks = free_total(&fs)
    assert_eq(err(symlink(&fs, ROOT_INO, "e".bytes, "".bytes, Caller(0, 0))), EINVAL)
    assert_eq(err(symlink(&fs, ROOT_INO, "m".bytes, target_of(4096).view(), Caller(0, 0))), ENAMETOOLONG)
    assert_eq(fs.free_inodes_total.load(), inodes)
    assert_eq(free_total(&fs), blocks)
    val f = mk(&fs, ROOT_INO, "f")
    var out = zeros(16)
    assert_eq(err(readlink(&fs, f, out.view())), EINVAL)
    assert_eq(err(readlink(&fs, ROOT_INO, out.view())), EINVAL)
    val l = must_ino(symlink(&fs, ROOT_INO, "l".bytes, "abc".bytes, Caller(0, 0)))
    assert_eq(err(readlink(&fs, l, out.view()[0..<0])), EINVAL)
    settled_clean(&fs)

@test("§11 readlink with a short buffer answers its length's first bytes, no terminator, inline and in a block")
readlink_short_buffer()
    var dev = small_device()
    var fs = mounted(&dev)
    val inl = must_ino(symlink(&fs, ROOT_INO, "i".bytes, target_of(100).view(), Caller(0, 0)))
    val blk = must_ino(symlink(&fs, ROOT_INO, "b".bytes, target_of(1000).view(), Caller(0, 0)))
    for x in [inl, blk]
        var out = zeros(10)
        assert_eq(must_n(readlink(&fs, x, out.view())), 10)
        assert(same(out.view(), target_of(10).view()))
        var one = zeros(1)
        assert_eq(must_n(readlink(&fs, x, one.view())), 1)
        assert_eq(one[0], u8('a'))
    // A buffer longer than the target takes the target and no more.
    var wide = zeros(200)
    assert_eq(must_n(readlink(&fs, inl, wide.view())), 100)
    assert(zeroed(wide.view()[100..<200]))

@test("§18 a name a full disk cannot take gives back the inode (and a symlink's block): ENOSPC, nothing left behind, clean")
create_out_of_space()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val f = mk(&fs, ROOT_INO, "f")
    ns_fill_leaf(&fs, d, f)
    // One block left: enough for a symlink's block, not for the conversion's two.
    ns_fill_disk(&fs, 1)
    val inodes = fs.free_inodes_total.load()
    val big = long_name(99, 255, u8('-'))
    assert_eq(err(create(&fs, d, big.view(), 0o644, Caller(0, 0))), ENOSPC)
    assert_eq(err(mkdir(&fs, d, big.view(), 0o755, Caller(0, 0))), ENOSPC)
    assert_eq(err(symlink(&fs, d, big.view(), target_of(500).view(), Caller(0, 0))), ENOSPC)
    assert_eq(fs.free_inodes_total.load(), inodes)
    assert_eq(fails_dir(lookup_name(&fs, d, big.view())), 21)
    assert_eq(links_of(&fs, d), 2)
    // The blocks and the inodes the refusals gave back are free once their transaction commits.
    settled_clean(&fs)
    assert_eq(free_total(&fs), 1)

@test("§17 a new directory's group counts it; a file in it goes to its group")
mkdir_counts_group()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val g = fs.inode_group(d)
    val before = desc_of(&fs, g).directories
    val total = directories(&fs)
    // A subdirectory goes to its parent's group while that group has at least the average free inodes.
    val e = mkd(&fs, d, "e")
    assert_eq(fs.inode_group(e), g)
    assert_eq(desc_of(&fs, g).directories, before + 1)
    assert_eq(directories(&fs), total + 1)
    val f = mk(&fs, d, "f")
    assert_eq(fs.inode_group(f), g)
    settled_clean(&fs)
