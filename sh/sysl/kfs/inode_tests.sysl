module keel.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// The inode layer (kfs/SPEC.md sections 8 and 17): reading a slot, its checks, generation, freeing that
// returns everything, references and links, st_blocks.

// A file of `n` one-block extents at logical blocks 0, 2, 4, ...: every other block a hole, so no two
// extents merge and a few dozen of them need extent-tree node blocks.
sparse_file[D: BlockDevice](fs: *Fs[D, HostPlatform], n: u64) -> u64
    val ino = new_file(fs, 0)
    for k in 0..<n
        put_pattern(fs, ino, 2 * k * u64(BLOCK_SIZE), BLOCK_SIZE, u32(k))
    ino

@test("a new inode reads back allocated: links 1, generation 1, every time the same, no blocks")
new_inode_fields()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 1000)
    assert(ino == FIRST_INO + 1)
    val n = must_inode(stat(&fs, ino))
    assert(n.mode == S_IFREG | 0o644 && n.links == 1 && n.uid == 1000 && n.gid == 1000)
    assert(n.generation == 1 && n.size == 0 && n.blocks == 0 && st_blocks(n) == 0)
    assert(n.atime_sec == n.mtime_sec && n.mtime_sec == n.ctime_sec && n.ctime_sec == n.crtime_sec)
    assert(n.flags == 0 && n.orphan_next == 0 && n.parent == 0)
    assert(fs.plat.held() == 0)

@test("generation goes up by one each time a freed slot is allocated again, and only then")
generation_on_reuse()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    val g = must_inode(stat(&fs, ino)).generation
    must(drop_link(&fs, ino))
    // Freed: the slot is zero but for the generation, which survives.
    must(fs.checkpoint_all())
    val loc = fs.inode_location(ino)
    val raw_slot = raw(&dev, loc.block)
    val slot: *Inode = at(raw_slot.view(), loc.offset)
    assert(slot.mode == 0 && slot.links == 0 && slot.generation == g && slot.size == 0)
    assert(code(stat(&fs, ino)) == 3)
    // The lowest clear bit again: the same number, the next generation.
    val again = new_file(&fs, 0)
    assert(again == ino)
    assert(must_inode(stat(&fs, again)).generation == g + 1)
    must(drop_link(&fs, again))
    assert(new_file(&fs, 0) == ino)
    assert(must_inode(stat(&fs, ino)).generation == g + 2)
    settled_clean(&fs)

@test("deleting a file with data and extent-tree nodes gives back every block and the inode, counts exact")
free_returns_everything()
    var dev = small_device()
    var fs = mounted(&dev)
    must(fs.checkpoint_all())
    val blocks_before = free_total(&fs)
    val inodes_before = fs.free_inodes_total.load()
    val ino = sparse_file(&fs, 40)
    val n = must_inode(stat(&fs, ino))
    assert(must_u16(depth_of(&fs, ino)) >= 1)
    assert(n.blocks > 40)
    must(fs.checkpoint_all())
    assert(free_total(&fs) == blocks_before - n.blocks)
    assert(fs.free_inodes_total.load() == inodes_before - 1)
    must(drop_link(&fs, ino))
    must(fs.checkpoint_all())
    assert(free_total(&fs) == blocks_before)
    assert(fs.free_inodes_total.load() == inodes_before)
    assert(orphans(&fs).len() == 0)
    settled_clean(&fs)
    // The descriptors agree with the totals: unmount writes them and the checker compares.
    must(fs.unmount())
    assert(super_of(&dev).free_blocks == blocks_before && super_of(&dev).free_inodes == inodes_before)
    checked_clean(&dev)

must_u16(r: Result[u16, FsError]) -> u16
    r match
        Ok(v) -> v
        Err(_) -> panic("a depth could not be read")

@test("a held inode keeps its blocks after its last link goes, on the orphan list; the last release frees it")
held_then_released()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 3 * BLOCK_SIZE, 5)
    must(hold(&fs, ino))
    must(hold(&fs, ino))
    must(drop_link(&fs, ino))
    val n = must_inode(stat(&fs, ino))
    assert(n.links == 0 && n.flags & INODE_ORPHAN != 0 && n.blocks == 3)
    assert(bytes_equal(got(&fs, ino, 0, 3 * BLOCK_SIZE), pattern(3 * BLOCK_SIZE, 5)))
    assert(orphans(&fs).len() == 1 && orphans(&fs)[0] == ino)
    settled_clean(&fs)
    must(release(&fs, ino))
    assert(must_inode(stat(&fs, ino)).links == 0)
    must(release(&fs, ino))
    assert(code(stat(&fs, ino)) == 3)
    assert(orphans(&fs).len() == 0)
    settled_clean(&fs)

@test("release with nothing held, drop_link of an inode with no links, and hold of a free inode are Invalid")
reference_misuse()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    assert(code(release(&fs, ino)) == 3)
    must(hold(&fs, ino))
    must(drop_link(&fs, ino))
    assert(code(drop_link(&fs, ino)) == 3)
    must(release(&fs, ino))
    assert(code(hold(&fs, ino)) == 3)
    assert(code(release(&fs, ino)) == 3)
    assert(code(hold(&fs, FIRST_INO + 40)) == 3)
    assert(fs.plat.held() == 0)
    assert(!fs.aborted())
    settled_clean(&fs)

@test("inode 0 and a number past the last inode are corruption: the journal aborts")
inode_numbers_out_of_range()
    var dev = small_device()
    var fs = mounted(&dev)
    assert(code(stat(&fs, 0)) == 6)
    assert(fs.aborted())
    var dev2 = small_device()
    var fs2 = mounted(&dev2)
    assert(code(stat(&fs2, fs2.sb.inode_count + 1)) == 6)
    assert(fs2.aborted() && fs2.read_only())
    assert(fs2.plat.held() == 0)

@test("a slot that fails its checksum is corruption to every operation on it")
inode_checksum_failure()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    must(fs.checkpoint_all())
    val loc = fs.inode_location(ino)
    var blk = raw(&dev, loc.block)
    blk[loc.offset + 24] = blk[loc.offset + 24] ^ 1
    raw_put(&dev, loc.block, blk.view())
    var fs2 = mounted(&dev)
    var out = zeros(10)
    assert(code(read(&fs2, ino, 0, out.view())) == 6)
    assert(fs2.aborted())
    assert(fs2.plat.held() == 0)

@test("st_blocks counts 512-byte units: eight per block, data and extent-tree nodes alike")
st_blocks_counts_nodes()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 1, 1)
    assert(st_blocks(must_inode(stat(&fs, ino))) == 8)
    val sparse = sparse_file(&fs, 8)
    // Eight extents overflow the inode's seven slots: one node block besides the eight data blocks.
    assert(must_u16(depth_of(&fs, sparse)) == 1)
    assert(blocks_of(&fs, sparse) == 9 && st_blocks(must_inode(stat(&fs, sparse))) == 72)
    settled_clean(&fs)

@test("every entry point lets go of every lock, after success and after failure")
locks_released()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    val data = pattern(10, 1)
    var out = zeros(10)
    assert(code(write(&fs, ino, MAX_FILE_SIZE, data.view(), 0)) == 7)
    assert(fs.plat.held() == 0)
    assert(code(read(&fs, FIRST_INO + 50, 0, out.view())) == 3)
    assert(fs.plat.held() == 0)
    assert(code(truncate(&fs, ino, MAX_FILE_SIZE + 1, 0)) == 7)
    assert(code(fallocate(&fs, ino, Falloc.Allocate, 0, 0, 0)) == 3)
    assert(code(fsync(&fs, FIRST_INO + 50)) == 3)
    assert(fs.plat.held() == 0)
    must_n(write(&fs, ino, 0, data.view(), 0))
    must(truncate(&fs, ino, 3, 0))
    must(fsync(&fs, ino))
    must(fallocate(&fs, ino, Falloc.PunchHole, 0, 2, 0))
    assert(fs.plat.held() == 0)
