module keel.kfs

// The platform: what KFS needs from whoever runs it, besides a block device (kfs/SPEC.md section 27,
// "Where things live"). Three things, kept as small as the algorithms allow:
//
// - **Locks**, named by `LockId` rather than held as objects, so the package never stores a lock and
//   the same code runs over the kernel's sleeping `Mutex`es and spinning `IrqLock`s and over the host's
//   no-ops. Which kind each one is, and the order they are taken in, is section 19's table; `rank`
//   below is that order, and the host implementation checks it on every acquisition.
// - **Clocks**: the wall time an allocation stamps on a new inode, and a monotonic one the commit
//   interval is measured on.
// - **The committer hook**: asked to commit the running transaction, the platform either wakes its
//   commit thread (the kernel's `kfs-commit`) or answers that there is none, and the caller commits
//   inline (the host). With a thread, a handle that must wait sleeps in `wait_for_commit`.
//
// Plus one exit for a bug in KFS itself (`fatal`): the kernel stops, a host test fails.

// Every lock of section 19 that the package takes.
enum LockId
    // `rename_lock`: the shape of the directory tree while a rename moves a directory or crosses
    // directories (sleeping, one per filesystem).
    Rename
    // `inode.lock` of a directory, named for rule 2 of the order: taken ancestor before descendant, and
    // two directories neither of which is the other's ancestor in increasing number. It is the same lock
    // as `Inode` of the same number; the name says which rule it is taken under.
    Dir(ino: u64)
    // `inode.lock` of a non-directory: its fields, its extent tree, its open count (sleeping). A split
    // operation holds it from its first step to its last. Taken in increasing number (rule 3).
    Inode(ino: u64)
    // `orphans.lock`: the orphan list (sleeping).
    Orphans
    // `group[g].lock`: group g's bitmaps, descriptor fields, pending frees and cursor (sleeping).
    // Never two at once.
    Group(g: u32)
    // `buffer.lock`: one metadata buffer's bytes and journal state (sleeping). The buffer is named by
    // the block it holds.
    Buffer(block: u64)
    // `journal.lock`: the running and committing transactions' records (spinning, a leaf).
    Journal
    // `cache.lock`: the buffer cache's index (spinning, a leaf).
    Cache
    // `icache.lock`: the in-memory inode table (spinning, a leaf).
    Icache

// Where a lock sits in section 19's order: a lock may be taken only while every lock held ranks
// strictly lower, except that several directories' locks (rank 2) may be held together, in the order
// rule 2 gives, and several non-directories' locks (rank 3) in increasing number. Rule 4, opening a
// handle, comes between an inode's lock and the orphan list's; the leaves share rank 8 and none may be
// held while taking another.
rank(l: LockId) -> u32
    l match
        LockId.Rename -> 1
        LockId.Dir(_) -> 2
        LockId.Inode(_) -> 3
        LockId.Orphans -> 5
        LockId.Group(_) -> 6
        LockId.Buffer(_) -> 7
        LockId.Journal -> 8
        LockId.Cache -> 8
        LockId.Icache -> 8

// A moment, as an inode stores one: signed seconds since the epoch and nanoseconds.
struct Time
    sec: i64
    nsec: u32

// A bug in KFS, reported to the platform before the call that found it fails.
enum Fatal
    // Operation `op` added more buffers to its handle than the `credits` it opened with (section 14,
    // "Credits are checked, not trusted").
    CreditOverrun(op: string, credits: u32)
    // Operation `op` revoked more blocks than its `credits`: every revoked block is one the operation
    // freed after declaring it, so a handle never revokes more blocks than it may declare.
    RevokeOverrun(op: string, credits: u32)
    // Operation `op` waits for room in the log, and the journal can make none: every way forward needs
    // a handle that this same thread holds open. On the host, where the committer runs inline, that is
    // a test opening a second handle while holding the first.
    Deadlock(op: string)
    // A transaction about to be logged does not fit in the log's free space. The reservation of
    // section 14 makes this impossible; it is checked before a log block is written.
    LogOverrun(seq: u64)

trait Platform
    // Take and release a lock. Taking may sleep for a sleeping lock and spins for a leaf.
    lock(*self, l: LockId)
    unlock(*self, l: LockId)

    // The time now.
    now(*self) -> Time

    // A monotonic clock in milliseconds, which only moves forward: the age of the running transaction
    // against `COMMIT_INTERVAL` is measured on it.
    monotonic_ms(*self) -> u64

    // Ask for the running transaction to be committed. True when there is no commit thread and the
    // caller must commit it itself, now; false when a commit thread was woken and will do it.
    wake_committer(*self) -> bool

    // Sleep until the commit thread has moved the journal on: a commit or a checkpoint finished. Called
    // only after `wake_committer` answered false, by a handle waiting to open (section 14, "Log space is
    // reserved when a handle joins").
    wait_for_commit(*self)

    // A bug in KFS. The kernel stops here; a host test fails here unless it is the test of this very
    // failure, in which case the call returns and the operation answers `FsError.Bug`.
    fatal(*self, f: Fatal)
