module sh.sysl.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// Every diagnostic the checker can emit, broken alone on an image and run through fsck (kfs/SPEC.md
// section 23): `-y` repairs it and the next check is clean, or — where the repair is destructive — `-y`
// leaves it (exit 4) and `--rebuild-corrupt` repairs it. The table in SPEC.md section 23 lists each
// diagnostic with its repair; these tests are that table run.

private const PX_RAW: u64 = 0x4000_0000_0000_0000
private const PY_RAW: u64 = 0x8000_0000_0000_0000

// A directory named in the root holding "one", "two" and "three" for `f`, linear.
private three_names(fs: *RamFs, f: u64) -> u64
    val d = new_dir(fs)
    add(fs, d, "one".bytes, f)
    add(fs, d, "two".bytes, f)
    add(fs, d, "three".bytes, f)
    d

// The X/Y directory of the shrink tests: X names in leaf 1, Y names in leaf 2, keys 0 and Y. The hash
// hook stays set until the caller clears it.
private xy_dir(fs: *RamFs, f: u64) -> u64
    force_raw_hashes([PX_RAW, PY_RAW])
    val d = new_dir(fs)
    for i in 0..<7
        add(fs, d, long_name(u64(i), 255, u8('b')).view(), f)
    for i in 0..<8
        add(fs, d, long_name(u64(i), 255, u8('a')).view(), f)
    d

// The names a whole scan returns, `.` and `..` left out.
private real_names(all: Buf[Listed]) -> Buf[Listed]
    var out: Buf[Listed] = buf()
    for x in all.view()
        if !same(x.name.view(), ".".bytes) && !same(x.name.view(), "..".bytes) then out.push(x)
    out

private names_in(fs: *RamFs, d: u64) -> Buf[Listed] = real_names(scan_all(fs, d, 4096))

private set_index_key(b: []u8, i: usize, key: u64) = put_le64(b, 16 + 16 * i, key)
private set_index_child(b: []u8, i: usize, child: u32) = put_le32(b, 16 + 16 * i + 8, child)

// -- Pass 0 ---------------------------------------------------------------------------------------------

@test("§23 pass 0 Super: a primary superblock with a bad magic, an unknown version, impossible geometry — each restored from the backup")
super_kinds()
    for kind in 0u32..<3
        var dev = small_device()
        var fs = mounted(&dev)
        val f = mk(&fs, ROOT_INO, "f")
        must(fs.unmount())
        disk_super(&dev, (sb) ->
            kind match
                0 -> sb.magic = 0
                1 -> sb.version = 99
                _ -> sb.blocks = sb.blocks + 1)
        val want = kind match
            0 -> OpenError.BadMagic
            1 -> OpenError.BadVersion
            _ -> OpenError.BadGeometry
        val _ = repaired(&dev, Problem.Super(want))
        var fs2 = mounted(&dev)
        assert_eq(named(&fs2, ROOT_INO, "f"), f)
        must(fs2.unmount())

@test("§23 pass 0 Super: a descriptor that fails its checksum, or puts its inode table elsewhere, is restored from the backup's; its counts then by pass 5")
descriptor_from_backup()
    for kind in 0u32..<2
        var dev = small_device()
        var fs = mounted(&dev)
        val f = mk(&fs, ROOT_INO, "f")
        put_pattern(&fs, f, 0, 30000, 4)
        must(fs.unmount())
        if kind == 0 then flip_byte(&dev, 2, 20) else disk_desc(&dev, 0, (d) -> d.inode_table = d.inode_table + 1)
        val want = if kind == 0 then OpenError.BadDescriptor(0) else OpenError.MisplacedGroup(0)
        val r = repaired(&dev, Problem.Super(want))
        assert(did(r, "group 0's descriptor was restored from the backup"))
        // The backup's counts are the format's: pass 5 rewrote them.
        assert(did(r, "group 0's bitmaps, counts and checksums were rewritten"))
        assert(bytes_equal(read_back(&dev, f, 30000), pattern(30000, 4)))

@test("§23 pass 0 Super: a descriptor whose backup fails too is rebuilt from the geometry")
descriptor_from_geometry()
    var dev = small_device()
    var fs = mounted(&dev)
    val _ = mk(&fs, ROOT_INO, "f")
    must(fs.unmount())
    flip_byte(&dev, 2, 64 + 20)
    flip_byte(&dev, 2049 + 1, 64 + 20)
    val r = repaired(&dev, Problem.Super(OpenError.BadDescriptor(1)))
    assert(did(r, "group 1's descriptor was rebuilt from the geometry"))

@test("§23 pass 0: no superblock anywhere (primary and backup both fail) is an operational error, exit 8, in both modes")
no_superblock()
    var dev = small_device()
    flip_byte(&dev, 1, 40)
    flip_byte(&dev, 2049, 40)
    val before = image_digest(&dev)
    val n = fsck_n(&dev)
    assert_eq(n.code, FSCK_FAILED)
    assert(among_problems(n.found, Problem.Super(OpenError.BadChecksum)))
    val y = fsck_y(&dev)
    assert_eq(y.code, FSCK_FAILED)
    assert(did(y, "no usable superblock"))
    assert_eq(image_digest(&dev), before)

@test("§23 a device that fails every read is an operational error, exit 8")
device_fails()
    var dev = DeadDevice(4097)
    val r = fsck_y(&dev)
    assert_eq(r.code, FSCK_FAILED)
    assert(did(r, "the device failed"))
    assert_eq(fsck_n(&dev).code, FSCK_FAILED)

@test("§23 and §21 Features: unknown features are reported and nothing is repaired or written, exit 4")
unknown_features()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    fs_poke(&fs, f, (n) -> n.links = 4)
    must(fs.unmount())
    edit_super(&dev, 0, 0, 0x80)
    val before = image_digest(&dev)
    val r = fsck_y(&dev)
    assert_eq(r.code, FSCK_LEFT)
    assert(among_problems(r.left, Problem.Features))
    assert(among_problems(r.left, Problem.LinkCount(f, 4, 1)))
    assert(did(r, "unknown features: nothing was repaired"))
    assert_eq(image_digest(&dev), before)

@test("§23 ErrorState: ERROR is cleared, and CLEAN set, when fsck leaves the filesystem clean")
error_state_cleared()
    var dev = small_device()
    edit_super(&dev, STATE_ERROR, 0, 0)
    val _ = repaired(&dev, Problem.ErrorState)
    assert(super_of(&dev).state & STATE_ERROR == 0)
    var fs = mounted(&dev)
    assert(!fs.read_only())

@test("§23 ErrorState stays while anything else is left: fsck clears ERROR only when it leaves the filesystem clean")
error_state_kept()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    must(fs.unmount())
    flip_byte(&dev, disk_slot(&dev, f).block, disk_slot(&dev, f).offset + 30)
    edit_super(&dev, STATE_ERROR, 0, 0)
    val r = left_alone(&dev, Problem.InodeChecksum(f))
    assert(among_problems(r.left, Problem.ErrorState))
    assert(super_of(&dev).state & STATE_ERROR != 0)

@test("§23 JournalError: an error recorded in the journal superblock is cleared with the stamp")
journal_error_cleared()
    var dev = small_device()
    var st = journal_of(&dev)
    st.error = 5
    assert(write_journal_super(&dev, super_of(&dev), st).is_ok())
    val _ = repaired(&dev, Problem.JournalError(5))
    assert_eq(journal_of(&dev).error, 0)

@test("§23 and §15 Journal: a journal superblock that fails is left by -y and rewritten empty by --rebuild-corrupt")
journal_super_rebuilt()
    var dev = small_device()
    val js = super_of(&dev).journal_start
    flip_byte(&dev, js, 40)
    val _ = left_alone(&dev, Problem.Journal(OpenError.BadJournal))
    val r = fsck_rebuild(&dev)
    assert_eq(r.code, FSCK_FIXED)
    assert(did(r, "rewritten empty"))
    assert_eq(journal_of(&dev).start, 0)
    val _ = checked_clean(&dev)
    var fs = mounted(&dev)
    val _ = mk(&fs, ROOT_INO, "after")
    must(fs.unmount())
    val _ = checked_clean(&dev)

@test("§23 and §15 NeedsRecovery: a committed log is replayed first — by -y on the disk, by -n in memory only — and is no error")
needs_recovery()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    must(fs.commit())
    assert(journal_of(&dev).start != 0)
    assert(among_problems(check(&dev).problems, Problem.NeedsRecovery))
    val before = image_digest(&dev)
    val n = fsck_n(&dev)
    assert_eq(n.code, FSCK_CLEAN)
    assert(did(n, "recovery replayed 1 transactions"))
    assert_eq(image_digest(&dev), before)
    val y = fsck_y(&dev)
    assert_eq(y.code, FSCK_CLEAN)
    assert_eq(journal_of(&dev).start, 0)
    val _ = checked_clean(&dev)
    var fs2 = mounted(&dev)
    assert_eq(named(&fs2, ROOT_INO, "f"), f)
    must(fs2.unmount())

@test("§23 and §15 LogAudit: a committed copy failing its tag stops recovery; -y leaves the log, --rebuild-corrupt discards it")
log_audit_discarded()
    var dev = small_device()
    var fs = mounted(&dev)
    var blocks: Buf[u64] = buf()
    for k in 0..<3u64
        blocks.push(scratch(&fs, k))
    stamp_all(&fs, blocks, 5)
    val log = log_contents(&dev)
    val cp = log.copies[1]
    flip_byte(&dev, log_pos(super_of(&dev), cp.pos), 100)
    val r = left_alone(&dev, Problem.LogAudit(cp.pos))
    assert(among_problems(r.left, Problem.NeedsRecovery))
    val b = fsck_rebuild(&dev)
    if b.code != FSCK_FIXED then show_run(b)
    assert_eq(b.code, FSCK_FIXED)
    assert(did(b, "discarded"))
    assert_eq(journal_of(&dev).start, 0)
    assert_eq(journal_of(&dev).error, 0)
    val _ = checked_clean(&dev)

// -- Pass 1 ---------------------------------------------------------------------------------------------

@test("§23 pass 1 InodeParent: a non-directory with a parent has it cleared")
inode_parent()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    fs_poke(&fs, f, (n) -> n.parent = ROOT_INO)
    val _ = repaired(&dev, Problem.InodeParent(f))
    assert_eq(disk_inode(&dev, f).parent, 0)

@test("§23 pass 1 InodeSize: a FIFO with a size has it cleared; a symlink of impossible size waits for --rebuild-corrupt, which clears it and its name")
inode_size()
    var dev = small_device()
    var fs = mounted(&dev)
    val p = must_ino(mknod(&fs, ROOT_INO, "p".bytes, S_IFIFO | 0o600, DeviceNumbers(0, 0), Caller(0, 0)))
    fs_poke(&fs, p, (n) -> n.size = 5)
    val _ = repaired(&dev, Problem.InodeSize(p))
    assert_eq(disk_inode(&dev, p).size, 0)
    var dev2 = small_device()
    var fs2 = mounted(&dev2)
    val l = must_ino(symlink(&fs2, ROOT_INO, "l".bytes, target_of(200).view(), Caller(0, 0)))
    fs_poke(&fs2, l, (n) -> n.size = 100)
    val _ = left_alone(&dev2, Problem.InodeSize(l))
    val r = fsck_rebuild(&dev2)
    assert_eq(r.code, FSCK_FIXED)
    assert(did(r, s"inode $l was cleared"))
    val _ = checked_clean(&dev2)
    var fs3 = mounted(&dev2)
    assert_eq(named(&fs3, ROOT_INO, "l"), 0)
    assert(!alive(&fs3, l))

@test("§23 pass 1 BlockCount: a wrong `blocks` is set to what the inode claims")
block_count()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 9000, 1)
    fs_poke(&fs, f, (n) -> n.blocks = 9)
    val _ = repaired(&dev, Problem.BlockCount(f, 9, 3))
    assert_eq(disk_inode(&dev, f).blocks, 3)

@test("§23 pass 1 ExtentPastEnd: a size short of what a file maps is raised to cover it, so no byte is lost")
extent_past_end()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 12288, 6)
    fs_poke(&fs, f, (n) -> n.size = 4096)
    val _ = repaired(&dev, Problem.ExtentPastEnd(f, 0))
    assert_eq(disk_inode(&dev, f).size, 12288)
    assert(bytes_equal(read_back(&dev, f, 12288), pattern(12288, 6)))

@test("§23 pass 1 TailNotZero: bytes past the size in the last block are zeroed; the file's own bytes stay")
tail_zeroed()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 5000, 8)
    must(fs.unmount())
    val last = first_phys(&dev, f) + 1
    var blk = raw(&dev, last)
    blk[4000] = 0x55
    raw_put(&dev, last, blk.view())
    val _ = repaired(&dev, Problem.TailNotZero(f))
    assert_eq(raw(&dev, last)[4000], 0)
    assert(bytes_equal(read_back(&dev, f, 5000), pattern(5000, 8)))

@test("§23 pass 1 Unlinked: no links and no name — put on the orphan list and freed; no links with a name — the links set from the names")
unlinked()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 20000, 2)
    val free_before = free_total(&fs)
    val _ = must_entry(remove_name(&fs, ROOT_INO, "f".bytes))
    fs_poke(&fs, f, (n) -> n.links = 0)
    val r = repaired(&dev, Problem.Unlinked(f))
    assert(did(r, "was put on the orphan list"))
    var fs2 = mounted(&dev)
    assert(!alive(&fs2, f))
    assert_eq(free_total(&fs2), free_before + 5)
    val g = mk(&fs2, ROOT_INO, "g")
    fs_poke(&fs2, g, (n) -> n.links = 0)
    val r2 = repaired(&dev, Problem.Unlinked(g))
    assert(among_problems(r2.found, Problem.LinkCount(g, 0, 1)))
    assert_eq(disk_inode(&dev, g).links, 1)

@test("§23 pass 1 FreeInodeInUse (a warning): a free slot holding a mode is zeroed by -y; -n reports it and exits 0")
free_inode_in_use()
    var dev = small_device()
    disk_edit(&dev, 40, false, (n) -> n.mode = S_IFREG | 0o644)
    val n = fsck_n(&dev)
    assert_eq(n.code, FSCK_CLEAN)
    assert(among_problems(n.warnings, Problem.FreeInodeInUse(40)))
    val y = fsck_y(&dev)
    assert_eq(y.code, FSCK_FIXED)
    assert(did(y, "free inode 40's slot was zeroed"))
    assert_eq(disk_inode(&dev, 40).mode, 0)
    assert_eq(check(&dev).warnings.len(), 0)

@test("§23 pass 1 InodeChecksum, InodeMode, InodeFlags: never repaired by -y; --rebuild-corrupt clears the inode, drops its name and frees its blocks")
unsound_inodes()
    for kind in 0u32..<3
        var dev = small_device()
        var fs = mounted(&dev)
        val f = mk(&fs, ROOT_INO, "f")
        put_pattern(&fs, f, 0, 9000, 3)
        val keep = mk(&fs, ROOT_INO, "keep")
        val free_before = free_total(&fs)
        must(fs.unmount())
        kind match
            0 -> flip_byte(&dev, disk_slot(&dev, f).block, disk_slot(&dev, f).offset + 30)
            1 -> disk_edit(&dev, f, true, (n) -> n.mode = 0o170000 | 0o644)
            _ -> disk_edit(&dev, f, true, (n) -> n.flags = n.flags | INODE_INDEXED)
        val want = kind match
            0 -> Problem.InodeChecksum(f)
            1 -> Problem.InodeMode(f)
            _ -> Problem.InodeFlags(f)
        val y = left_alone(&dev, want)
        // An inode no pass can walk may own any block nobody claims: none is freed.
        assert(!did(y, "bitmaps, counts and checksums were rewritten"))
        val r = fsck_rebuild(&dev)
        if r.code != FSCK_FIXED then show_run(r)
        assert_eq(r.code, FSCK_FIXED)
        val _ = checked_clean(&dev)
        var fs2 = mounted(&dev)
        assert(!alive(&fs2, f))
        assert_eq(named(&fs2, ROOT_INO, "f"), 0)
        assert_eq(named(&fs2, ROOT_INO, "keep"), keep)
        assert_eq(free_total(&fs2), free_before + 3)
        must(fs2.unmount())

@test("§23 pass 1 Extent: a root with a bad magic, and a node block failing its checksum, wait for --rebuild-corrupt")
extent_faults()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 100, 1)
    must(fs.unmount())
    disk_edit(&dev, f, true, (n) -> n.data[0] = 0)
    val _ = left_alone(&dev, Problem.Extent(f, 0, NodeFault.Magic))
    assert_eq(fsck_rebuild(&dev).code, FSCK_FIXED)
    val _ = checked_clean(&dev)
    // Nine separate extents need a node below the root.
    var dev2 = small_device()
    var fs2 = mounted(&dev2)
    val g = mk(&fs2, ROOT_INO, "g")
    for k in 0..<9u64
        put_pattern(&fs2, g, k * 8192, 4096, u32(k))
    must(fs2.unmount())
    val node = first_phys(&dev2, g)
    assert(disk_inode(&dev2, g).data[8] == 1)
    flip_byte(&dev2, node, 200)
    val _ = left_alone(&dev2, Problem.Extent(g, node, NodeFault.Checksum))
    assert_eq(fsck_rebuild(&dev2).code, FSCK_FIXED)
    val _ = checked_clean(&dev2)

@test("§23 pass 1 Xattr: an xattr block failing its checksum waits for --rebuild-corrupt, which drops it; XattrFeature: -y sets the feature, in the backups too")
xattr_blocks()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    must(setxattr(&fs, f, XATTR_USER, "a".bytes, "1".bytes, 0, 0))
    val xb = node(&fs, f).xattr_block
    must(fs.unmount())
    flip_byte(&dev, xb, 20)
    val _ = left_alone(&dev, Problem.Xattr(f))
    val r = fsck_rebuild(&dev)
    assert_eq(r.code, FSCK_FIXED)
    assert(did(r, s"inode $f's xattr block was dropped"))
    assert_eq(disk_inode(&dev, f).xattr_block, 0)
    val _ = checked_clean(&dev)
    var dev2 = small_device()
    var fs2 = mounted(&dev2)
    val g = mk(&fs2, ROOT_INO, "g")
    must(setxattr(&fs2, g, XATTR_USER, "a".bytes, "1".bytes, 0, 0))
    must(fs2.unmount())
    edit_super(&dev2, 0, 0, 0)
    val _ = repaired(&dev2, Problem.XattrFeature(g))
    assert(super_of(&dev2).feature_ro_compat & RO_COMPAT_XATTR != 0)
    val backup = raw(&dev2, 2049)
    val bsb: *Superblock = at(backup.view(), 0)
    assert(bsb.feature_ro_compat & RO_COMPAT_XATTR != 0)

// -- Pass 2 ---------------------------------------------------------------------------------------------

@test("§23 pass 2 DirBlock: a leaf with a wrong magic is rebuilt by -y (its names lost to it go to lost+found); one failing its checksum waits for --rebuild-corrupt")
dir_block()
    for kind in 0u32..<2
        var dev = small_device()
        var fs = mounted(&dev)
        val d = mkd(&fs, ROOT_INO, "d")
        val f = mk(&fs, d, "f")
        put_pattern(&fs, f, 0, 300, 9)
        poke_dir(&fs, d, 0, kind == 0, (b) -> b[0] = b[0] ^ 0x01)
        val want = Problem.DirBlock(d, 0, if kind == 0 then DirFault.Magic else DirFault.Checksum)
        if kind == 1
            val _ = left_alone(&dev, want)
            assert_eq(fsck_rebuild(&dev).code, FSCK_FIXED)
            val _ = checked_clean(&dev)
        else
            val _ = repaired(&dev, want)
        var fs2 = mounted(&dev)
        val lf = named(&fs2, ROOT_INO, "lost+found")
        assert_eq(named(&fs2, lf, s"#$f"), f)
        assert(bytes_equal(got(&fs2, f, 0, 300), pattern(300, 9)))
        must(fs2.unmount())

@test("§23 pass 2 DirName, DirType, DirDuplicate: the directory is rebuilt — the bad name dropped, the type taken from the inode, one copy of the name kept")
dir_names()
    for kind in 0u32..<3
        var dev = small_device()
        var fs = mounted(&dev)
        val f = new_file(&fs, 0)
        val d = new_dir(&fs)
        force_raw_hash(PX_RAW)
        add(&fs, d, "aaaa".bytes, f)
        add(&fs, d, "keep".bytes, f)
        poke_dir(&fs, d, 0, true, (b) ->
            val recs = leaf_records(b) match
                Ok(r) -> r
                Err(_) -> panic("the leaf was already broken")
            kind match
                0 -> b[recs[0].off + 13] = u8('/')
                1 -> b[recs[0].off + 11] = DT_DIR
                _ ->
                    for k in 0..<recs[1].name_len
                        b[recs[1].off + 12 + k] = u8('a'))
        val want = kind match
            0 -> Problem.DirName(d, 0)
            1 -> Problem.DirType(d, f)
            _ -> Problem.DirDuplicate(d)
        val _ = repaired(&dev, want)
        var fs2 = mounted(&dev)
        val names = names_in(&fs2, d)
        kind match
            0 -> assert_eq(names.len(), 1)
            1 -> assert(names.len() == 2 && names[0].file_type == DT_REG && names[1].file_type == DT_REG)
            _ -> assert(names.len() == 1 && times_listed(names, "aaaa".bytes) == 1)
        must(fs2.unmount())
        clear_raw_hash()

@test("§23 pass 2 DirTarget: a dangling entry (naming a free inode) is dropped; the directory's other names stay")
dangling_entry()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = new_file(&fs, 0)
    val d = three_names(&fs, f)
    must(add_name(&fs, d, "ghost".bytes, 60, DT_REG, 0))
    must(fs.checkpoint_all())
    val _ = repaired(&dev, Problem.DirTarget(d, 60))
    var fs2 = mounted(&dev)
    assert_eq(named(&fs2, d, "ghost"), 0)
    assert_eq(named(&fs2, d, "two"), f)
    assert_eq(names_in(&fs2, d).len(), 3)
    must(fs2.unmount())

@test("§23 pass 2 DirRange, DirMark, DirReach: an index whose keys or children are wrong is rebuilt and every name found again")
dir_index()
    for kind in 0u32..<3
        var dev = small_device()
        var fs = mounted(&dev)
        val f = new_file(&fs, 0)
        val d = xy_dir(&fs, f)
        poke_dir(&fs, d, 0, true, (b) ->
            kind match
                0 -> set_index_key(b, 1, PY_RAW + 2)
                1 -> set_index_key(b, 1, PY_RAW | 1)
                _ -> set_index_child(b, 1, 1))
        val want = kind match
            0 -> Problem.DirRange(d, 2)
            1 -> Problem.DirMark(d, 2)
            _ -> Problem.DirReach(d, 2)
        val _ = repaired(&dev, want)
        var fs2 = mounted(&dev)
        assert_eq(names_in(&fs2, d).len(), 15)
        for i in 0..<7
            assert_eq(must_entry(lookup_name(&fs2, d, long_name(u64(i), 255, u8('b')).view())).ino, f)
        for i in 0..<8
            assert_eq(must_entry(lookup_name(&fs2, d, long_name(u64(i), 255, u8('a')).view())).ino, f)
        must(fs2.unmount())
        clear_raw_hash()

@test("§23 pass 2 DirShape: an empty directory marked indexed is rebuilt plain")
dir_shape()
    var dev = small_device()
    var fs = mounted(&dev)
    val e = new_dir(&fs)
    fs_poke(&fs, e, (n) -> n.flags = n.flags | INODE_INDEXED)
    val _ = repaired(&dev, Problem.DirShape(e))
    assert_eq(disk_inode(&dev, e).flags & INODE_INDEXED, 0)

// -- Pass 3 ---------------------------------------------------------------------------------------------

@test("§23 pass 3 DirNamedTwice: a directory's second name is removed, the first found kept; the root keeps none")
named_twice()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val d = mkd(&fs, ROOT_INO, "d")
    must(add_name(&fs, a, "again".bytes, d, DT_DIR, 0))
    must(add_name(&fs, a, "root".bytes, ROOT_INO, DT_DIR, 0))
    must(fs.checkpoint_all())
    val r = repaired(&dev, Problem.DirNamedTwice(d))
    assert(among_problems(r.found, Problem.DirNamedTwice(ROOT_INO)))
    var fs2 = mounted(&dev)
    assert_eq(named(&fs2, ROOT_INO, "d"), d)
    assert_eq(named(&fs2, a, "again"), 0)
    assert_eq(named(&fs2, a, "root"), 0)
    must(fs2.unmount())

@test("§23 pass 3 DirCycle: two directories naming each other, nothing reaching them — the lowest member goes to lost+found and the rest hang below it")
dir_cycle()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, a, "b")
    val c = mkd(&fs, b, "c")
    val _ = must_entry(remove_name(&fs, ROOT_INO, "a".bytes))
    must(add_name(&fs, c, "a".bytes, a, DT_DIR, 0))
    fs_poke(&fs, a, (n) -> n.parent = c)
    val _ = repaired(&dev, Problem.DirCycle(a))
    var fs2 = mounted(&dev)
    val lf = named(&fs2, ROOT_INO, "lost+found")
    assert_eq(named(&fs2, lf, s"#$a"), a)
    assert_eq(named(&fs2, a, "b"), b)
    assert_eq(named(&fs2, c, "a"), 0)
    assert_eq(node(&fs2, a).parent, lf)
    must(fs2.unmount())

// -- Pass 5 ---------------------------------------------------------------------------------------------

@test("§23 pass 5 InodeBit, FreeBlocks, FreeInodes, Directories, both bitmap checksums, Totals: each rewritten")
pass5_counts()
    for kind in 0u32..<7
        var dev = small_device()
        var fs = mounted(&dev)
        val _ = mk(&fs, ROOT_INO, "f")
        must(fs.unmount())
        var sb = super_of(&dev)
        val g = geometry_of(&sb)
        kind match
            0 ->
                var ib = raw(&dev, g.inode_bitmap(0))
                bit_clear(ib.view(), 4)
                raw_put(&dev, g.inode_bitmap(0), ib.view())
                disk_desc(&dev, 0, (d) -> d.inode_bitmap_crc = bitmap_crc(sb.csum_seed, 0, ib.view()))
            1 -> disk_desc(&dev, 0, (d) -> d.free_blocks = d.free_blocks + 1)
            2 -> disk_desc(&dev, 0, (d) -> d.free_inodes = d.free_inodes + 1)
            3 -> disk_desc(&dev, 1, (d) -> d.directories = d.directories + 1)
            4 -> disk_desc(&dev, 0, (d) -> d.block_bitmap_crc = d.block_bitmap_crc ^ 1)
            5 -> disk_desc(&dev, 1, (d) -> d.inode_bitmap_crc = d.inode_bitmap_crc ^ 1)
            _ -> disk_super(&dev, (s) -> s.free_blocks = s.free_blocks + 1)
        val want = kind match
            0 -> Problem.InodeBit(5, true)
            1 -> Problem.FreeBlocks(0)
            2 -> Problem.FreeInodes(0)
            3 -> Problem.Directories(1)
            4 -> Problem.BlockBitmapCrc(0)
            5 -> Problem.InodeBitmapCrc(1)
            _ -> Problem.Totals
        val _ = repaired(&dev, want)

@test("§23 pass 5 OrphanMember: a list reaching a free inode is cut before it")
orphan_member()
    var dev = small_device()
    disk_super(&dev, (s) -> s.orphan_head = 60)
    val r = repaired(&dev, Problem.OrphanMember(60))
    assert(did(r, "the orphan list was cut before inode 60"))
    assert_eq(super_of(&dev).orphan_head, 0)

@test("§23 pass 5 OrphanFlag: an inode marked an orphan that the list misses is put back on it and processed — a named file keeps its bytes and loses the mark")
orphan_flag()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 6000, 5)
    must(fs.unmount())
    disk_edit(&dev, f, true, (n) -> n.flags = n.flags | INODE_ORPHAN)
    val r = repaired(&dev, Problem.OrphanFlag(f))
    assert(did(r, "was put back on the orphan list"))
    assert_eq(disk_inode(&dev, f).flags & INODE_ORPHAN, 0)
    assert_eq(super_of(&dev).orphan_head, 0)
    assert(bytes_equal(read_back(&dev, f, 6000), pattern(6000, 5)))
