module sh.sysl.kfs

import sysl.buf.{Buf, buf, buf_with_capacity}
import sysl.slices.as_mut_ptr

// A table of records that several cores read and write at once, each record under the lock that guards
// it (kfs/SPEC.md section 19): the buffer cache, the in-memory inodes, the groups.
//
// **`t[i]` is the record in place**, as a `Buf` element is: reading a field through it is a load and
// writing one is a store, so the only counts touched are those of a counted field itself, when it is read
// whole or replaced — and that happens under the lock guarding the record. A copy of a record would
// retain every counted field it holds (a buffer's frozen copy, an inode's list of dirty blocks) with an
// ordinary, non-atomic count, which two cores reading one record under two different locks would race on
// (FINDINGS.md 79). Assigning a whole record (`t[i] = r`) releases the old one and retains the new.
//
// **Why not a plain `Buf[T]`: records never move.** A `Buf` that grows moves its elements under the feet
// of a core reading one. Here they live in chunks of CHUNK, each chunk's room taken whole when it is made,
// so an address `&t[i]` stays good for the table's life while records are added beside it. `add` is
// called under the lock that guards the table (the cache's, the inode table's); indexing needs none.
struct Table[T]
    private chunks: [CHUNKS]*T
    private owners: Buf[Buf[T]]
    private count: usize
    private limit: usize

    // How many records there are; every index below this is valid.
    len(self) -> usize = self.count

    // How many records the table may come to.
    room(self) -> usize = self.limit

    // Add `v` as a new record and answer its index; None when the table is at its limit.
    add(*self, v: T) -> Option[usize]
        val n = self.count
        if n >= self.limit then return None
        val k = n / CHUNK
        if n % CHUNK == 0
            // A table smaller than a chunk takes only the room it may come to.
            val room = if self.limit - n < CHUNK then self.limit - n else CHUNK
            val chunk = buf_with_capacity(room, v)
            chunk.push(v)
            self.chunks[k] = as_mut_ptr(chunk.view())
            self.owners.push(chunk)
        else
            self.owners[k].push(v)
        self.count = n + 1
        Some(n)

// `t[i]` is record `i` in place: a field read through it is a load, a field written a store, and the
// record itself is never copied. An index past the end is a bug in KFS.
impl[T] IndexPlace[usize, T] for Table[T]
    index_place(*self, i: usize) -> *T
        if i >= self.count then panic("sh.sysl.kfs: a table index past its records")
        &self.chunks[i / CHUNK][i % CHUNK]

// Few chunks of many records, so a `Table` — and the `Fs` holding three — stays small: an unoptimized
// build copies an `Fs` into the frame of every function that builds one.
private const CHUNK: usize = 4096
private const CHUNKS: usize = 16

// The most records a table holds: 65,536.
const TABLE_MAX: usize = CHUNK * CHUNKS

// An empty table that may come to `limit` records (at most TABLE_MAX; 0 means TABLE_MAX).
table[T](limit: usize) -> Table[T]
    val most = if limit == 0 || limit > TABLE_MAX then TABLE_MAX else limit
    Table([null; CHUNKS], buf(), 0, most)
