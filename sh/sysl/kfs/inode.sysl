module keel.kfs

import sysl.buf.{Buf, buf}

// The inode layer (kfs/SPEC.md sections 8, 16 and 19): reading an inode, changing it inside a handle,
// and what memory keeps for an inode beside its slot on the disk.
//
// **The slot is the inode.** Every field lives in the inode-table block's buffer and is read from
// there; a change is declared (`write_access`) and made in place, then the slot is sealed again. There
// is no second copy to fall out of step with the disk: a change touches exactly the fields it means to,
// so `orphan_next` and `ORPHAN`, which belong to the orphan list (orphan.sysl), are written by that code
// alone, under `orphans.lock`, as section 19 requires.
//
// **In memory** (`InCore`) an inode has what the disk does not hold: how many references keep it open,
// its neighbours on the orphan list (doubly linked in memory, singly on the disk, so the predecessor is
// at hand), the data blocks it has written that `fsync` must make durable, and the last transactions
// that changed it at all and that changed its size or its mapping, which tell `fsync` and `fdatasync`
// whether a commit must be forced. The kernel's inode cache will own this table; here it is a list
// searched by number under `icache.lock`, its slots reused, never moved.

// Permission bits a write by anyone but root clears (section 18, `write`).
const S_ISUID: u16 = 0o4000
const S_ISGID: u16 = 0o2000

// One inode in memory. `ino` 0 marks a free slot of the table.
struct InCore
    ino: u64
    // References that keep the inode open: it is deleted at the last release once it has no links.
    held: u32
    // On the orphan list, with its neighbours there (0 for none). Owned by `orphans.lock`.
    orphan: bool
    prev: u64
    next: u64
    // Data blocks written and not yet made durable by an `fsync`.
    dirty: Buf[u64]
    // The last transaction that changed the inode, and the last that changed its size or its mapping.
    meta_seq: u64
    map_seq: u64
    // When an operation last looked the record up (`Platform.stamp`), as a buffer is stamped: the
    // kernel's inode cache forgets only a record no running operation can be holding (`drop_idle_core`).
    used: u64

private[kfs] free_core() -> InCore = InCore(0, 0, false, 0, 0, buf(), 0, 0, 0)

// Where an inode's slot is: the inode-table block's buffer and the offset in it.
struct Slot
    ino: u64
    loc: InodeLoc
    id: usize

// The in-memory record of inode `ino`, if there is one (stamped).
find_core[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64) -> Option[usize]
    val now = fs.plat.stamp()
    fs.plat.lock(LockId.Icache)
    val found = find_locked(fs, ino, now)
    fs.plat.unlock(LockId.Icache)
    found

// `find_core` under `icache.lock`.
private find_locked[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64, now: u64) -> Option[usize]
    for i in 0..<fs.incore.len()
        val c = fs.core(i)
        if c.ino == ino
            if now > c.used then c.used = now
            return Some(i)
    None

// The in-memory record of inode `ino`, made on first use. Finding it and making it are one step under
// `icache.lock`, so two cores asking at once get one record.
core_of[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64) -> usize
    val now = fs.plat.stamp()
    fs.plat.lock(LockId.Icache)
    val have = find_locked(fs, ino, now)
    val i = have match
        Some(i) -> Some(i)
        None -> place_core(fs, ino, now)
    fs.plat.unlock(LockId.Icache)
    i match
        Some(i) -> i
        None ->
            fs.plat.fatal(Fatal.TableFull("inode cache"))
            panic("keel.kfs: the in-memory inode table is full")

// A new record for `ino`, in a free slot or a new one; None when the table is full. Under `icache.lock`.
private place_core[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64, now: u64) -> Option[usize]
    var c = free_core()
    c.ino = ino
    c.used = now
    for i in 0..<fs.incore.len()
        val s = fs.core(i)
        if s.ino == 0
            *s = c
            return Some(i)
    fs.incore.add(c)

// Forget inode `ino`'s record: it has been freed.
forget_core[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64)
    fs.plat.lock(LockId.Icache)
    for i in 0..<fs.incore.len()
        val s = fs.core(i)
        if s.ino == ino then *s = free_core()
    fs.plat.unlock(LockId.Icache)

// Whether in-memory record `c` may be forgotten while the filesystem is in use: nothing holds the inode
// open, it is not on the orphan list, it has no data waiting for an `fsync`, every transaction that
// changed it has committed (`oldest_uncommitted` is the first sequence that has not), and no operation
// still running can be holding its index (stamped before `before`, as `Fs.drop_clean` reasons). Such a
// record carries nothing the disk does not: made again on the next use, it is the same.
idle_core(c: *InCore, oldest_uncommitted: u64, before: u64) -> bool
    c.ino != 0 && c.held == 0 && !c.orphan && c.dirty.len() == 0 && c.meta_seq < oldest_uncommitted && c.map_seq < oldest_uncommitted && c.used < before

// Forget in-memory record `i` if it is idle (`idle_core`): the kernel's inode cache keeps its table
// within its room this way while other cores run operations. True when it was forgotten.
drop_idle_core[D: BlockDevice, P: Platform](fs: *Fs[D, P], i: usize, before: u64) -> bool
    // The oldest transaction not yet committed, read first: sequences only grow, so a record judged
    // against an older reading is judged conservatively.
    fs.plat.lock(LockId.Journal)
    val oldest = if fs.j.committing.live then fs.j.committing.seq else fs.j.running.seq
    fs.plat.unlock(LockId.Journal)
    fs.plat.lock(LockId.Icache)
    val s = fs.core(i)
    val gone = idle_core(s, oldest, before)
    if gone then *s = free_core()
    fs.plat.unlock(LockId.Icache)
    gone

// In-memory record `i`'s inode and how many references hold it open (0, 0 for a free slot): what a
// platform's inode cache sees of a record.
core_at[D: BlockDevice, P: Platform](fs: *Fs[D, P], i: usize) -> (u64, u32)
    fs.plat.lock(LockId.Icache)
    val c = fs.core(i)
    val answer = (c.ino, c.held)
    fs.plat.unlock(LockId.Icache)
    answer

// How many slots the in-memory inode table has, and how many hold a record.
core_slots[D: BlockDevice, P: Platform](fs: *Fs[D, P]) -> usize = fs.incore.len()
cores_live[D: BlockDevice, P: Platform](fs: *Fs[D, P]) -> usize
    fs.plat.lock(LockId.Icache)
    var n: usize = 0
    for i in 0..<fs.incore.len()
        if fs.core(i).ino != 0 then n += 1
    fs.plat.unlock(LockId.Icache)
    n

// Inode `ino`'s slot, checked: a number in range (else corruption, section 22), a slot in use (a free
// one, all zero or with mode 0, answers `Invalid`), and a checksum that verifies.
slot_of[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64) -> Result[Slot, FsError]
    if ino == 0 || ino > fs.sb.inode_count then return Err(fs.corrupt(Corruption.BadInodeNumber(ino)))
    val loc = fs.inode_location(ino)
    val id = fs.buffer(loc.block)?
    fs.plat.lock(LockId.Buffer(loc.block))
    val bytes = fs.bytes(id)[loc.offset..<loc.offset + INODE_SIZE]
    var zero = true
    for x in bytes
        if x != 0 then zero = false
    val good = zero || verify_inode(fs.seed, ino, bytes)
    val node: *Inode = at(fs.bytes(id), loc.offset)
    val mode = node.mode
    fs.plat.unlock(LockId.Buffer(loc.block))
    if !good then return Err(fs.corrupt(Corruption.Inode(ino)))
    if zero || mode == 0 then return Err(FsError.Invalid)
    Ok(Slot(ino, loc, id))

// A copy of inode `ino` as it is now.
read_inode[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64) -> Result[Inode, FsError]
    val s = slot_of(fs, ino)?
    fs.plat.lock(LockId.Buffer(s.loc.block))
    val node: *Inode = at(fs.bytes(s.id), s.loc.offset)
    val copy = *node
    fs.plat.unlock(LockId.Buffer(s.loc.block))
    Ok(copy)

// Declare slot `s`'s block in `h`, under its buffer lock, before anything in it changes.
declare_slot[D: BlockDevice, P: Platform](fs: *Fs[D, P], h: *Handle, s: Slot) -> Result[unit, FsError]
    fs.plat.lock(LockId.Buffer(s.loc.block))
    val r = fs.write_access(h, s.id)
    fs.plat.unlock(LockId.Buffer(s.loc.block))
    r

// Change slot `s` (declared already) with `edit`, and seal it again.
edit_slot[D: BlockDevice, P: Platform](fs: *Fs[D, P], s: Slot, edit: &Fn(*Inode) -> unit)
    fs.plat.lock(LockId.Buffer(s.loc.block))
    val bytes = fs.bytes(s.id)
    edit(at(bytes, s.loc.offset))
    seal_inode(fs.seed, s.ino, bytes[s.loc.offset..<s.loc.offset + INODE_SIZE])
    fs.plat.unlock(LockId.Buffer(s.loc.block))

// Change inode `ino` in `h` with `edit`: declared, changed, sealed, and remembered as changed in `h`'s
// transaction.
change_inode[D: BlockDevice, P: Platform](fs: *Fs[D, P], h: *Handle, ino: u64, edit: &Fn(*Inode) -> unit) -> Result[unit, FsError]
    val s = slot_of(fs, ino)?
    declare_slot(fs, h, s)?
    edit_slot(fs, s, edit)
    note_change(fs, ino, h.seq, false)
    Ok(())

// Remember that transaction `seq` changed inode `ino` — and, with `mapping`, its size or its mapping.
note_change[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64, seq: u64, mapping: bool)
    val c = fs.core(core_of(fs, ino))
    c.meta_seq = seq
    if mapping then c.map_seq = seq

// Remember that inode `ino` wrote data block `b`, for `fsync`. Under the inode's lock, which is what
// guards the list.
note_dirty[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64, b: u64)
    val c = fs.core(core_of(fs, ino))
    for k in 0..<c.dirty.len()
        if c.dirty[k] == b then return
    c.dirty.push(b)

set_atime(n: *Inode, t: Time)
    n.atime_sec = t.sec
    n.atime_nsec = t.nsec

set_mtime(n: *Inode, t: Time)
    n.mtime_sec = t.sec
    n.mtime_nsec = t.nsec

set_ctime(n: *Inode, t: Time)
    n.ctime_sec = t.sec
    n.ctime_nsec = t.nsec

// Whether time (a_sec, a_nsec) is before time (b_sec, b_nsec).
before(a_sec: i64, a_nsec: u32, b_sec: i64, b_nsec: u32) -> bool
    a_sec < b_sec || (a_sec == b_sec && a_nsec < b_nsec)

// `st_blocks`: 512-byte units (section 8, `blocks`).
st_blocks(n: Inode) -> u64 = n.blocks * 8

// Whether an inode of this mode and these flags has an extent tree (section 8, "The `data` union").
has_tree(mode: u16, flags: u32) -> bool
    val t = mode & S_IFMT
    t == S_IFREG || t == S_IFDIR || (t == S_IFLNK && flags & INODE_INLINE == 0)

// -- References and links -------------------------------------------------------------------------------

// Inode `ino` as it is now, under its lock: `stat`'s view.
stat[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64) -> Result[Inode, FsError]
    fs.plat.lock(LockId.Inode(ino))
    val r = read_inode(fs, ino)
    fs.plat.unlock(LockId.Inode(ino))
    r

// One more reference keeps inode `ino` open (a descriptor, a mapping, a working directory).
hold[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64) -> Result[unit, FsError]
    fs.plat.lock(LockId.Inode(ino))
    val r = slot_of(fs, ino)
    if r.is_ok()
        fs.core(core_of(fs, ino)).held += 1
    fs.plat.unlock(LockId.Inode(ino))
    r?
    Ok(())

// A reference to inode `ino` goes. The last one, on an inode with no links, deletes it (section 18,
// `unlinkat`: "otherwise the last close runs it").
release[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64) -> Result[unit, FsError]
    fs.plat.lock(LockId.Inode(ino))
    val r = release_locked(fs, ino)
    fs.plat.unlock(LockId.Inode(ino))
    r

private release_locked[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64) -> Result[unit, FsError]
    val c = find_core(fs, ino) match
        Some(i) -> fs.core(i)
        None -> return Err(FsError.Invalid)
    if c.held == 0 then return Err(FsError.Invalid)
    c.held -= 1
    if c.held > 0 then return Ok(())
    val node = read_inode(fs, ino)?
    if node.links == 0 then delete_locked(fs, ino) else Ok(())

// Whether anything holds inode `ino` open.
held_open[D: BlockDevice, P: Platform](fs: *Fs[D, P], ino: u64) -> bool
    find_core(fs, ino) match
        Some(i) -> fs.core(i).held > 0
        None -> false
