module sh.sysl.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// `fallocate` (kfs/SPEC.md section 18): preallocation as unwritten extents, with and without the size,
// in chunks; punching holes, with their partial edges, inside one extent, across many, and over what is
// a hole already; the argument checks.

private bs() -> u64 = u64(BLOCK_SIZE)

@test("mode 0 maps the range unwritten and sets the size; the range reads as zeros")
preallocate_sets_size()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    must(fallocate(&fs, ino, Falloc.Allocate, 100, 3 * bs(), 0))
    val n = must_inode(stat(&fs, ino))
    assert(n.size == 3 * bs() + 100 && n.blocks == 4)
    for l in 0..<4
        assert(unwritten_at(&fs, ino, u64(l)))
    val all = got(&fs, ino, 0, 3 * BLOCK_SIZE + 100)
    assert(all.len() == 3 * BLOCK_SIZE + 100 && zeroed(all.view()))
    settled_clean(&fs)

@test("keep-size past the end: blocks held, size unchanged, a read past the size answers nothing")
preallocate_keep_size()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 10, 1)
    val t0 = must_inode(stat(&fs, ino))
    must(fallocate(&fs, ino, Falloc.KeepSize, 0, 10 * bs(), 0))
    val n = must_inode(stat(&fs, ino))
    assert(n.size == 10 && n.blocks == 10 && n.mtime_sec == t0.mtime_sec)
    assert(before(t0.ctime_sec, t0.ctime_nsec, n.ctime_sec, n.ctime_nsec))
    assert(!unwritten_at(&fs, ino, 0) && unwritten_at(&fs, ino, 9))
    var out = zeros(100)
    assert(must_n(read(&fs, ino, 10, out.view())) == 0)
    // Grown over the preallocation, the file reads zeros there.
    must(truncate(&fs, ino, 5 * bs(), 0))
    val back = got(&fs, ino, 0, 5 * BLOCK_SIZE)
    assert(same(back.view()[0..<10], pattern(10, 1).view()) && zeroed(back.view()[10..<5 * BLOCK_SIZE]))
    settled_clean(&fs)

@test("preallocation leaves mapped blocks as they are and fills only the holes")
preallocate_over_mapped()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, bs(), BLOCK_SIZE, 1)
    val b1 = phys_at(&fs, ino, 1)
    must(fallocate(&fs, ino, Falloc.Allocate, 0, 3 * bs(), 0))
    assert(phys_at(&fs, ino, 1) == b1 && !unwritten_at(&fs, ino, 1))
    assert(unwritten_at(&fs, ino, 0) && unwritten_at(&fs, ino, 2) && blocks_of(&fs, ino) == 3)
    assert(bytes_equal(got(&fs, ino, bs(), BLOCK_SIZE), pattern(BLOCK_SIZE, 1)))
    // A range already wholly mapped allocates nothing; mode 0 still may move the size.
    must(fallocate(&fs, ino, Falloc.Allocate, 0, bs(), 0))
    assert(blocks_of(&fs, ino) == 3 && size_of(&fs, ino) == 3 * bs())
    settled_clean(&fs)

@test("a preallocation over more than eight holes takes one chunk per eight; mode 0's size comes with the last")
preallocate_chunks()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    for i in 0..<9
        put_pattern(&fs, ino, (2 * u64(i) + 1) * bs(), 1, 1)
    val m0 = fs.handles_opened()
    must(fallocate(&fs, ino, Falloc.Allocate, 0, 19 * bs(), 0))
    // Ten holes (0, 2, ... 18): two chunks.
    assert(fs.handles_opened() - m0 == 2)
    // Nineteen one-block extents, no two contiguous: a tree of one node block over them.
    assert(size_of(&fs, ino) == 19 * bs() && blocks_of(&fs, ino) == 20 && must_u16(depth_of(&fs, ino)) == 1)
    settled_clean(&fs)

@test("preallocation out of space keeps the chunks it finished and answers NoSpace")
preallocate_no_space()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    must(fs.checkpoint_all())
    val free = free_total(&fs)
    assert(code(fallocate(&fs, ino, Falloc.Allocate, 0, (free + 1) * bs(), 0)) == 1)
    assert(size_of(&fs, ino) == 0)
    assert(blocks_of(&fs, ino) > 0)
    settled_clean(&fs)

@test("punching partial blocks at both ends zeroes those bytes and frees the whole blocks between")
punch_partial_edges()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 6 * BLOCK_SIZE, 1)
    val t0 = must_inode(stat(&fs, ino))
    must(fallocate(&fs, ino, Falloc.PunchHole, bs() + 10, 3 * bs(), 0))
    // Blocks 2 and 3 are whole inside [4106, 16394): freed. Blocks 1 and 4 keep their outer bytes.
    val n = must_inode(stat(&fs, ino))
    assert(n.size == 6 * bs() && n.blocks == 4)
    assert(phys_at(&fs, ino, 2) == 0 && phys_at(&fs, ino, 3) == 0 && phys_at(&fs, ino, 1) != 0 && phys_at(&fs, ino, 4) != 0)
    assert(before(t0.mtime_sec, t0.mtime_nsec, n.mtime_sec, n.mtime_nsec))
    val all = got(&fs, ino, 0, 6 * BLOCK_SIZE)
    val want = pattern(6 * BLOCK_SIZE, 1)
    for i in 0..<(6 * BLOCK_SIZE)
        val punched = i >= BLOCK_SIZE + 10 && i < 4 * BLOCK_SIZE + 10
        assert(all[i] == (if punched then 0 else want[i]))
    settled_clean(&fs)

@test("a punch inside one block only zeroes bytes; one of a whole block frees it")
punch_within_block()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 2 * BLOCK_SIZE, 1)
    must(fallocate(&fs, ino, Falloc.PunchHole, 5, 10, 0))
    assert(blocks_of(&fs, ino) == 2)
    val b = got(&fs, ino, 0, 20)
    assert(zeroed(b.view()[5..<15]) && b[4] == pattern(20, 1)[4] && b[15] == pattern(20, 1)[15])
    must(fallocate(&fs, ino, Falloc.PunchHole, bs() - 1, 1, 0))
    assert(got(&fs, ino, bs() - 1, 1)[0] == 0 && blocks_of(&fs, ino) == 2)
    must(fallocate(&fs, ino, Falloc.PunchHole, bs(), bs(), 0))
    assert(blocks_of(&fs, ino) == 1 && phys_at(&fs, ino, 1) == 0 && size_of(&fs, ino) == 2 * bs())
    settled_clean(&fs)

@test("a punch strictly inside one extent splits it in two, keeping both ends' blocks where they were")
punch_splits_extent()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 10 * BLOCK_SIZE, 1)
    val b0 = phys_at(&fs, ino, 0)
    must(fallocate(&fs, ino, Falloc.PunchHole, 3 * bs(), 4 * bs(), 0))
    assert(phys_at(&fs, ino, 2) == b0 + 2 && phys_at(&fs, ino, 7) == b0 + 7 && phys_at(&fs, ino, 5) == 0)
    assert(blocks_of(&fs, ino) == 6)
    settled_clean(&fs)

@test("punching a range that is a hole already changes no block, only the times")
punch_hole_range()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 10, 1)
    must(truncate(&fs, ino, 20 * bs(), 0))
    must(fs.checkpoint_all())
    val free0 = free_total(&fs)
    must(fallocate(&fs, ino, Falloc.PunchHole, 5 * bs() + 7, 6 * bs(), 0))
    must(fs.checkpoint_all())
    assert(free_total(&fs) == free0 && blocks_of(&fs, ino) == 1 && size_of(&fs, ino) == 20 * bs())
    settled_clean(&fs)

@test("a punch past the end of the file removes preallocated blocks there and keeps the size")
punch_past_end()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    put_pattern(&fs, ino, 0, 10, 1)
    must(fallocate(&fs, ino, Falloc.KeepSize, 0, 8 * bs(), 0))
    must(fallocate(&fs, ino, Falloc.PunchHole, 4 * bs(), 10 * bs(), 0))
    assert(blocks_of(&fs, ino) == 4 && size_of(&fs, ino) == 10)
    settled_clean(&fs)

@test("a punch over many extents works in steps of sixteen and frees every one")
punch_in_steps()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = sparse_file(&fs, 40)
    val m0 = fs.handles_opened()
    must(fallocate(&fs, ino, Falloc.PunchHole, 2 * bs(), 74 * bs(), 0))
    // [2, 76): the extents at logical 2, 4, ... 74, 37 of them: the first step's sixteen, two more steps.
    assert(fs.handles_opened() - m0 == 3)
    assert(blocks_of(&fs, ino) == 3 && phys_at(&fs, ino, 0) != 0 && phys_at(&fs, ino, 76) != 0 && phys_at(&fs, ino, 74) == 0)
    settled_clean(&fs)

@test("a punch that must split an extent with no block left for the new node answers NoSpace and changes nothing")
punch_no_space()
    var dev = small_device()
    var fs = mounted(&dev)
    // Seven extents fill the root, the last of three blocks; a split of it needs a node block.
    val ino = sparse_file(&fs, 6)
    must(fallocate(&fs, ino, Falloc.Allocate, 14 * bs(), 3 * bs(), 0))
    assert(must_u16(depth_of(&fs, ino)) == 0)
    val big = new_file(&fs, 0)
    must(fs.checkpoint_all())
    val left = free_total(&fs)
    must(fallocate(&fs, big, Falloc.Allocate, 0, left * bs(), 0))
    must(fs.checkpoint_all())
    assert(free_total(&fs) == 0)
    val before_punch = blocks_of(&fs, ino)
    assert(code(fallocate(&fs, ino, Falloc.PunchHole, 15 * bs(), bs(), 0)) == 1)
    assert(blocks_of(&fs, ino) == before_punch && phys_at(&fs, ino, 15) != 0)
    settled_clean(&fs)

@test("an extent-tree node a punch frees is revoked: reused for data, its block keeps the data through replay")
punch_revokes_freed_node()
    var dev = small_device()
    var fs = mounted(&dev)
    // Nine extents: the root's seven overflow into one node block, logged by this commit.
    val ino = sparse_file(&fs, 9)
    must(fs.commit())
    assert(must_u16(depth_of(&fs, ino)) == 1)
    val loc = fs.inode_location(ino)
    val node_block = le64(fs.bytes(must_id(fs.buffer(loc.block))), loc.offset + 112 + 16 + 8)
    // A punch of all but the first extent empties the node: the tree collapses into the root.
    must(fallocate(&fs, ino, Falloc.PunchHole, bs(), 20 * bs(), 0))
    assert(must_u16(depth_of(&fs, ino)) == 0)
    must(fs.commit())
    // The freed block, taken for another file's data and committed, with nothing checkpointed.
    val other = new_file(&fs, 0)
    var h = fs.start("write", C_WRITE_CHUNK)
    val run = alloc_blocks(&fs, &h, node_block, 1, 0).unwrap()
    assert(run.first == node_block)
    must(insert(&fs, &h, extent_tree(other, 0), Extent(0, 1, run.first, false)))
    must(fs.write_new_data(&h, run.first, pattern(BLOCK_SIZE, 77).view()))
    must(change_inode(&fs, &h, other, (n) -> n.size = u64(BLOCK_SIZE)))
    fs.stop(&h)
    must(fs.commit())
    assert(fs.logged_count() >= 3)
    // A crash now: the next mount replays every logged transaction. The node's old copy in the first
    // is revoked by the second, so the data stays.
    var again = mounted(&dev)
    assert(bytes_equal(got(&again, other, 0, BLOCK_SIZE), pattern(BLOCK_SIZE, 77)))
    settled_clean(&again)

@test("a length of 0 is Invalid; a range reaching past 16 TiB is TooBig; only a regular file takes it")
falloc_arguments()
    var dev = small_device()
    var fs = mounted(&dev)
    val ino = new_file(&fs, 0)
    assert(code(fallocate(&fs, ino, Falloc.Allocate, 0, 0, 0)) == 3)
    assert(code(fallocate(&fs, ino, Falloc.PunchHole, 10, 0, 0)) == 3)
    assert(code(fallocate(&fs, ino, Falloc.KeepSize, MAX_FILE_SIZE, 1, 0)) == 7)
    assert(code(fallocate(&fs, ino, Falloc.Allocate, MAX_FILE_SIZE - 1, 2, 0)) == 7)
    must(fallocate(&fs, ino, Falloc.KeepSize, MAX_FILE_SIZE - 1, 1, 0))
    assert(unwritten_at(&fs, ino, LOGICAL_BLOCKS - 1))
    assert(code(fallocate(&fs, ROOT_INO, Falloc.Allocate, 0, 10, 0)) == 3)
    settled_clean(&fs)
