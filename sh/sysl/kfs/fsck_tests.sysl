module sh.sysl.kfs
@tests
@requires(heap)

import sysl.buf.{Buf, buf}

// fsck (kfs/SPEC.md section 23): clean images stay clean and are stamped; each corruption the stage's
// list names is found by its diagnostic and repaired by `-y`, a second run then finding nothing; what
// needs `--rebuild-corrupt` waits for it; several problems go in one run.

@test("§23 a freshly formatted image is clean: -n and -y exit 0, and -y stamps check_time and mount_count 0")
fresh_image_clean()
    var dev = small_device()
    var fs = mounted(&dev)
    must(fs.unmount())
    assert(super_of(&dev).mount_count == 1)
    val n = fsck_n(&dev)
    assert_eq(n.code, FSCK_CLEAN)
    assert_eq(n.found.len(), 0)
    val y = fsck_y(&dev)
    assert_eq(y.code, FSCK_CLEAN)
    assert_eq(y.rounds, 0)
    val sb = super_of(&dev)
    assert(sb.check_time != 0 && sb.mount_count == 0)
    assert(sb.state & STATE_CLEAN != 0 && sb.state & STATE_ERROR == 0)
    val _ = checked_clean(&dev)

@test("§23 an image after stage 8's whole workload is clean: every namespace operation, xattrs, a truncate, an rmdir")
workload_image_clean()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val b = mkd(&fs, a, "b")
    val f = mk(&fs, a, "f")
    put_pattern(&fs, f, 0, 10000, 1)
    val r = Caller(0, 0)
    val _ = must_ino(mknod(&fs, b, "c".bytes, S_IFCHR | 0o600, DeviceNumbers(1, 3), r))
    val _ = must_ino(mknod(&fs, b, "p".bytes, S_IFIFO | 0o600, DeviceNumbers(0, 0), r))
    val _ = must_ino(symlink(&fs, a, "short".bytes, "f".bytes, r))
    val _ = must_ino(symlink(&fs, a, "long".bytes, target_of(1000).view(), r))
    must(link(&fs, f, b, "f2".bytes, r))
    must(rename(&fs, a, "f".bytes, ROOT_INO, "moved".bytes, 0, r))
    val e = mkd(&fs, ROOT_INO, "e")
    must(setxattr(&fs, f, XATTR_USER, "x".bytes, "y".bytes, 0, 0))
    must(truncate(&fs, f, 77, 0))
    must(unlink(&fs, b, "p".bytes))
    must(rmdir(&fs, ROOT_INO, "e".bytes))
    assert(!alive(&fs, e))
    must(fs.unmount())
    val before = image_digest(&dev)
    assert_eq(fsck_n(&dev).code, FSCK_CLEAN)
    assert_eq(image_digest(&dev), before)
    val y = fsck_y(&dev)
    assert_eq(y.code, FSCK_CLEAN)
    assert_eq(y.found.len(), 0)

@test("§23 pass 5: a bitmap bit set for no owner (a leak) is cleared, one clear under a file's block is set; the file keeps its bytes")
bitmap_bits()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 9000, 7)
    must(fs.unmount())
    var sb = super_of(&dev)
    val leak = geometry_of(&sb).data_start(0) + 300
    disk_block_bit(&dev, leak, true)
    val _ = repaired(&dev, Problem.BlockBit(leak, false))
    val owned = first_phys(&dev, f)
    disk_block_bit(&dev, owned, false)
    val _ = repaired(&dev, Problem.BlockBit(owned, true))
    assert(bytes_equal(read_back(&dev, f, 9000), pattern(9000, 7)))

@test("§23 pass 4: an inflated link count is set back to the names counted")
inflated_links()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    fs_poke(&fs, f, (n) -> n.links = 3)
    must(fs.unmount())
    val _ = repaired(&dev, Problem.LinkCount(f, 3, 1))
    assert_eq(disk_inode(&dev, f).links, 1)

@test("§23 pass 4: an inode with links and no name goes to lost+found as #<ino>; lost+found is made when missing, then reused for the next")
nameless_to_lost_found()
    var dev = small_device()
    var fs = mounted(&dev)
    must(rmdir(&fs, ROOT_INO, "lost+found".bytes))
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 5000, 3)
    val _ = must_entry(remove_name(&fs, ROOT_INO, "f".bytes))
    must(fs.unmount())
    val r = repaired(&dev, Problem.LinkCount(f, 1, 0))
    assert(did(r, "lost+found was missing"))
    var fs2 = mounted(&dev)
    val lf = named(&fs2, ROOT_INO, "lost+found")
    assert(lf != 0)
    assert_eq(named(&fs2, lf, s"#$f"), f)
    assert(bytes_equal(got(&fs2, f, 0, 5000), pattern(5000, 3)))
    val g = mk(&fs2, ROOT_INO, "g")
    val _ = must_entry(remove_name(&fs2, ROOT_INO, "g".bytes))
    must(fs2.unmount())
    val r2 = repaired(&dev, Problem.LinkCount(g, 1, 0))
    assert(!did(r2, "lost+found was missing"))
    var fs3 = mounted(&dev)
    assert_eq(named(&fs3, ROOT_INO, "lost+found"), lf)
    assert_eq(named(&fs3, lf, s"#$g"), g)
    assert_eq(named(&fs3, lf, s"#$f"), f)
    must(fs3.unmount())

@test("§23 pass 0 and §5: a primary superblock that fails its checksum is restored from the backup; -n reports it and writes nothing")
primary_super_from_backup()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 100, 2)
    must(fs.unmount())
    flip_byte(&dev, 1, 40)
    val before = image_digest(&dev)
    val n = fsck_n(&dev)
    assert(among_problems(n.found, Problem.Super(OpenError.BadChecksum)))
    assert_eq(n.code, FSCK_LEFT)
    assert_eq(image_digest(&dev), before)
    val r = repaired(&dev, Problem.Super(OpenError.BadChecksum))
    assert(did(r, "restored from the backup at block 2049"))
    assert(bytes_equal(read_back(&dev, f, 100), pattern(100, 2)))

@test("§23 pass 3: a directory with a wrong `parent` has it set to the directory holding its name")
wrong_parent()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val d = mkd(&fs, ROOT_INO, "d")
    fs_poke(&fs, d, (n) -> n.parent = a)
    val _ = repaired(&dev, Problem.DirParent(d))
    assert_eq(disk_inode(&dev, d).parent, ROOT_INO)

@test("§23 pass 3: an unreachable directory is linked into lost+found with its subtree; its parent and every count follow")
unreachable_directory()
    var dev = small_device()
    var fs = mounted(&dev)
    val d = mkd(&fs, ROOT_INO, "d")
    val sub = mkd(&fs, d, "sub")
    val f = mk(&fs, d, "f")
    put_pattern(&fs, f, 0, 700, 4)
    val _ = must_entry(remove_name(&fs, ROOT_INO, "d".bytes))
    must(fs.checkpoint_all())
    val r = repaired(&dev, Problem.DirUnreachable(d))
    assert(among_problems(r.found, Problem.LinkCount(d, 3, 2)))
    var fs2 = mounted(&dev)
    val lf = named(&fs2, ROOT_INO, "lost+found")
    assert_eq(named(&fs2, lf, s"#$d"), d)
    assert_eq(node(&fs2, d).parent, lf)
    assert_eq(links_of(&fs2, lf), 3)
    assert_eq(named(&fs2, d, "sub"), sub)
    assert(bytes_equal(got(&fs2, f, 0, 700), pattern(700, 4)))
    must(fs2.unmount())

@test("§23 pass 1b: a block claimed by two files is copied for the later claimant, so each keeps its bytes")
duplicate_claim()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mk(&fs, ROOT_INO, "a")
    put_pattern(&fs, a, 0, 8192, 1)
    val b = mk(&fs, ROOT_INO, "b")
    put_pattern(&fs, b, 0, 8192, 2)
    must(fs.unmount())
    val pa = first_phys(&dev, a)
    val pb = first_phys(&dev, b)
    disk_edit(&dev, b, true, (n) -> put_le64(n.data[0..<128], 24, pa))
    val r = repaired(&dev, Problem.DoubleClaim(pa, b))
    assert(among_problems(r.found, Problem.DoubleClaim(pa + 1, b)))
    assert(among_problems(r.found, Problem.BlockBit(pb, false)))
    assert(did(r, "were copied"))
    val nb = first_phys(&dev, b)
    assert(nb != pa && first_phys(&dev, a) == pa)
    assert(bytes_equal(read_back(&dev, a, 8192), pattern(8192, 1)))
    assert(bytes_equal(read_back(&dev, b, 8192), pattern(8192, 1)))

@test("§23 pass 1b edge cases: a file claiming one block twice gets both extents copied; an unwritten extent on another's block is moved, reading zeros, the other's bytes untouched")
duplicate_claim_edges()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mk(&fs, ROOT_INO, "a")
    put_pattern(&fs, a, 0, 4096, 1)
    put_pattern(&fs, a, 8192, 4096, 2)
    must(fs.unmount())
    val pa = first_phys(&dev, a)
    assert_eq(disk_inode(&dev, a).data[4], 2)
    disk_edit(&dev, a, true, (n) -> put_le64(n.data[0..<128], 40, pa))
    val r = repaired(&dev, Problem.DoubleClaim(pa, a))
    assert(did(r, "were copied"))
    var fs2 = mounted(&dev)
    assert(bytes_equal(got(&fs2, a, 0, 4096), pattern(4096, 1)))
    assert(bytes_equal(got(&fs2, a, 8192, 4096), pattern(4096, 1)))
    must(fs2.unmount())
    var dev2 = small_device()
    var fs3 = mounted(&dev2)
    val b = mk(&fs3, ROOT_INO, "b")
    put_pattern(&fs3, b, 0, 4096, 7)
    val u = mk(&fs3, ROOT_INO, "u")
    must(fallocate(&fs3, u, Falloc.Allocate, 0, 4096, 0))
    must(fs3.unmount())
    val pb = first_phys(&dev2, b)
    disk_edit(&dev2, u, true, (n) -> put_le64(n.data[0..<128], 24, pb))
    val _ = repaired(&dev2, Problem.DoubleClaim(pb, u))
    assert(first_phys(&dev2, u) != pb)
    assert(bytes_equal(read_back(&dev2, b, 4096), pattern(4096, 7)))
    assert(bytes_equal(read_back(&dev2, u, 4096), zeros(4096)))

@test("§23 pass 1b: a directory mapping another directory's leaf fails that leaf's tail: -y rebuilds it, its own names lost to it going to lost+found")
duplicate_claim_by_directory()
    var dev = small_device()
    var fs = mounted(&dev)
    val one = mkd(&fs, ROOT_INO, "one")
    val f = mk(&fs, one, "f")
    val two = mkd(&fs, ROOT_INO, "two")
    val g = mk(&fs, two, "g")
    must(fs.unmount())
    val leaf = first_phys(&dev, one)
    disk_edit(&dev, two, true, (n) -> put_le64(n.data[0..<128], 24, leaf))
    val r = repaired(&dev, Problem.DoubleClaim(leaf, two))
    assert(among_problems(r.found, Problem.DirBlock(two, 0, DirFault.Owner)))
    var fs2 = mounted(&dev)
    assert_eq(named(&fs2, one, "f"), f)
    assert_eq(named(&fs2, two, "g"), 0)
    assert_eq(named(&fs2, named(&fs2, ROOT_INO, "lost+found"), s"#$g"), g)
    must(fs2.unmount())

@test("§23 pass 5: an orphan list that loops is cut where it comes back; the members, still marked, form a list again")
orphan_cycle()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    val g = mk(&fs, ROOT_INO, "g")
    put_pattern(&fs, g, 0, 3000, 6)
    must(fs.unmount())
    disk_edit(&dev, f, true, (n) ->
        n.flags = n.flags | INODE_ORPHAN
        n.orphan_next = g)
    disk_edit(&dev, g, true, (n) ->
        n.flags = n.flags | INODE_ORPHAN
        n.orphan_next = f)
    disk_super(&dev, (s) -> s.orphan_head = f)
    val r = repaired(&dev, Problem.OrphanCycle(f))
    assert(did(r, s"the orphan list was cut before inode $f"))
    assert_eq(disk_inode(&dev, g).orphan_next, 0)
    var fs2 = mounted(&dev)
    assert_eq(named(&fs2, ROOT_INO, "f"), f)
    assert(bytes_equal(got(&fs2, g, 0, 3000), pattern(3000, 6)))
    must(fs2.unmount())
    val _ = checked_clean(&dev)

@test("§23 several problems — a leak, a link count, a parent, a dangling entry, a nameless file — are all reported and repaired in one run")
several_problems()
    var dev = small_device()
    var fs = mounted(&dev)
    val a = mkd(&fs, ROOT_INO, "a")
    val d = mkd(&fs, ROOT_INO, "d")
    val f = mk(&fs, a, "f")
    val lone = mk(&fs, ROOT_INO, "lone")
    fs_poke(&fs, f, (n) -> n.links = 4)
    fs_poke(&fs, d, (n) -> n.parent = a)
    must(add_name(&fs, a, "ghost".bytes, 70, DT_REG, 0))
    val _ = must_entry(remove_name(&fs, ROOT_INO, "lone".bytes))
    must(fs.unmount())
    var sb = super_of(&dev)
    val leak = geometry_of(&sb).data_start(0) + 400
    disk_block_bit(&dev, leak, true)
    val r = fsck_y(&dev)
    if r.code != FSCK_FIXED then show_run(r)
    assert_eq(r.code, FSCK_FIXED)
    assert(among_problems(r.found, Problem.BlockBit(leak, false)))
    assert(among_problems(r.found, Problem.DirParent(d)))
    assert(among_problems(r.found, Problem.DirTarget(a, 70)))
    // Passes 3 and 4 wait for pass 2: these appear in a later round's check, and are reported too.
    assert(among_problems(r.found, Problem.LinkCount(f, 4, 1)))
    assert(among_problems(r.found, Problem.LinkCount(lone, 1, 0)))
    assert(r.rounds >= 2)
    assert_eq(r.left.len(), 0)
    val _ = checked_clean(&dev)
    var fs2 = mounted(&dev)
    assert_eq(links_of(&fs2, f), 1)
    assert_eq(named(&fs2, named(&fs2, ROOT_INO, "lost+found"), s"#$lone"), lone)
    must(fs2.unmount())

@test("§23 lost+found that is not a directory: the file of that name is moved into a new lost+found, then the nameless inode joins it")
lost_found_not_a_directory()
    var dev = small_device()
    var fs = mounted(&dev)
    must(rmdir(&fs, ROOT_INO, "lost+found".bytes))
    val x = mk(&fs, ROOT_INO, "lost+found")
    val g = mk(&fs, ROOT_INO, "g")
    val _ = must_entry(remove_name(&fs, ROOT_INO, "g".bytes))
    must(fs.unmount())
    val r = repaired(&dev, Problem.LinkCount(g, 1, 0))
    assert(did(r, "not a directory"))
    var fs2 = mounted(&dev)
    val lf = named(&fs2, ROOT_INO, "lost+found")
    assert(lf != x)
    assert_eq(node(&fs2, lf).mode & S_IFMT, S_IFDIR)
    assert_eq(named(&fs2, lf, s"#$x"), x)
    assert_eq(named(&fs2, lf, s"#$g"), g)
    must(fs2.unmount())

@test("§23 lost+found with no room to grow: the nameless inode is left as it is (links kept, not freed) and fsck exits 4")
lost_found_full()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    put_pattern(&fs, f, 0, 100, 5)
    val _ = must_entry(remove_name(&fs, ROOT_INO, "f".bytes))
    ns_fill_disk(&fs, 0)
    must(fs.unmount())
    val r = left_alone(&dev, Problem.LinkCount(f, 1, 0))
    assert(did(r, "could not be linked into lost+found: no room"))
    assert_eq(disk_inode(&dev, f).links, 1)
    assert(bytes_equal(read_back(&dev, f, 100), pattern(100, 5)))

@test("§23 a name collision in lost+found: #<ino> taken by another file, the inode is linked as #<ino>.1")
lost_found_collision()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    val lf = named(&fs, ROOT_INO, "lost+found")
    val x = mk(&fs, lf, s"#$f")
    val y = mk(&fs, lf, s"#$f.1")
    val _ = must_entry(remove_name(&fs, ROOT_INO, "f".bytes))
    must(fs.unmount())
    val _ = repaired(&dev, Problem.LinkCount(f, 1, 0))
    var fs2 = mounted(&dev)
    assert_eq(named(&fs2, lf, s"#$f"), x)
    assert_eq(named(&fs2, lf, s"#$f.1"), y)
    assert_eq(named(&fs2, lf, s"#$f.2"), f)
    must(fs2.unmount())

@test("§23 -n never writes: a bad superblock, a log to replay and pass-4 problems are all reported, the image's bytes and write count unchanged")
check_never_writes()
    var dev = small_device()
    var fs = mounted(&dev)
    val f = mk(&fs, ROOT_INO, "f")
    fs_poke(&fs, f, (n) -> n.links = 5)
    val _ = mk(&fs, ROOT_INO, "g")
    must(fs.commit())
    assert(journal_of(&dev).start != 0)
    flip_byte(&dev, 1, 40)
    val before = image_digest(&dev)
    val writes = dev.writes()
    val n = fsck_n(&dev)
    assert_eq(n.code, FSCK_LEFT)
    assert(among_problems(n.found, Problem.Super(OpenError.BadChecksum)))
    assert(among_problems(n.found, Problem.LinkCount(f, 5, 1)))
    assert(did(n, "recovery replayed 1 transactions"))
    assert_eq(dev.writes(), writes)
    assert_eq(image_digest(&dev), before)
    // And -y then repairs all of it.
    val y = fsck_y(&dev)
    assert_eq(y.code, FSCK_FIXED)
    val _ = checked_clean(&dev)
